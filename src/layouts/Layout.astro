---
import BaseHead from "@/components/shared/BaseHead";
import Header from "@/components/ui/header/Header";
import "../styles/global.css";

export interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	articleDate?: string;
	viewTransition?: boolean;
	lang?: "es" | "en";
}

const {
	title,
	description,
	ogImage: image,
	articleDate,
	viewTransition = true,
	lang = "es",
} = Astro.props;
---

<html lang={lang}>
  <BaseHead
    title={title}
    description={description}
    ogImage={image}
    articleDate={articleDate}
    viewTransition={viewTransition}
  />

  <body class="font-sans bg-background-light text-primary-black">
    <Header />
    <slot />
  </body>
</html>
