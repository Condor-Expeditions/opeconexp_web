---
import Analytics from "@vercel/analytics/astro";
import BaseHead from "@/components/shared/BaseHead.astro";
import Footer from "@/components/ui/footer/Footer.astro";
import Header from "@/components/ui/header/Header.astro";
import WhatsAppFloat from "@/components/ui/WhatsAppFloat.astro";
import "../styles/global.css";

export interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	articleDate?: string;
	viewTransition?: boolean;
	lang?: "es" | "en";
}

const {
	title,
	description,
	ogImage: image,
	articleDate,
	viewTransition = true,
	lang = "es",
} = Astro.props;
---

<html lang={lang}>
  <BaseHead
    title={title}
    description={description}
    ogImage={image}
    articleDate={articleDate}
    viewTransition={viewTransition}
    lang={lang}
  />

  <body class="font-sans bg-background text-foreground">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-primary-red focus:text-white focus:rounded-lg focus:outline-none focus:ring-2 focus:ring-white"
    >
      {lang === "en" ? "Skip to content" : "Ir al contenido"}
    </a>
    <Header lang={lang} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppFloat />
    <Analytics />
  </body>
</html>