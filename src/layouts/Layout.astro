---
import "../styles/global.css";
import BaseHead from "@/components/shared/BaseHead";

export interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	articleDate?: string;
	viewTransition?: boolean;
  lang?: "es" | "en";
}

const {
	title,
	description,
	ogImage: image,
	articleDate,
	viewTransition = true,
  lang = "es",
} = Astro.props;
---

<html lang={lang}>
  <BaseHead
    title={title}
    description={description}
    ogImage={image}
    articleDate={articleDate}
    viewTransition={viewTransition}
  />

  <body class="font-sans bg-background-light text-primary-black">
    <slot />
  </body>
</html>
