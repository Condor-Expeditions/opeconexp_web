---
import BaseHead from "@/components/shared/BaseHead";
import Footer from "@/components/ui/Footer.astro";
import Header from "@/components/ui/header/Header";
import "../styles/global.css";
import SizeIndicator from "@/components/utilities/SizeIndicator";

export interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	articleDate?: string;
	viewTransition?: boolean;
	lang?: "es" | "en";
}

const {
	title,
	description,
	ogImage: image,
	articleDate,
	viewTransition = true,
	lang = "es",
} = Astro.props;
---

<html lang={lang}>
  <BaseHead
    title={title}
    description={description}
    ogImage={image}
    articleDate={articleDate}
    viewTransition={viewTransition}
  />

  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    {
      import.meta.env.DEV && <SizeIndicator />
    }
  </body>
</html>