---
import Layout from "../../layouts/Layout.astro";

const categories = [
  {
    id: "trekking", name: "Trekking & Hiking", icon: "🥾",
    description: "From gentle walks to technical ascents above 5,000 meters.",
    items: [
      { title: "Cotopaxi Ascend", duration: "2 days", difficulty: "Intermediate-Advanced", includes: "ASEGYIM guide, technical gear, 4x4 transport, snacks, refuge night" },
      { title: "Quilotoa Loop", duration: "3 days", difficulty: "Moderate", includes: "Native guide, cabin lodging, all meals, trekking pole" },
    ]
  },
  {
    id: "rafting", name: "Rafting & Kayaking", icon: "🛶",
    description: "Whitewater for every level in rivers of the Amazon and Andes.",
    items: [
      { title: "Jatunyaku River Rafting — Class III+", duration: "1 day", difficulty: "Intermediate", includes: "IRF certified guide, full equipment, lunch, photos & video, insurance" },
      { title: "Sea Kayaking Lake", duration: "1 day", difficulty: "Beginner", includes: "Single or double kayak, life jacket, quick course, lunch box" },
    ]
  },
  {
    id: "mountaineering", name: "Mountaineering & Climbing", icon: "🧗",
    description: "Rock and ice climbing for all levels, with international safety certifications.",
    items: [
      { title: "Cojitambo Rock Climbing", duration: "1 day", difficulty: "All levels", includes: "Petzel/Black Diamond gear, shoes, safety course, certified guide" },
    ]
  },
  {
    id: "jungle", name: "Jungle Expeditions", icon: "🐒",
    description: "Full immersion into the Amazon: canoes, wild camping, wildlife watching.",
    items: [
      { title: "Cuyabeno 4-Day", duration: "4 days", difficulty: "Easy-Moderate", includes: "Motor canoe, camping, Kichwa guide, meals, night walk" },
      { title: "Yasuní Wao Inmersión", duration: "5 days", difficulty: "Moderate", includes: "Waorani community living, navigation, camping, bonfire, native guide" },
    ]
  },
  {
    id: "cultural", name: "Cultural & Community", icon: "🏛️",
    description: "Experience Ecuador up close: markets, Inca ruins, ancestral food, community life.",
    items: [
      { title: "Otavalo Market Route", duration: "1 day", difficulty: "Easy", includes: "Bilingual guide, transport, lunch, Peguche waterfall visit" },
    ]
  }
];
---

<Layout
  lang="en"
  title="Experiences"
  description="Choose from over 30 trekking, rafting, mountaineering, climbing, jungle and culture expeditions across Ecuador. Small groups, certified guides."
>
  <section class="pt-32 pb-16 bg-gradient-to-b from-primary-50 to-white text-center">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <span class="text-accent font-display text-sm uppercase tracking-widest">Your Next Ascent</span>
      <h1 class="font-display text-4xl md:text-6xl mt-3 mb-4 text-foreground">Adventure Experiences</h1>
      <p class="text-muted-foreground text-lg max-w-3xl mx-auto">
        More than 30 expeditions for every level. Small group, native guides, and a real commitment to the natural world.
      </p>
    </div>
  </section>

  {
    categories.map((cat) => (
      <section id={cat.id} class="py-14 even:bg-white">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-3xl">{cat.icon}</span>
            <h2 class="font-display text-2xl md:text-3xl text-foreground">{cat.name}</h2>
          </div>
          <p class="text-muted-foreground text-lg mb-8">{cat.description}</p>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {
              cat.items.map((exp) => (
                <div class="bg-white rounded-xl p-6 border border-border/50 hover:shadow-lg transition-shadow">
                  <h3 class="font-display font-bold text-lg text-foreground mb-3">{exp.title}</h3>
                  <div class="flex flex-wrap gap-2 mb-3">
                    <span class="text-xs font-semibold bg-primary-50 text-primary px-2 py-0.5 rounded-full">{exp.duration}</span>
                    <span class="text-xs font-semibold bg-accent-light text-accent px-2 py-0.5 rounded-full">{exp.difficulty}</span>
                  </div>
                  <p class="text-sm text-muted-foreground leading-relaxed">
                    <span class="font-semibold text-foreground">Includes:</span> {exp.includes}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    ))
  }

  <section class="py-16 bg-dark text-center">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl md:text-3xl text-white mb-4">Looking for something else?</h2>
      <p class="text-dark-foreground/70 mb-6">We design fully custom experiences. Get in touch and tell us your adventure dream.</p>
      <a href="/en/contacto" class="inline-flex px-8 py-4 bg-accent hover:bg-accent-dark text-white font-semibold rounded-full transition-colors">
        Design Your Expedition
      </a>
    </div>
  </section>
</Layout>