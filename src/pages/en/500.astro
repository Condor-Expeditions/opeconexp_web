---
import Layout from "../../layouts/Layout.astro";
---

<Layout lang="en"
  title="Server Error"
  description="An unexpected error occurred. We're working on it."
>
  <section class="min-h-[70vh] flex items-center justify-center py-16">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 text-center">
      <span class="font-display text-[10rem] md:text-[12rem] font-bold text-accent/10 leading-none block">500</span>
      <h1 class="font-display text-3xl md:text-5xl text-foreground mb-4 -mt-8">
        Server Error
      </h1>
      <p class="text-muted-foreground text-lg mb-8 max-w-md mx-auto">
        Something went wrong. We're already on it. Please try again later or contact us directly.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/en/" class="px-8 py-4 bg-accent hover:bg-accent-dark text-white font-semibold rounded-full transition-colors">
          Back to Home
        </a>
        <a href="/en/contacto" class="px-8 py-4 border-2 border-primary text-primary font-semibold rounded-full transition-colors">
          Contact Us
        </a>
      </div>
    </div>
  </section>
</Layout>