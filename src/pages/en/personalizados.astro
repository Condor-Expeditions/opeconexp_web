---
import Layout from "../../layouts/Layout.astro";
import company from "../../data/company.json";
---

<Layout lang="en" title="Custom Tours" description="Design your personalized expedition in Ecuador. You choose destination, pace, level, and dates.">
  <section class="pt-32 pb-16 bg-gradient-to-b from-primary-50 to-white text-center">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <span class="text-accent font-display text-sm uppercase tracking-widest">Made for You</span>
      <h1 class="font-display text-4xl md:text-6xl mt-3 mb-4 text-foreground">Design Your Expedition</h1>
      <p class="text-muted-foreground text-lg max-w-3xl mx-auto">
        Tell us what kind of experience you're looking for and we'll build the perfect tour. No rush, no pre-packaged deals.
      </p>
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <form class="space-y-5" method="POST" action="https://formspree.io/f/YOUR_FORM_ID">
        <input type="hidden" name="_subject" value="Custom Tour Request — Condor Expeditions" />
        <input type="hidden" name="_next" value="/en/gracias" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-semibold text-foreground mb-1.5" for="name">Name</label>
            <input type="text" id="name" name="name" required class="w-full px-4 py-3 border border-border rounded-lg bg-white text-foreground placeholder:text-muted-foreground focus:ring-2 focus:ring-primary focus:border-primary outline-none transition" placeholder="Your full name" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-foreground mb-1.5" for="email">Email</label>
            <input type="email" id="email" name="email" required class="w-full px-4 py-3 border border-border rounded-lg bg-white text-foreground placeholder:text-muted-foreground focus:ring-2 focus:ring-primary focus:border-primary outline-none transition" placeholder="you@email.com" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-foreground mb-1.5" for="destino">Preferred destination</label>
          <select id="destino" name="destino" class="w-full px-4 py-3 border border-border rounded-lg bg-white text-foreground focus:ring-2 focus:ring-primary focus:border-primary outline-none transition">
            <option value="">Select</option>
            <option value="cuenca">Cuenca & surroundings</option>
            <option value="azuay">Azuay Province</option>
            <option value="andes">Ecuadorian Andes</option>
            <option value="amazonia">Amazon Rainforest</option>
            <option value="costa">Pacific Coast</option>
            <option value="galapagos">Galapagos Islands</option>
            <option value="multi">Multi-destination</option>
            <option value="otro">Other</option>
          </select>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-semibold text-foreground mb-1.5" for="dias">Estimated days</label>
            <input type="number" id="dias" name="dias" min="1" max="30" class="w-full px-4 py-3 border border-border rounded-lg bg-white text-foreground placeholder:text-muted-foreground focus:ring-2 focus:ring-primary focus:border-primary outline-none transition" placeholder="e.g. 5" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-foreground mb-1.5" for="viajeros">Travelers</label>
            <input type="number" id="viajeros" name="viajeros" min="1" class="w-full px-4 py-3 border border-border rounded-lg bg-white text-foreground placeholder:text-muted-foreground focus:ring-2 focus:ring-primary focus:border-primary outline-none transition" placeholder="e.g. 2" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-foreground mb-1.5" for="intereses">What kind of experience?</label>
          <textarea id="intereses" name="intereses" rows="4" class="w-full px-4 py-3 border border-border rounded-lg bg-white text-foreground placeholder:text-muted-foreground focus:ring-2 focus:ring-primary focus:border-primary outline-none transition resize-y" placeholder="Tell us what you'd like to do: trekking, culture, nature, adventure, relaxation... and any special preferences."></textarea>
        </div>

        <button type="submit" class="inline-block px-8 py-4 bg-accent hover:bg-accent-dark text-white font-semibold rounded-full text-lg shadow-md transition-colors">
          Request a Quote
        </button>
      </form>

      <div class="mt-12 bg-background rounded-xl p-6 text-center">
        <p class="text-sm text-muted-foreground mb-2">Or contact us directly</p>
        <a href={company.contact.whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-accent font-semibold hover:underline">
          💬 Chat on WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>