---
import TourCard from "../../../components/sections/TourCard.astro";
import Container from "../../../components/shared/Container.astro";
import { tours } from "../../../data/tours";
import Layout from "../../../layouts/Layout.astro";

const allTours = tours;

const categories = [...new Set(allTours.map((t) => t.category))].sort();
const regions = [
	...new Set(
		allTours.flatMap((t) =>
			t.category.includes("Cuenca")
				? ["Cuenca"]
				: t.category.includes("Azuay")
					? ["Azuay"]
					: ["Ecuador"],
		),
	),
].sort();

const tipoRaw = Astro.url.searchParams.get("tipo") ?? "";
const regionRaw = Astro.url.searchParams.get("region") ?? "";

const filtered = allTours.filter((t) => {
	if (tipoRaw && !t.category.toLowerCase().includes(tipoRaw.toLowerCase()))
		return false;
	if (regionRaw && regionRaw !== "all" && !t.category.includes(regionRaw))
		return false;
	return true;
});

const activeCategory = categories.find(
	(c) => c.toLowerCase() === tipoRaw.toLowerCase(),
);
const activeRegion = regions.find(
	(r) => r.toLowerCase() === regionRaw.toLowerCase(),
);

let pageTitle = "All Tours";
let pageDescription =
	"Complete catalog of tours and expeditions by Cóndor Expeditions. Explore by category, region or duration.";

if (activeCategory && activeRegion) {
	pageTitle = `${activeCategory} in ${activeRegion}`;
	pageDescription = `${activeCategory} expeditions in the ${activeRegion} region.`;
} else if (activeCategory) {
	pageTitle = activeCategory;
	pageDescription = `Our ${activeCategory.toLowerCase()} expeditions.`;
} else if (activeRegion) {
	pageTitle = `Tours in ${activeRegion}`;
	pageDescription = `Discover all expeditions available in ${activeRegion}.`;
}
---

<Layout
  lang="en"
  title={pageTitle}
  description={pageDescription}
>
  <!-- Hero Section -->
  <section class="pt-32 md:pt-40 pb-12 bg-negro text-white">
    <Container>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl mb-4">{pageTitle}</h1>
      <p class="text-lg text-white/70 max-w-2xl">{pageDescription}</p>
      {filtered.length > 0 && (
        <p class="text-primary mt-4 text-sm font-medium">
          Showing {filtered.length} of {allTours.length} tours
          {(activeCategory || activeRegion) && (
            <a href="/en/tours" class="ml-4 underline hover:no-underline">Clear filters</a>
          )}
        </p>
      )}
    </Container>
  </section>

  <!-- Filter Bar -->
  <section class="py-6 bg-white border-b border-border/50 sticky top-0 z-30 shadow-sm">
    <Container>
      <!-- Region Filter -->
      <div class="flex flex-wrap items-center gap-2 justify-center mb-3">
        <a
          href="/en/tours"
          class={`px-4 py-2 rounded-full text-sm font-semibold transition-colors ${
            !regionRaw ? "bg-primary text-white" : "bg-background text-foreground border border-border/60 hover:border-primary hover:text-primary"
          }`}
        >
          All
        </a>
        {regions.map((r) => (
          <a
            href={`/en/tours?region=${r.toLowerCase()}${tipoRaw ? `&tipo=${tipoRaw}` : ""}`}
            class={`px-4 py-2 rounded-full text-sm font-semibold transition-colors ${
              regionRaw.toLowerCase() === r.toLowerCase()
                ? "bg-primary text-white"
                : "bg-background text-foreground border border-border/60 hover:border-primary hover:text-primary"
            }`}
          >
            {r}
          </a>
        ))}
      </div>

      <!-- Category Filter -->
      <div class="flex flex-wrap items-center gap-2 justify-center">
        {categories.map((c) => (
          <a
            href={`/en/tours?tipo=${c.toLowerCase()}${regionRaw ? `&region=${regionRaw}` : ""}`}
            class={`px-3 py-1.5 rounded-full text-xs font-semibold transition-colors ${
              tipoRaw.toLowerCase() === c.toLowerCase()
                ? "bg-primary text-white"
                : "bg-background text-muted-foreground border border-border/60 hover:border-primary hover:text-primary"
            }`}
          >
            {c}
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- Tours Grid -->
  <section class="py-14">
    <Container>
      {filtered.length > 0 ? (
        <>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {filtered.map((tour, index) => (
              <div class="animate-on-scroll" style={`--delay: ${Math.min(index, 5) * 100}ms`}>
                <TourCard tour={tour} lang="en" />
              </div>
            ))}
          </div>

          {filtered.length > 0 && (
            <p class="text-center text-sm text-muted-foreground mt-10">
              Showing {filtered.length} of {allTours.length} tours
              {activeCategory && ` · Category: ${activeCategory}`}
              {activeRegion && ` · Region: ${activeRegion}`}
              {(activeCategory || activeRegion) && (
                <a href="/en/tours" class="ml-2 text-primary hover:underline">Clear filters</a>
              )}
            </p>
          )}
        </>
      ) : (
        <div class="text-center py-16">
          <p class="text-muted-foreground text-lg mb-4">
            No tours match the selected filters.
          </p>
          <a href="/en/tours" class="inline-flex px-6 py-3 bg-primary text-white font-semibold rounded-full">
            View all tours
          </a>
        </div>
      )}
    </Container>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-negro text-center">
    <Container>
      <h2 class="font-display text-2xl md:text-3xl text-white mb-4">Looking for something different?</h2>
      <p class="text-white/70 mb-6">We design custom tours for your group.</p>
      <a
        href="/en/personalizados"
        class="inline-flex px-8 py-4 bg-primary hover:bg-primary/90 text-white font-semibold rounded-full transition-colors"
      >
        Create Custom Tour
      </a>
    </Container>
  </section>
</Layout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
  );

  document.querySelectorAll(".animate-on-scroll").forEach((el) => observer.observe(el));
</script>