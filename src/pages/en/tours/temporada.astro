---
import Layout from "../../../layouts/Layout.astro";
import { getTours, getTags, resolveLabel, formatPrice } from "../../../data/helpers";

const lang = "en";
const allTours = getTours({ status: "active" });
const tags = getTags();

const seasonTagIds = ["ballenas", "carnaval", "fin-de-ano", "vacaciones"];
const seasonTags = tags.filter((t) => seasonTagIds.includes(t.id));
---

<Layout lang="en" title="Seasonal Tours" description="Discover seasonal tours and special expeditions in Ecuador: Whale Watching, Carnival, New Year and Holidays.">
  <section class="pt-32 pb-16 bg-gradient-to-b from-primary-50 to-white text-center">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <span class="text-accent font-display text-sm uppercase tracking-widest">Seasonal</span>
      <h1 class="font-display text-4xl md:text-6xl mt-3 mb-4 text-foreground">Seasonal Tours</h1>
      <p class="text-muted-foreground text-lg max-w-3xl mx-auto">
        Unique experiences that only happen at certain times of the year.
      </p>
    </div>
  </section>

  {
    seasonTags.map((tag) => {
      const seasonTours = allTours.filter(t => t.tags.includes(tag.id));
      if (seasonTours.length === 0) return null;
      return (
        <section id={tag.id} class="py-14 even:bg-white">
          <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <h2 class="font-display text-2xl md:text-3xl text-foreground mb-8">{resolveLabel(tag, lang)}</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {seasonTours.map((tour) => (
                <a href={`/en/tours/${tour.slug}`} class="block group bg-background-alt rounded-xl p-6 border border-border/50 hover:shadow-lg transition-shadow">
                  <h3 class="font-display text-lg font-bold text-foreground mb-2 group-hover:text-primary">{resolveLabel(tour, lang)}</h3>
                  <div class="flex flex-wrap gap-2 mb-3">
                    <span class="text-xs font-semibold bg-primary-50 text-primary px-2 py-0.5 rounded-full">⏱ {tour.duration}</span>
                    <span class="text-xs font-semibold bg-accent-light text-accent px-2 py-0.5 rounded-full">{tour.difficulty}</span>
                  </div>
                  <p class="text-sm text-muted-foreground leading-relaxed mb-3 line-clamp-2">{tour.includes?.[0]?.text[lang] ?? ""}</p>
                  <div class="flex items-center justify-between mt-4">
                    <span class="font-display text-xl font-bold text-primary">From {formatPrice(tour.prices[0]?.amount ?? 0)}</span>
                    <span class="text-xs font-semibold text-accent uppercase tracking-wider">View →</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      );
    })
  }
</Layout>