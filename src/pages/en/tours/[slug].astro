---
import Layout from "../../../layouts/Layout.astro";
import tours from "../../../data/tours.json";
import company from "../../../data/company.json";

export function getStaticPaths() {
  return tours.tours.map((t) => ({
    params: { slug: t.slug },
    props: { tour: t },
  }));
}

const { tour } = Astro.props;
const waLink = `${company.contact.whatsapp}%0AI%20want%20info%20about%3A%20${encodeURIComponent(tour.titleEn ?? tour.title)}`;
const formatPrice = (n: number) => `$${n.toLocaleString("en-US")}`;
---

<Layout lang="en" title={tour.titleEn ?? tour.title} description={`${tour.titleEn ?? tour.title}: ${tour.duration}, ${tour.difficulty}. ${tour.includes}`}>
  <section class="pt-32 pb-10 bg-gradient-to-b from-primary-50 to-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="text-xs text-muted-foreground mb-4">
        <a href="/en/" class="hover:text-primary">Home</a>
        <span class="mx-1">/</span>
        <a href={`/en/tours/${tour.region}`} class="hover:text-primary">Tours in {tour.region.charAt(0).toUpperCase() + tour.region.slice(1)}</a>
        <span class="mx-1">/</span>
        <span class="text-foreground/60">{tour.titleEn ?? tour.title}</span>
      </nav>
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="text-xs font-semibold bg-primary-50 text-primary px-3 py-1 rounded-full">⏱ {tour.duration}</span>
        <span class="text-xs font-semibold bg-accent-light text-accent px-3 py-1 rounded-full">{tour.difficulty}</span>
        {tour.types.map((t: string) => (
          <span class="text-xs font-semibold bg-nature-light text-nature px-3 py-1 rounded-full">{t}</span>
        ))}
      </div>
      <h1 class="font-display text-4xl md:text-5xl text-foreground mb-4">{tour.titleEn ?? tour.title}</h1>
      <p class="text-muted-foreground text-lg max-w-3xl">{tour.includes}</p>
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <div class="lg:col-span-2 space-y-8">
          <div>
            <h2 class="font-display text-2xl text-foreground mb-4">Highlights</h2>
            <ul class="space-y-3">
              {tour.highlights.map((h: string) => (
                <li class="flex items-start gap-3 text-muted-foreground">
                  <span class="text-accent mt-0.5">✦</span> {h}
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-background rounded-xl p-6">
            <h2 class="font-display text-2xl text-foreground mb-4">Includes</h2>
            <p class="text-muted-foreground leading-relaxed">{tour.includes}</p>
          </div>
        </div>
        <aside class="lg:col-span-1">
          <div class="bg-dark text-white rounded-2xl p-6 sticky top-24">
            <p class="text-sm text-dark-foreground/60 mb-1">From</p>
            <p class="font-display text-4xl font-bold text-white mb-4">{formatPrice(tour.priceFrom)}</p>
            <p class="text-xs text-dark-foreground/60 mb-4">per person · {tour.duration}</p>
            <a href={waLink} target="_blank" rel="noopener noreferrer" class="block w-full text-center px-6 py-3.5 bg-accent hover:bg-accent-dark text-white font-semibold rounded-full transition-colors mb-3">
              Book via WhatsApp
            </a>
            <a href="/en/personalizados" class="block w-full text-center px-6 py-3 border border-white/30 hover:border-white text-white text-sm font-semibold rounded-full transition-colors">
              Customize this tour
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>