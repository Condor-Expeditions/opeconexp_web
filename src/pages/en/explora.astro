---
import TourCard from "../../components/sections/TourCard.astro";
import Container from "../../components/shared/Container.astro";
import { getCategories, getTours, type Category } from "../../data/helpers";
import type { Tour } from "../../data/helpers";
import Layout from "../../layouts/Layout.astro";

const activeTours: Tour[] = getTours().filter((t) => (t as any).status === "active");

// Categorías desde el catálogo API (con labels i18n)
const categories = getCategories();
const rawCategories = categories;

const tipoRaw = Astro.url.searchParams.get("category") ?? "";
const safeTipoRaw = (tipoRaw || "").toLowerCase();

// Filtrar tours por category id (lowercased)
const filtered = activeTours.filter((t) => {
  if (!safeTipoRaw) return true;
  return (t.categories || []).some((cat) => cat.toLowerCase() === safeTipoRaw);
});

// Encontrar categoría activa (match por slug o id, lowercased)
const activeCategory = rawCategories.find(
  (c) => c.slug.toLowerCase() === safeTipoRaw || c.id.toLowerCase() === safeTipoRaw,
);
const activeCategoryLabel = activeCategory
  ? (activeCategory.title.en || activeCategory.title.es || activeCategory.id)
  : tipoRaw
    ? tipoRaw.charAt(0).toUpperCase() + tipoRaw.slice(1)
    : "Explore";

let pageTitle = "Explore";
let pageSubtitle =
  "Discover our expeditions designed to connect you with the best of Ecuador.";
if (activeCategory && activeCategory.title.en) {
  pageTitle = activeCategory.title.en;
  pageSubtitle = `${activeCategory.title.en} expeditions.`;
} else if (tipoRaw) {
  pageTitle = activeCategoryLabel;
  pageSubtitle = `${activeCategoryLabel} expeditions.`;
}
---

<Layout
  lang="en"
  title={pageTitle}
  description={pageSubtitle}
>
  <!-- Hero Section -->
  <section class="pt-32 md:pt-40 pb-12 bg-negro text-white">
    <Container>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl mb-4">{pageTitle}</h1>
      <p class="text-lg text-white/70 max-w-2xl">{pageSubtitle}</p>
      {filtered.length > 0 && (
        <p class="text-primary mt-4 text-sm font-medium">
          Showing {filtered.length} of {activeTours.length} tours
          {activeCategory && (
            <a href="/en/explora" class="ml-4 underline hover:no-underline">View all</a>
          )}
        </p>
      )}
    </Container>
  </section>

  <!-- Filter Bar -->
  <section class="py-6 bg-white border-b border-border/50 sticky top-0 z-30 shadow-sm">
    <Container>
      <div class="flex flex-wrap items-center gap-2 justify-center">
        <!-- All filter -->
        <a
          href="/en/explora"
          class:list={[
            "px-4 py-2 text-sm font-medium rounded-full transition-colors",
            !tipoRaw ? "bg-primary text-white" : "bg-crema text-foreground hover:bg-primary hover:text-white",
          ]}
        >
          All
        </a>
        {rawCategories.map((cat) => (
          <a
            href={`/en/explora?category=${cat.slug.toLowerCase()}`}
            class:list={[
              "px-4 py-2 text-sm font-medium rounded-full transition-colors",
              safeTipoRaw === cat.slug.toLowerCase() || safeTipoRaw === cat.id.toLowerCase()
                ? "bg-primary text-white"
                : "bg-crema text-foreground hover:bg-primary hover:text-white",
            ]}
          >
            {cat.title.en || cat.title.es || cat.id}
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- Tours Grid -->
  <section class="section-padding bg-background">
    <Container>
      {filtered.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
          {filtered.map((tour, index) => (
            <div class="animate-on-scroll" style={`--delay: ${Math.min(index, 5) * 100}ms`}>
              <TourCard tour={tour} lang="en" />
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-muted-foreground text-lg mb-4">
            No tours match the selected category.
          </p>
          <a href="/en/explora" class="inline-flex px-6 py-3 bg-primary text-white font-semibold rounded-full">
            View all tours
          </a>
        </div>
      )}
    </Container>
  </section>
</Layout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
  );

  document.querySelectorAll(".animate-on-scroll").forEach((el) => observer.observe(el));
</script>