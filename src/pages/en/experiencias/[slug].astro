---
import Layout from "../../../layouts/Layout.astro";
import experiencias from "../../../data/experiencias.json";
import company from "../../../data/company.json";

export function getStaticPaths() {
  return experiencias.categories.flatMap((cat) =>
    cat.experiences.map((exp) => ({
      params: { slug: exp.slug },
      props: { exp, cat },
    }))
  );
}

const { exp, cat } = Astro.props;
const formatPrice = (n: number) => `$${n.toLocaleString("en-US")}`;
const waLink = `${company.contact.whatsapp}%0AI%20want%20more%20info%20about%3A%20${encodeURIComponent(exp.title)}`;
---

<Layout
  lang="en"
  title={`${exp.title} — Experiences`}
  description={`${exp.title}: ${exp.duration}, difficulty ${exp.difficulty}. ${exp.includes}`}
>
  <section class="pt-28 pb-10 bg-gradient-to-b from-primary-50 to-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="text-xs text-muted-foreground mb-4" aria-label="Breadcrumb">
        <a href="/en/" class="hover:text-primary transition-colors">Home</a>
        <span class="mx-1">/</span>
        <a href="/en/experiencias" class="hover:text-primary transition-colors">Experiences</a>
        <span class="mx-1">/</span>
        <span>{cat.name}</span>
      </nav>
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <span class="text-xs font-semibold bg-primary-50 text-primary px-3 py-1 rounded-full">⏱ {exp.duration}</span>
        <span class="text-xs font-semibold bg-accent-light text-accent px-3 py-1 rounded-full">{exp.difficulty}</span>
      </div>
      <h1 class="font-display text-4xl md:text-5xl text-foreground mb-4">{exp.title}</h1>
      <p class="text-muted-foreground text-lg max-w-3xl">{exp.includes}</p>
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <div class="lg:col-span-2 space-y-10">
          <div>
            <h2 class="font-display text-2xl text-foreground mb-4">Highlights</h2>
            <ul class="space-y-3">
              {
                exp.highlights.map((h) => (
                  <li class="flex items-start gap-3 text-muted-foreground">
                    <span class="text-accent mt-0.5">✦</span> {h}
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="bg-background rounded-xl p-6">
            <h2 class="font-display text-2xl text-foreground mb-4">What's Included</h2>
            <p class="text-muted-foreground leading-relaxed">{exp.includes}</p>
            <p class="text-xs text-muted-foreground mt-4">
              * Day-by-day itinerary and exclusions are confirmed at booking. Price from {formatPrice(exp.priceFrom)} per person.
            </p>
          </div>

          <div class="rounded-xl border border-border/60 p-6">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-amber-500">★★★★★</span>
              <span class="text-sm text-muted-foreground">Verified traveler reviews</span>
            </div>
            <p class="text-sm text-muted-foreground mb-4">
              Read real traveler experiences on our public Google and TripAdvisor profiles.
            </p>
            <a href={exp.reviewUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-border text-foreground text-sm font-semibold rounded-full hover:border-primary hover:text-primary transition-colors">
              See Google reviews →
            </a>
          </div>
        </div>

        <aside class="lg:col-span-1">
          <div class="bg-dark text-white rounded-2xl p-6 sticky top-24">
            <p class="text-sm text-dark-foreground/60 mb-1">From</p>
            <p class="font-display text-4xl font-bold text-white mb-4">{formatPrice(exp.priceFrom)}</p>
            <p class="text-xs text-dark-foreground/60 mb-4">per person · {exp.duration}</p>
            <a href={waLink} target="_blank" rel="noopener noreferrer" class="block w-full text-center px-6 py-3.5 bg-accent hover:bg-accent-dark text-white font-semibold rounded-full transition-colors mb-3">
              Book via WhatsApp
            </a>
            <a href="/en/contacto" class="block w-full text-center px-6 py-3 border border-white/30 hover:border-white text-white text-sm font-semibold rounded-full transition-colors">
              Design a custom itinerary
            </a>
          </div>
        </aside>
      </div>

      <div class="mt-12">
        <h2 class="font-display text-2xl text-foreground mb-4">Location</h2>
        <div class="rounded-2xl overflow-hidden border border-border/50 aspect-video">
          <iframe
            src={exp.mapEmbed}
            width="100%"
            height="100%"
            style="border:0;"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
            title={`Map of ${exp.title}`}
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-background text-center">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl md:text-3xl text-foreground mb-4">Ready for this adventure?</h2>
      <p class="text-muted-foreground mb-6">Contact us to confirm availability, dates and expedition details.</p>
      <a href="/en/contacto" class="inline-flex px-8 py-4 bg-accent hover:bg-accent-dark text-white font-semibold rounded-full transition-colors">
        Request information
      </a>
    </div>
  </section>
</Layout>