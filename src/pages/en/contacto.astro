---
import Layout from "../../layouts/Layout.astro";
import company from "../../data/company.json";
---

<Layout
  lang="en"
  title="Camp"
  description="Contact us to design your personalized expedition in Ecuador. Trekking, rafting, mountaineering and jungle. Based in Cuenca, Ecuador."
>
  <section class="pt-32 pb-12 bg-gradient-to-b from-primary-50 to-white text-center">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <span class="text-accent font-display text-sm uppercase tracking-widest">Let's Talk</span>
      <h1 class="font-display text-4xl md:text-4xl mt-3 mb-4 text-foreground">Book Your Expedition</h1>
      <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
        Tell us what kind of adventure you dream of and we'll design the perfect experience for you.
      </p>
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
        <div class="lg:col-span-3">
          <h2 class="font-display text-2xl text-foreground mb-6">Send Us a Message</h2>
          <form class="space-y-5" method="POST" action="https://formspree.io/f/YOUR_FORM_ID" >
            <input type="hidden" name="_subject" value="New inquiry — Condor Expeditions" />
            <input type="hidden" name="_next" value="/en/gracias" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-sm font-semibold text-foreground mb-1.5" for="name">Name</label>
                <input type="text" id="name" name="name" required class="w-full px-4 py-3 border border-border rounded-lg bg-white text-foreground placeholder:text-muted-foreground focus:ring-2 focus:ring-primary focus:border-primary outline-none transition" placeholder="Your full name" />
              </div>
              <div>
                <label class="block text-sm font-semibold text-foreground mb-1.5" for="email">Email</label>
                <input type="email" id="email" name="email" required class="w-full px-4 py-3 border border-border rounded-lg bg-white text-foreground placeholder:text-muted-foreground focus:ring-2 focus:ring-primary focus:border-primary outline-none transition" placeholder="you@email.com" />
              </div>
            </div>
            <div>
              <label class="block text-sm font-semibold text-foreground mb-1.5" for="phone">Phone / WhatsApp</label>
              <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 border border-border rounded-lg bg-white text-foreground placeholder:text-muted-foreground focus:ring-2 focus:ring-primary focus:border--primary" placeholder="+593 XX XXX XXXX" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-foreground mb-1.5" for="experience">Experience Type</label>
              <select id="experience" name="experience" class="w-full px-4 py-3 border border-border rounded-lg bg-white text-foreground focus:ring-2 focus:ring-primary focus:border-primary outline-none transition">
                <option value="">Select category</option>
                <option value="trekking">Trekking / Hiking</option>
                <option value="rafting">Rafting / Kayaking</option>
                <option value="mountaineering">Mountaineering / Climbing</option>
                <option value="selva">Jungle Expedition</option>
                <option value="cultural">Cultural / Community</option>
                <option value="custom">Custom expedition</option>
              </select>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-sm font-semibold text-foreground mb-1.5" for="dates">Estimated dates</label>
                <input type="text" id="dates" name="dates" class="w-full px-4 py-3 border border-border rounded-lg bg-white text-foreground placeholder:text-muted-foreground focus:ring-2 focus:ring-primary focus:border-primary outline-none transition" placeholder="e.g. July 2026" />
              </div>
              <div>
                <label class="block text-sm font-semibold text-foreground mb-1.5" for="travelers">Travellers</label>
                <input type="number" id="travelers" name="travelers" min="1" class="w-full px-4 py-3 border border-border rounded-lg bg-white text-foreground placeholder:text-muted-foreground focus:ring-2 focus:ring-primary focus:border-primary outline-none transition" placeholder="1-12" />
              </div>
            </div>
            <div>
              <label class="block text-sm font-semibold text-foreground mb-1.5" for="message">Your message</label>
              <textarea id="message" name="message" rows="5" class="w-full px-4 py-3 border border-border rounded-xl bg-white text-foreground placeholder:text-muted-foreground focus:ring-2 focus:ring-primary focus:border-primary outline-none transition resize-y" placeholder="Tell us about your adventure dreams, experience level, and any special preferences..."></textarea>
            </div>
            <button type="submit" class="inline-block px-8 py-4 bg-accent hover:bg-accent-dark text-white font-semibold rounded-full text-lg shadow-md transition-colors">
              Send Message
            </button>
          </form>
        </div>

        <div class="lg:col-span-2 space-y-8">
          <h3 class="font-display text-xl text-foreground mb-4">Direct Contact</h3>
          <div class="space-y-4 text-muted-foreground">
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 bg-primary-50 rounded-lg flex items-center justify-center text-lg">📺</span>
              <div><p class="text-xs text-muted-foreground">Phone</p><a href={company.contact.phone.href} class="text-foreground font-semibold hover:text-primary transition-colors">{company.contact.phone.name}</a></div>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 bg-accent-light rounded-lg flex items-center justify-center text-lg">💬</span>
              <div><p class="text-xs text-muted-foreground">WhatsApp</p><a href={company.contact.whatsapp} target="_blank" rel="noopener" class="text-foreground font-semibold hover:text-accent transition-colors">Chat with us</a></div>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 bg-primary-50 rounded-lg flex items-center justify-center text-lg">✉️</span>
              <div><p class="text-xs text-muted-foreground">Email</p><a href={company.contact.email.href} class="text-foreground font-semibold hover:text-primary transition-colors">{company.contact.email.name}</a></div>
            </div>
            <div class="flex items-start gap-3">
              <span class="w-10 h-10 bg-nature-light rounded-lg flex items-center justify-center text-lg">📍</span>
              <div>
                <p class="text-xs text-muted-foreground">Office</p>
                <p class="text-foreground font-semibold">{company.contact.address}</p>
                <p class="text-xs text-muted-foreground mt-1">{company.contact.scheduleWeekdays}</p>
                <a href={company.contact.maps} target="_blank" rel="noopener" class="text-primary text-xs font-semibold hover:underline">Google Maps →</a>
              </div>
            </div>
          </div>

          <div class="bg-background rounded-xl p-6">
            <h3 class="font-display font-bold text-foreground mb-3">FAQ</h3>
            <p class="text-sm text-muted-foreground mb-4">
              Need equipment? insurance included? cancelations? Write us and we'll reply within 24 hours.
            </p>
            <a href={company.contact.whatsapp} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-accent font-semibold text-sm hover:underline">
              💬 Ask via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>