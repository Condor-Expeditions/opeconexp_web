---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../data/site.config";
---

<Layout
  title="Contacto"
  description="Contáctanos para diseñar tu expedición personalizada en Ecuador. Trekking, rafting, montañismo y selva. Estamos en Cuenca."
>
  <!-- Hero -->
  <section class="pt-32 pb-12 bg-gradient-to-b from-primary-50 to-white text-center">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <span class="text-accent font-display text-sm uppercase tracking-widest">Hablemos</span>
      <h1 class="font-display text-4xl md:text-6xl mt-3 mb-4 text-foreground">
        Reserva tu Expedición
      </h1>
      <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
        Cuéntanos qué tipo de aventura sueñas y diseñaremos la experiencia perfecta para ti.
      </p>
    </div>
  </section>

  <!-- Main content -->
  <section class="py-12 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
        <!-- Formulario -->
        <div class="lg:col-span-3">
          <h2 class="font-display text-2xl text-foreground mb-6">Envíanos un Mensaje</h2>

          <form class="space-y-5" method="POST" action="#">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-sm font-semibold text-foreground mb-1.5" for="name">Nombre</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 border border-border rounded-lg bg-white text-foreground placeholder:text-muted-foreground focus:ring-2 focus:ring-primary focus:border-primary outline-none transition"
                  placeholder="Tu nombre completo"
                />
              </div>
              <div>
                <label class="block text-sm font-semibold text-foreground mb-1.5" for="email">Email</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 border border-border rounded-lg bg-white text-foreground placeholder:text-muted-foreground focus:ring-2 focus:ring-primary focus:border-primary outline-none transition"
                  placeholder="tu@email.com"
                />
              </div>
            </div>

            <div>
              <label class="block text-sm font-semibold text-foreground mb-1.5" for="phone">Teléfono / WhatsApp</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="w-full px-4 py-3 border border-border rounded-lg bg-white text-foreground placeholder:text-muted-foreground focus:ring-2 focus:ring-primary focus:border-primary outline-none transition"
                placeholder="+593 XX XXX XXXX"
              />
            </div>

            <div>
              <label class="block text-sm font-semibold text-foreground mb-1.5" for="experience">Tipo de Experiencia</label>
              <select
                id="experience"
                name="experience"
                class="w-full px-4 py-3 border border-border rounded-lg bg-white text-foreground focus:ring-2 focus:ring-primary focus:border-primary outline-none transition"
              >
                <option value="">Selecciona una categoría</option>
                <option value="trekking">Trekking / Senderismo</option>
                <option value="rafting">Rafting / Kayak</option>
                <option value="montanismo">Montañismo / Escalada</option>
                <option value="selva">Expedición de Selva</option>
                <option value="cultural">Cultural / Comunitario</option>
                <option value="personalizado">Expedición personalizada</option>
              </select>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-sm font-semibold text-foreground mb-1.5" for="dates">Fechas estimadas</label>
                <input
                  type="text"
                  id="dates"
                  name="dates"
                  class="w-full px-4 py-3 border border-border rounded-lg bg-white text-foreground placeholder:text-muted-foreground focus:ring-2 focus:ring-primary focus:border-primary outline-none transition"
                  placeholder="Ej: Julio 2026"
                />
              </div>
              <div>
                <label class="block text-sm font-semibold text-foreground mb-1.5" for="travelers">Número de viajeros</label>
                <input
                  type="number"
                  id="travelers"
                  name="travelers"
                  min="1"
                  class="w-full px-4 py-3 border border-border rounded-lg bg-white text-foreground placeholder:text-muted-foreground focus:ring-2 focus:ring-primary focus:border-primary outline-none transition"
                  placeholder="1-12"
                />
              </div>
            </div>

            <div>
              <label class="block text-sm font-semibold text-foreground mb-1.5" for="message">Tu mensaje</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                class="w-full px-4 py-3 border border-border rounded-xl bg-white text-foreground placeholder:text-muted-foreground focus:ring-2 focus:ring-primary focus:border-primary outline-none transition resize-y"
                placeholder="Cuéntanos qué tipo de aventura sueñas, tu nivel de experiencia, y cualquier preferencia especial..."
              ></textarea>
            </div>

            <button
              type="submit"
              class="inline-flex items-center px-8 py-4 bg-accent hover:bg-accent-dark text-white font-semibold rounded-full text-lg transition-colors shadow-lg hover:shadow-xl"
            >
              Enviar Mensaje
            </button>
          </form>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-2 space-y-8">
          <div>
            <h3 class="font-display text-xl text-foreground mb-4">Contacto Directo</h3>
            <div class="space-y-4 text-muted-foreground">
              <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-xl bg-primary-50 flex items-center justify-center text-lg">📞</span>
                <div>
                  <p class="text-xs text-muted-foreground">Teléfono</p>
                  <a href={siteConfig.companyInfo.phone.href} class="text-foreground font-semibold hover:text-primary transition-colors">
                    {siteConfig.companyInfo.phone.name}
                  </a>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-xl bg-accent-light flex items-center justify-center text-lg">💬</span>
                <div>
                  <p class="text-xs text-muted-foreground">WhatsApp</p>
                  <a href={siteConfig.companyInfo.whatsApp} target="_blank" rel="noopener noreferrer" class="text-foreground font-semibold hover:text-accent transition-colors">
                    Chatea con nosotros
                  </a>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-xl bg-primary-50 flex items-center justify-center text-lg">✉️</span>
                <div>
                  <p class="text-xs text-muted-foreground">Email</p>
                  <a href={siteConfig.companyInfo.email.href} class="text-foreground font-semibold hover:text-primary transition-colors">
                    {siteConfig.companyInfo.email.name}
                  </a>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-10 h-10 rounded-xl bg-nature-light flex items-center justify-center text-lg">📍</span>
                <div>
                  <p class="text-xs text-muted-foreground">Oficina</p>
                  <p class="text-foreground font-semibold">{siteConfig.companyInfo.address}</p>
                  <p class="text-xs text-muted-foreground mt-1">{siteConfig.companyInfo.scheduleWeekdays}</p>
                  <a href={siteConfig.companyInfo.location} target="_blank" rel="noopener noreferrer" class="text-primary text-xs font-semibold hover:underline">
                    Ver en Google Maps →
                  </a>
                </div>
              </div>
            </div>
          </div>

          {/* FAQ Quick */}
          <div class="bg-background rounded-xl p-6">
            <h3 class="font-display font-bold text-foreground mb-3">¿Preguntas Frecuentes?</h3>
            <p class="text-sm text-muted-foreground mb-4">
              ¿Necesitas equipo? ¿Seguro incluido? ¿Cancelaciones? Escríbenos y te respondemos en menos de 24 horas.
            </p>
            <a href={siteConfig.companyInfo.whatsApp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-accent font-semibold text-sm hover:underline">
              💬 Preguntar por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>