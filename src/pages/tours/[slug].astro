---
import Layout from "../../layouts/Layout.astro";
import {
  getTours,
  getTour,
  getCategories,
  getRegions,
  getDifficulties,
  getMeetingPoint,
  resolveLabel,
  resolveText,
  formatPrice,
} from "../../data/helpers";
import { getCompany } from "../../data/helpers";

export function getStaticPaths() {
  return getTours({ status: "active" }).map((t) => ({
    params: { slug: t.slug },
    props: { tour: t },
  }));
}

const { tour } = Astro.props;
const lang = "es";
const company = getCompany();

const title = resolveLabel(tour, lang);
const description = resolveText(tour.description, lang);

const regions = getRegions();
const categories = getCategories();
const difficulties = getDifficulties();

const regionEntry = regions.find((r) => r.id === tour.regions[0] || r.slug === tour.regions[0]);
const regionName = regionEntry ? resolveLabel(regionEntry, lang) : tour.regions[0];

const difficultyEntry = difficulties.find((d) => d.id === tour.difficulty);
const difficultyName = difficultyEntry ? resolveLabel(difficultyEntry, lang) : tour.difficulty;

const categoryLabels = tour.categories
  .map((c) => categories.find((cat) => cat.id === c))
  .filter(Boolean)
  .map((c) => resolveLabel(c!, lang));

const meetingPoint = tour.meetingPoint ? getMeetingPoint(tour.meetingPoint) : undefined;

const waLink = `${company.contact.whatsapp}%0AQuiero%20información%20del%20tour%3A%20${encodeURIComponent(title)}`;
---

<Layout title={title} description={`${title}: ${tour.duration}, ${difficultyName}. ${description}`}>
  <section class="pt-32 pb-10 bg-gradient-to-b from-primary-50 to-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="text-xs text-muted-foreground mb-4">
        <a href="/" class="hover:text-primary">Inicio</a>
        <span class="mx-1">/</span>
        <a href={`/tours/${tour.regions[0]}`} class="hover:text-primary">Tours en {regionName}</a>
        <span class="mx-1">/</span>
        <span class="text-foreground/60">{title}</span>
      </nav>
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="text-xs font-semibold bg-primary-50 text-primary px-3 py-1 rounded-full">⏱ {tour.duration}</span>
        <span class="text-xs font-semibold bg-accent-light text-accent px-3 py-1 rounded-full">{difficultyName}</span>
        {categoryLabels.map((t: string) => (
          <span class="text-xs font-semibold bg-nature-light text-nature px-3 py-1 rounded-full">{t}</span>
        ))}
      </div>
      <h1 class="font-display text-4xl md:text-5xl text-foreground mb-4">{title}</h1>
      <p class="text-muted-foreground text-lg max-w-3xl">{description}</p>
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <div class="lg:col-span-2 space-y-8">
          <div>
            <h2 class="font-display text-2xl text-foreground mb-4">Qué incluye</h2>
            <ul class="space-y-3">
              {tour.includes.map((inc) => (
                <li class="flex items-start gap-3 text-muted-foreground">
                  <span class="text-accent mt-0.5">{inc.icon}</span> {resolveText(inc.text, lang)}
                </li>
              ))}
            </ul>
          </div>
        </div>
        <aside class="lg:col-span-1">
          <div class="bg-dark text-white rounded-2xl p-6 sticky top-24">
            <p class="text-sm text-dark-foreground/60 mb-1">Desde</p>
            <p class="font-display text-4xl font-bold text-white mb-4">{formatPrice(tour.prices[0]?.amount ?? 0)}</p>
            <p class="text-xs text-dark-foreground/60 mb-4">por persona · {tour.duration}</p>
            {meetingPoint && (
              <p class="text-xs text-dark-foreground/60 mb-4">📍 Punto de encuentro: {resolveLabel(meetingPoint, lang)}</p>
            )}
            <a href={waLink} target="_blank" rel="noopener noreferrer" class="block w-full text-center px-6 py-3.5 bg-accent hover:bg-accent-dark text-white font-semibold rounded-full transition-colors mb-3">
              Reservar por WhatsApp
            </a>
            <a href="/personalizados" class="block w-full text-center px-6 py-3 border border-white/30 hover:border-white text-white text-sm font-semibold rounded-full transition-colors">
              Personalizar tour
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>