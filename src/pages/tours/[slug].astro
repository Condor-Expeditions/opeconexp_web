---
import Layout from "@/layouts/Layout.astro";
import TourDetail from "@/components/sections/TourDetail.astro";
import { getTourBySlug, resolveLabel } from "@/data/helpers";
import type { Tour } from "@/data/types";

export const prerender = true;

export async function getStaticPaths() {
  const { getTours } = await import("@/data/helpers");
  const { getReviews } = await import("@/data/helpers");
  return getTours().map((tour) => ({
    params: { slug: tour.slug },
    props: { tour, lang: "es" },
  }));
}

const { tour, lang = "es" } = Astro.props;
const title = resolveLabel(tour.title, lang);
const description = resolveLabel(tour.description, lang);
const ogImage = tour.image || "/assets/menu/tours/mira-cuenca.jpg";
---

<Layout
  title={title}
  description={description}
  ogImage={ogImage}
  lang={lang}
>
  <TourDetail tour={tour} lang={lang} />
</Layout>