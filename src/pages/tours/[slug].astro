---
import TourDetail from "@/components/sections/TourDetail.astro";
import type { Tour } from "@/data/core/helpers";
import {
	getTourBySlug,
	getValidImageUrl,
	resolveLabel,
} from "@/data/core/helpers";
import Layout from "@/layouts/Layout.astro";

export const prerender = true;

export async function getStaticPaths() {
	const { getTours } = await import("@/data/core/helpers");
	const { getReviews } = await import("@/data/core/helpers");
	return getTours().map((tour) => ({
		params: { slug: tour.slug },
		props: { tour, lang: "es" },
	}));
}

const { tour, lang = "es" } = Astro.props;
const title = resolveLabel(tour.title, lang);
const description = resolveLabel(tour.description, lang);
const ogImage = getValidImageUrl(
	tour.image || tour.gallery?.[0]?.src,
	resolveLabel(tour.title, lang),
);

const tourSchema = {
	"@context": "https://schema.org",
	"@type": "Product",
	name: title,
	description,
	image: ogImage,
	url: new URL(Astro.url.pathname, Astro.site).href,
	brand: {
		"@type": "Brand",
		name: "Cóndor Expeditions",
	},
	aggregateRating: {
		"@type": "AggregateRating",
		ratingValue: "4.9",
		reviewCount: "120",
	},
};
---

<Layout
  title={title}
  description={description}
  ogImage={ogImage}
  lang={lang}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(tourSchema)} />
  <TourDetail tour={tour} lang={lang} />
</Layout>