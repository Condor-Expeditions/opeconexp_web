---
import Layout from "../../layouts/Layout.astro";
import tours from "../../data/tours.json";

const allTours = tours.tours;
const tipos = [...new Set(allTours.flatMap((t) => t.types))];
const regiones = [...new Set(allTours.map((t) => t.region))];

const tipoRaw = Astro.url.searchParams.get("tipo") ?? "";
const regionRaw = Astro.url.searchParams.get("region") ?? "";

const filtered = allTours.filter((t) => {
  if (tipoRaw && !t.types.includes(tipoRaw)) return false;
  if (regionRaw && regionRaw !== "todas" && t.region !== regionRaw) return false;
  return true;
});

const tipoLabels: Record<string, string> = {
  trekking: "Trekking", rafting: "Rafting", montanismo: "Montañismo",
  selva: "Selva", cultural: "Cultural", "city-tour": "City Tour",
};
const regionLabels: Record<string, string> = {
  cuenca: "Cuenca", azuay: "Azuay", ecuador: "Ecuador",
};
---

<Layout
  title="Todos los Tours"
  description="Catálogo completo de tours y expediciones de Cóndor Expeditions. Explora por región, tipo o temporada."
>
  <section class="pt-32 pb-12 bg-gradient-to-b from-primary-50 to-white text-center">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-4xl md:text-6xl mt-3 mb-4 text-foreground">Todos los Tours</h1>
      <p class="text-muted-foreground text-lg max-w-3xl mx-auto">
        {filtered.length} expediciones. Explora por región, tipo de actividad o temporada.
      </p>
    </div>
  </section>

  <!-- Filtros -->
  <section class="py-6 bg-white border-b border-border/50 sticky top-0 z-30 shadow-sm">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center gap-2 justify-center">
        <a href="/tours" class:list={["px-4 py-2 rounded-full text-sm font-semibold transition-colors", !tipoRaw && !regionRaw ? "bg-primary text-white" : "bg-background text-foreground border border-border/60 hover:border-primary hover:text-primary"]}>
          Todos
        </a>
        {regiones.map((r) => (
          <a href={`/tours?region=${r}${tipoRaw ? `&tipo=${tipoRaw}` : ""}`} class:list={["px-4 py-2 rounded-full text-sm font-semibold transition-colors", regionRaw === r ? "bg-primary text-white" : "bg-background text-foreground border border-border/60 hover:border-primary hover:text-primary"]}>
            {regionLabels[r] ?? r}
          </a>
        ))}
      </div>
      <div class="flex flex-wrap items-center gap-2 justify-center mt-3">
        {tipos.map((t) => (
          <a href={`/tours?tipo=${t}${regionRaw ? `&region=${regionRaw}` : ""}`} class:list={["px-3 py-1.5 rounded-full text-xs font-semibold transition-colors", tipoRaw === t ? "bg-accent text-white" : "bg-background text-muted-foreground border border-border/60 hover:border-accent hover:text-accent"]}>
            {tipoLabels[t] ?? t}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Grid -->
  <section class="py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {filtered.map((tour) => (
          <a href={`/tours/${tour.slug}`} class="block group bg-background-alt rounded-xl p-6 border border-border/50 hover:shadow-lg transition-shadow">
            <div class="flex flex-wrap gap-1.5 mb-2">
              <span class="text-xs font-semibold text-nature bg-nature/10 px-2 py-0.5 rounded-full">{regionLabels[tour.region] ?? tour.region}</span>
              {tour.types.slice(0, 2).map((t) => (
                <span class="text-xs text-muted-foreground bg-background border border-border/40 px-2 py-0.5 rounded-full">{tipoLabels[t] ?? t}</span>
              ))}
            </div>
            <h3 class="font-display text-lg font-bold text-foreground mb-2 group-hover:text-primary transition-colors">{tour.title}</h3>
            <div class="flex flex-wrap gap-2 mb-3">
              <span class="text-xs font-semibold bg-primary-50 text-primary px-2 py-0.5 rounded-full">⏱ {tour.duration}</span>
              <span class="text-xs font-semibold bg-accent-light text-accent px-2 py-0.5 rounded-full">{tour.difficulty}</span>
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed mb-3 line-clamp-2">{tour.includes}</p>
            <div class="flex items-center justify-between mt-4 pt-3 border-t border-border/30">
              <span class="font-display text-xl font-bold text-primary">Desde ${tour.priceFrom}</span>
              <span class="text-xs font-semibold text-accent uppercase tracking-wider">Ver →</span>
            </div>
          </a>
        ))}
      </div>

      {filtered.length === 0 && (
        <div class="text-center py-16">
          <p class="text-muted-foreground text-lg mb-4">No hay tours que coincidan con los filtros seleccionados.</p>
          <a href="/tours" class="inline-flex px-6 py-3 bg-accent text-white font-semibold rounded-full">Ver todos los tours</a>
        </div>
      )}

      {filtered.length > 0 && (
        <p class="text-center text-sm text-muted-foreground mt-10">
          Mostrando {filtered.length} de {allTours.length} tours
          {tipoRaw && ` · Filtro: ${tipoLabels[tipoRaw] ?? tipoRaw}`}
          {regionRaw && ` · Región: ${regionLabels[regionRaw] ?? regionRaw}`}
          {(tipoRaw || regionRaw) && <a href="/tours" class="ml-2 text-accent hover:underline">Limpiar filtros</a>}
        </p>
      )}
    </div>
  </section>

  <section class="py-16 bg-dark text-center">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl md:text-3xl text-white mb-4">¿Buscas algo diferente?</h2>
      <p class="text-dark-foreground/70 mb-6">Diseñamos tours personalizados para tu grupo.</p>
      <a href="/personalizados" class="inline-flex px-8 py-4 bg-accent hover:bg-accent-dark text-white font-semibold rounded-full transition-colors">
        Crear Tour Personalizado
      </a>
    </div>
  </section>
</Layout>