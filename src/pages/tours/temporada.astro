---
import StatsBar from "@/components/sections/StatsBar.astro";
import SustainabilityBar from "@/components/sections/SustainabilityBar.astro";
import ToursGrid from "@/components/sections/ToursGrid.astro";
import { getAllReviews, getTours, resolveLabel } from "@/data/helpers";
import Layout from "@/layouts/Layout.astro";

const lang = "es";
const isEnglish = false;
const allTours = getTours();

// Obtener reviews para calcular popularidad
const allReviews = getAllReviews();
const tourReviewCounts = allReviews.reduce((acc: Record<string, number>, r) => {
	acc[r.tourId] = (acc[r.tourId] || 0) + 1;
	return acc;
}, {});

const title = "Temporada de Aventura";
---

<Layout title={title} description="Explora nuestros tours organizados por temporada alta y baja. Tours en Cuenca, Azuay y todo Ecuador." lang={lang}>
  <section class="section-padding">
    <h1 class="font-display text-4xl md:text-5xl text-foreground mb-4">
      {title}
    </h1>
    <p class="text-lg text-muted-foreground mb-12 max-w-2xl">
      Explora nuestros tours organizados por temporada alta y baja.
    </p>

    <!-- Temporada Alta -->
    <h2 class="text-2xl font-semibold text-foreground mb-6">Temporada Alta</h2>
    <p class="text-sm text-muted-foreground mb-8">
      Los meses ideales para aventura (junio-agosto, diciembre-enero en la sierra; mayo-octubre en montañas).
    </p>
    <ToursGrid
      tours={allTours.filter((t) => t.seasons?.high)}
      lang={lang}
    />
  </section>

  <StatsBar lang={lang} />
  <SustainabilityBar lang={lang} />
</Layout>