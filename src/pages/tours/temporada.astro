---
import Layout from "../../layouts/Layout.astro";
import tours from "../../data/tours.json";

const seasonLabels: Record<string, { label: string, labelEn: string }> = {
  "ballenas": { label: "Avistamiento de Ballenas (jun-sep)", labelEn: "Whale Watching (Jun-Sep)" },
  "carnaval": { label: "Carnaval", labelEn: "Carnival" },
  "fin-de-ano": { label: "Fin de Año", labelEn: "New Year" },
  "vacaciones": { label: "Vacaciones", labelEn: "Holidays" },
};
---

<Layout title="Tours de Temporada" description="Descubre tours y expediciones especiales por temporada en Ecuador: ballenas, carnaval, fin de año y vacaciones.">
  <section class="pt-32 pb-16 bg-gradient-to-b from-primary-50 to-white text-center">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <span class="text-accent font-display text-sm uppercase tracking-widest">Temporada</span>
      <h1 class="font-display text-4xl md:text-6xl mt-3 mb-4 text-foreground">Tours de Temporada</h1>
      <p class="text-muted-foreground text-lg max-w-3xl mx-auto">
        Experiencias únicas que solo ocurren en ciertas épocas del año.
      </p>
    </div>
  </section>

  {
    Object.entries(seasonLabels).map(([key, val]) => {
      const seasonTours = tours.tours.filter((t) => t.seasons.includes(key));
      if (seasonTours.length === 0) return null;
      return (
        <section id={key} class="py-14 even:bg-white">
          <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <h2 class="font-display text-2xl md:text-3xl text-foreground mb-8">{val.label}</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {seasonTours.map((tour) => (
                <a href={`/tours/${tour.slug}`} class="block group bg-background-alt rounded-xl p-6 border border-border/50 hover:shadow-lg transition-shadow">
                  <h3 class="font-display text-lg font-bold text-foreground mb-2 group-hover:text-primary">{tour.title}</h3>
                  <div class="flex flex-wrap gap-2 mb-3">
                    <span class="text-xs font-semibold bg-primary-50 text-primary px-2 py-0.5 rounded-full">⏱ {tour.duration}</span>
                    <span class="text-xs font-semibold bg-accent-light text-accent px-2 py-0.5 rounded-full">{tour.difficulty}</span>
                  </div>
                  <p class="text-sm text-muted-foreground leading-relaxed mb-3 line-clamp-2">{tour.includes}</p>
                  <div class="flex items-center justify-between mt-4">
                    <span class="font-display text-xl font-bold text-primary">Desde ${tour.priceFrom}</span>
                    <span class="text-xs font-semibold text-accent uppercase tracking-wider">Ver →</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      );
    })
  }

  {Object.keys(seasonLabels).length === 0 && (
    <p class="text-center text-muted-foreground py-12">Los tours de temporada estarán disponibles pronto.</p>
  )}
</Layout>