---
import TourCard from "../components/sections/TourCard.astro";
import Container from "../components/shared/Container.astro";
import { getCategories, getRegions, getTours, type Category } from "../data/core/helpers";
import type { Tour } from "../data/core/helpers";
import Layout from "../layouts/Layout.astro";

const activeTours: Tour[] = getTours().filter((t) => t.status === "active");

// Categorías desde el catálogo API (con labels i18n)
const categories = getCategories();
const rawCategories = categories.map((c) => c); // Category objects

const tipoRaw = Astro.url.searchParams.get("categoria") ?? ""; // legacy: ?categoria=
const tipo = Astro.url.searchParams.get("tipo"); // nuevo: categoria|region|temporada
const valor = (Astro.url.searchParams.get("valor") ?? "").toLowerCase();
const safeTipoRaw = (tipoRaw || "").toLowerCase();

// Resolver filtro activo según eje (tipo/valor nuevo o categoria legacy)
const regions = getRegions();
let activeFilterLabel = "";
let filtered = activeTours;

if (tipo === "region" && valor) {
	filtered = activeTours.filter((t) =>
		(t.regions || []).some((r) => r.toLowerCase() === valor),
	);
	const region = regions.find(
		(r) => r.slug.toLowerCase() === valor || r.id.toLowerCase() === valor,
	);
	activeFilterLabel = region ? region.title.es : valor;
} else if (tipo === "temporada" && valor) {
	filtered = activeTours.filter((t) =>
		valor === "alta"
			? (t.seasons?.high?.length ?? 0) > 0
			: (t.seasons?.low?.length ?? 0) > 0 ||
				((t.seasons?.high?.length ?? 0) === 0 && true),
	);
	activeFilterLabel =
		valor === "alta" ? "Temporada Alta" : "Temporada Baja";
} else if (tipo === "categoria" && valor) {
	filtered = activeTours.filter((t) =>
		(t.categories || []).some((cat) => cat.id.toLowerCase() === valor),
	);
} else {
	// legacy: ?categoria=
	filtered = activeTours.filter((t) => {
		if (!safeTipoRaw) return true;
		return (t.categories || []).some((cat) => cat.id.toLowerCase() === safeTipoRaw);
	});
}

const effCatSlug = tipo === "categoria" && valor ? valor : safeTipoRaw;

// Encontrar categoría activa (match por slug o id, lowercased)
const activeCategory = rawCategories.find(
	(c) => c.slug.toLowerCase() === effCatSlug || c.id.toLowerCase() === effCatSlug,
);
const activeCategoryLabel = activeCategory
	? (activeCategory.title.es || activeCategory.title.en || activeCategory.id)
	: tipoRaw
		? tipoRaw.charAt(0).toUpperCase() + tipoRaw.slice(1)
		: "Explora";

let pageTitle = "Explora";
let pageSubtitle =
	"Descubre nuestras expediciones diseñadas para conectarte con lo mejor del Ecuador.";
if (activeFilterLabel) {
	pageTitle = activeFilterLabel;
	pageSubtitle = `Expediciones de ${activeFilterLabel.toLowerCase()}.`;
} else if (activeCategory && activeCategory.title.es) {
	pageTitle = activeCategory.title.es;
	pageSubtitle = `Expediciones de ${activeCategory.title.es.toLowerCase()}.`;
} else if (tipoRaw) {
	pageTitle = activeCategoryLabel;
	pageSubtitle = `Expediciones de ${activeCategoryLabel.toLowerCase()}.`;
}
---

<Layout
  title={pageTitle}
  description={pageSubtitle}
  lang="es"
>
  <!-- Hero Section -->
  <section class="pt-32 md:pt-40 pb-12 bg-negro text-white">
    <Container>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl mb-4">{pageTitle}</h1>
      <p class="text-lg text-white/70 max-w-2xl">{pageSubtitle}</p>
      {filtered.length > 0 && (
        <p class="text-primary mt-4 text-sm font-medium">
          Mostrando {filtered.length} de {activeTours.length} tours
          {activeCategory && (
            <a href="/explora" class="ml-4 underline hover:no-underline">Ver todos</a>
          )}
        </p>
      )}
    </Container>
  </section>

  <!-- Filter Bar -->
  <section class="py-6 bg-white border-b border-border/50 sticky top-0 z-30 shadow-sm">
    <Container>
      <div class="flex flex-wrap items-center gap-2 justify-center">
      <!-- Todos filter -->
      <a
        href="/explora"
        class:list={[
          "px-4 py-2 text-sm font-medium rounded-full transition-colors",
          !tipoRaw ? "bg-primary text-white" : "bg-crema text-foreground hover:bg-primary hover:text-white",
        ]}
      >
        Todos
      </a>
      {rawCategories.map((cat) => (
        <a
          href={`/explora?categoria=${cat.slug.toLowerCase()}`}
          class:list={[
            "px-4 py-2 text-sm font-medium rounded-full transition-colors",
            safeTipoRaw === cat.slug.toLowerCase() || safeTipoRaw === cat.id.toLowerCase()
              ? "bg-primary text-white"
              : "bg-crema text-foreground hover:bg-primary hover:text-white",
          ]}
        >
          {cat.title.es || cat.title.en || cat.id}
        </a>
      ))}
      </div>
    </Container>
  </section>

  <!-- Tours Grid -->
  <section class="section-padding bg-background">
    <Container>
      {filtered.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
          {filtered.map((tour, index) => (
            <div class="animate-on-scroll" style={`--delay: ${Math.min(index, 5) * 100}ms`}>
              <TourCard tour={tour} lang="es" />
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-muted-foreground text-lg mb-4">
            No hay tours que coincidan con la categoría seleccionada.
          </p>
          <a href="/explora" class="inline-flex px-6 py-3 bg-primary text-white font-semibold rounded-full">
            Ver todos los tours
          </a>
        </div>
      )}
    </Container>
  </section>
</Layout>

<script>
  // SPA lifecycle: re-observar elementos en cada navegación
  function initScrollAnimations() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
    );

    document.querySelectorAll(".animate-on-scroll:not(.is-visible)").forEach((el) => observer.observe(el));
  }

  document.addEventListener("astro:page-load", initScrollAnimations);
</script>