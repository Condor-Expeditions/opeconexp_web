---
import Layout from "../layouts/Layout.astro";
import Container from "../components/shared/Container.astro";
import TourCard from "../components/sections/TourCard.astro";
import { tours } from "../data/tours";

const categories = ["Naturaleza", "Cultura", "Aventura", "Medio día", "Día completo"];

const title = "Explora";
const subtitle =
	"Descubre nuestras expediciones diseñadas para conectarte con lo mejor del Ecuador.";
---

<Layout
	title={title}
	description="Descubre los 6 tours de Condor Expeditions: Extremo Girón, Cajas Express, Ruta del Sol y la Plata, y más. Reserva tu aventura en Cuenca, Ecuador."
	lang="es"
>
	<section class="pt-32 md:pt-40 pb-12 bg-negro text-white">
		<Container>
			<h1 class="font-display text-4xl md:text-5xl lg:text-6xl mb-4">{title}</h1>
			<p class="text-lg text-white/70 max-w-2xl">{subtitle}</p>
		</Container>
	</section>

	<section class="section-padding bg-background">
		<Container>
			<!-- Filters -->
			<div class="flex flex-wrap gap-2 mb-10">
				<a
					href="/explora"
					class="px-4 py-2 text-sm font-medium rounded-full bg-primary text-white"
				>
					Todos
				</a>
				{
					categories.map((cat) => (
						<a
							href={`/explora?categoria=${cat.toLowerCase().replace(/\s+/g, "-")}`}
							class="px-4 py-2 text-sm font-medium rounded-full bg-crema text-foreground hover:bg-primary hover:text-white transition-colors"
						>
							{cat}
						</a>
					))
				}
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
				{tours.map((tour) => (
					<TourCard tour={tour} lang="es" />
				))}
			</div>
		</Container>
	</section>
</Layout>
