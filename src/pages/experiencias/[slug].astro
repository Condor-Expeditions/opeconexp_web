---
import { getTours } from "../../data/helpers";

export function getStaticPaths() {
  const tours = getTours({ status: "active" });
  return tours.map((t) => ({
    params: { slug: t.slug },
  }));
}

const { slug } = Astro.params;

return Astro.redirect(`/tours/${slug}`, 301);
---
<html>
  <head><meta http-equiv="refresh" content="0;url=/tours/{Astro.params.slug}" /></head>
  <body><p>Redirigiendo...</p></body>
</html>