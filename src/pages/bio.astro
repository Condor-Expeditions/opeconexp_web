---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Logo from "@/assets/logo.svg";
import landscape from "@/assets/tours/laguna-toreadora/20261012_0293.webp";
import BaseHead from "@/components/shared/BaseHead";
import TourismRegistration from "@/components/shared/TourismRegistration";
import { siteConfig } from "@/data/site.config";

const { companyInfo } = siteConfig;
const socialDescriptions: Record<string, string> = {
	instagram: "Un poco de inspiración para tu próximo viaje",
	facebook: "Novedades y experiencias para compartir",
	tiktok: "Ecuador, una aventura a la vez",
};
const socials = ["instagram", "facebook", "tiktok"].flatMap((icon) =>
	siteConfig.socials.filter((social) => social.icon === icon),
);
---

<html lang="es">
	<BaseHead
		title="Enlaces y contacto"
		description="Tu próxima aventura en Ecuador empieza aquí. Contacta a Condor Expeditions por WhatsApp, descubre nuestras redes y planifica tu viaje desde Cuenca."
		viewTransition={false}
	/>
	<body>
		<main class="link-page">
			<article class="link-card" aria-labelledby="page-title">
				<header>
					<div class="cover">
						<Image
							src={landscape}
							alt="Paisaje andino del Parque Nacional El Cajas, Ecuador"
							widths={[520, 780, 1040]}
							sizes="(min-width: 820px) 500px, (max-width: 560px) 100vw, 560px"
							width={1040}
							height={460}
							loading="eager"
							fetchpriority="high"
						/>
						<span class="cover-label"
							><span></span> ECUADOR · NATURALEZA & AVENTURA</span
						>
					</div>
					<div class="intro">
						<a
							class="brand"
							href="/"
							aria-label="Condor Expeditions — ir al inicio"
							><Logo /></a
						>
						<p class="eyebrow">
							DESDE CUENCA, HACIA LO EXTRAORDINARIO
						</p>
						<h1 id="page-title">
							Vive lo que otros<br /><em>solo visitan.</em>
						</h1>
						<p class="intro-description">
							Naturaleza, cultura y caminos por descubrir.<br />Tu
							próxima aventura empieza aquí.
						</p>
					</div>
				</header>

				<div class="content">
					<nav aria-label="Reserva y sitio web" class="main-links">
						<a
							class="link featured"
							href={companyInfo.whatsApp}
							target="_blank"
							rel="noopener noreferrer"
						>
							<span class="link-icon"
								><Icon
									name="brand-whatsapp"
									size={24}
									aria-hidden="true"
								/></span
							>
							<span class="link-copy"
								><strong>Planea tu aventura</strong><span
									>Escríbenos por WhatsApp</span
								></span
							>
							<Icon
								name="arrow-up-right"
								class="link-arrow"
								aria-hidden="true"
							/>
						</a>
						<a class="link website" href="/">
							<span class="link-icon"
								><Icon
									name="world"
									size={24}
									aria-hidden="true"
								/></span
							>
							<span class="link-copy"
								><strong>Conoce Condor Expeditions</strong><span
									>Explora nuestro sitio web</span
								></span
							>
							<Icon
								name="chevron-right"
								class="link-arrow"
								aria-hidden="true"
							/>
						</a>
					</nav>

					<section
						class="social-section"
						aria-labelledby="social-title"
					>
						<h2 id="social-title" class="section-label">
							SÍGUENOS EN EL CAMINO
						</h2>
						<nav aria-label="Redes sociales" class="social-links">
							{
								socials.map((social) => (
									<a
										class="link social"
										href={social.href}
										target="_blank"
										rel="noopener noreferrer"
									>
										<span class="link-icon">
											<Icon
												name={`brand-${social.icon}`}
												size={24}
												aria-hidden="true"
											/>
										</span>
										<span class="link-copy">
											<>
												<strong>{social.name}</strong>
												<span>
													{
														socialDescriptions[
															social.icon
														]
													}
												</span>
											</>
										</span>
										<Icon
											name="arrow-up-right"
											class="link-arrow"
											aria-hidden="true"
										/>
									</a>
								))
							}
						</nav>
					</section>

					<section class="contact" aria-labelledby="contact-title">
						<h2 id="contact-title" class="section-label">
							HABLEMOS DE TU PRÓXIMO VIAJE
						</h2>
						<address>
							<a href={companyInfo.phone.href}
								><Icon name="phone" aria-hidden="true" /><span
									>{companyInfo.phone.name}</span
								><Icon
									name="arrow-up-right"
									class="contact-arrow"
									aria-hidden="true"
								/></a
							>
							<a href={companyInfo.email.href}
								><Icon name="mail" aria-hidden="true" /><span
									>{companyInfo.email.name}</span
								><Icon
									name="arrow-up-right"
									class="contact-arrow"
									aria-hidden="true"
								/></a
							>
						</address>
					</section>
				</div>
				<footer>
					<TourismRegistration compact />
					<div class="footer-brand">
					<Icon
						name="brand/condor_color"
						class="w-40 h-auto"
						aria-hidden="true"
					/><p>Los mejores recuerdos empiezan con un viaje.</p>
					<a href="/">
						©
						{new Date().getFullYear()}&nbsp;
						{siteConfig.companyName}
					</a>
					</div>
				</footer>
			</article>
		</main>
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		background: var(--color-blanco);
		color: var(--color-negro);
	}
	.link-page {
		min-height: 100svh;
		padding: clamp(16px, 4vw, 56px) 20px;
		background: color-mix(in srgb, var(--color-celeste) 10%, var(--color-blanco));
	}
	.link-card {
		max-width: 560px;
		margin: 0 auto;
		border: 1px solid color-mix(in srgb, var(--color-celeste) 22%, var(--color-blanco));
		border-radius: 24px;
		overflow: hidden;
		background: var(--color-blanco);
		box-shadow: 0 24px 80px color-mix(in srgb, var(--color-negro) 7%, transparent);
		animation: arrive 0.65s ease-out both;
	}
	.cover {
		height: 208px;
		position: relative;
		overflow: hidden;
		background: var(--color-celeste);
	}
	.cover::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(#00000040, transparent 45%, #00000040);
	}
	.cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 55%;
	}
	.cover-label {
		position: absolute;
		z-index: 1;
		top: 22px;
		left: 24px;
		display: flex;
		align-items: center;
		gap: 8px;
		color: white;
		font-size: 10px;
		letter-spacing: 1.8px;
		font-weight: 600;
		text-shadow: 0 1px 6px #000;
	}
	.cover-label > span {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-blanco);
	}
	.intro {
		position: relative;
		text-align: center;
		padding: 0 20px 32px;
	}
	.brand {
		position: relative;
		display: flex;
		width: 190px;
		height: 88px;
		align-items: center;
		justify-content: center;
		margin: -44px auto 23px;
		border-radius: var(--radius);
		background: var(--color-blanco);
	}
	.brand svg {
		width: 156px;
		height: auto;
	}
	.eyebrow,
	.section-label {
		font-family: "Red Hat Text", sans-serif;
		font-size: 10px;
		font-weight: 650;
		letter-spacing: 1.5px;
	}
	.eyebrow {
		margin: 0 0 14px;
		color: var(--color-muted-foreground);
	}
	.eyebrow::before {
		content: "";
		display: inline-block;
		width: 6px;
		height: 6px;
		margin-right: 8px;
		border-radius: 50%;
		background: var(--color-rojo);
	}
	h1 {
		margin: 0;
		font-family: var(--font-family-sans);
		font-size: clamp(42px, 8vw, 54px);
		line-height: 1.16;
		font-weight: 400;
		letter-spacing: -0.05em;
		color: var(--color-negro);
	}
	h1 em {
		font-family: var(--font-family-display);
		color: var(--color-rojo);
		letter-spacing: -0.03em;
	}
	.intro-description {
		margin: 15px 0 0;
		color: var(--color-muted-foreground);
		font-size: 14px;
		line-height: 1.65;
	}
	.content {
		padding: 0 24px;
	}
	.main-links,
	.social-links {
		display: grid;
		gap: 10px;
	}
	a {
		-webkit-tap-highlight-color: transparent;
	}
	.link {
		display: flex;
		align-items: center;
		gap: 14px;
		min-height: 74px;
		padding: 14px 20px;
		border-radius: 100px;
		background: color-mix(in srgb, var(--color-celeste) 8%, var(--color-blanco));
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.2s,
			background 0.2s,
			color 0.2s;
	}
	.link:hover {
		transform: translateY(-2px);
		background: color-mix(in srgb, var(--color-celeste) 16%, var(--color-blanco));
	}
	.link-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 36px;
		height: 36px;
	}
	.link-copy {
		display: grid;
		gap: 3px;
	}
	.link-copy strong {
		font-size: 15px;
		font-weight: 650;
		line-height: 1.4;
	}
	.link-copy > span {
		color: var(--color-muted-foreground);
		font-size: 11px;
		line-height: 1.5;
	}
	.link-arrow {
		width: 18px;
		height: 18px;
		margin-left: auto;
		flex-shrink: 0;
		color: var(--color-muted-foreground);
	}
	.featured {
		background: var(--color-rojo);
		color: white;
	}
	.featured:hover {
		background: var(--color-negro);
	}
	.featured .link-icon {
		border-radius: 50%;
		background: #ffffff18;
	}
	.featured .link-copy > span {
		color: #fff;
	}
	.featured .link-arrow {
		color: white;
	}
	.website .link-icon {
		color: var(--color-celeste);
	}
	.social-section {
		margin-top: 32px;
	}
	.section-label {
		margin: 0 0 12px;
		font-family: var(--font-family-sans);
		color: var(--color-muted-foreground);
		font-size: 10px;
	}
	.social {
		min-height: 68px;
		border-radius: var(--radius);
	}
	.social .link-icon {
		color: var(--color-negro);
	}
	.contact {
		margin-top: 32px;
	}
	address {
		font-style: normal;
	}
	address a {
		display: flex;
		align-items: center;
		gap: 12px;
		min-height: 44px;
		color: var(--color-muted-foreground);
		text-decoration: none;
		font-size: 13px;
		overflow-wrap: anywhere;
		border-radius: 5px;
	}
	address a:hover {
		color: var(--color-rojo);
	}
	address svg {
		width: 17px;
		height: 17px;
		flex-shrink: 0;
		color: var(--color-celeste);
	}
	address .contact-arrow {
		margin-left: auto;
		width: 14px;
		height: 14px;
	}
	footer {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		margin: 32px 0 0;
		text-align: center;
		padding: 28px 24px;
		background: color-mix(in srgb, var(--color-celeste) 8%, var(--color-blanco));
	}
	.footer-brand {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
	}
	footer :global(.footer-registration) {
		border-top: 0;
		padding-block: 0 8px;
	}
	footer p {
		margin: 8px 0 10px;
		font-size: 11px;
		color: var(--color-muted-foreground);
	}
	footer a {
		color: var(--color-muted-foreground);
		text-decoration: none;
		font-size: 10px;
		letter-spacing: 0.4px;
	}
	a:focus-visible {
		outline: 2px solid var(--color-rojo);
		outline-offset: 4px;
	}
	@keyframes arrive {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	@media (min-width: 820px) {
		.link-card {
			display: grid;
			grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
			max-width: 1100px;
		}
		header {
			min-width: 0;
			background: color-mix(in srgb, var(--color-celeste) 5%, var(--color-blanco));
		}
		.cover {
			height: clamp(280px, 30vw, 380px);
		}
		.intro {
			padding: 0 24px 40px;
		}
		.brand {
			width: 210px;
			height: 96px;
			margin-top: -48px;
			margin-bottom: 28px;
		}
		h1 {
			font-size: clamp(40px, 4.1vw, 56px);
		}
		.content {
			min-width: 0;
			padding: 40px clamp(24px, 3vw, 44px);
		}
		.link {
			border-radius: 12px;
		}
		footer {
			grid-column: 1 / -1;
			display: grid;
			grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
			gap: 40px;
			margin: 0;
			padding: 32px 40px;
		}
		footer :global(.footer-registration) {
			padding: 0;
		}
		footer :global(.footer-registration.compact dl) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 16px 24px;
		}
		.footer-brand {
			justify-content: center;
		}
	}
	@media (max-width: 560px) {
		.link-page {
			padding: 16px 12px;
		}
		.cover {
			height: 180px;
		}
		.cover-label {
			left: 18px;
			font-size: 9px;
			letter-spacing: 1.2px;
		}
		.content {
			padding: 0 16px;
		}
		footer {
			padding-inline: 20px;
		}
		.eyebrow {
			font-size: 9px;
			letter-spacing: 1.1px;
		}
		.link {
			gap: 10px;
			padding: 13px 12px;
		}
		.link-copy strong {
			font-size: 14px;
		}
		.link-copy > span {
			font-size: 10px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.link-card {
			animation: none;
		}
		.link {
			transition: none;
		}
		.link:hover {
			transform: none;
		}
	}
</style>
