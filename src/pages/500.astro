---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Error del servidor"
  description="Ocurrió un error inesperado. Estamos trabajando para solucionarlo."
>
  <section class="min-h-[70vh] flex items-center justify-center py-16">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 text-center">
      <span class="font-display text-[10rem] md:text-[12rem] font-bold text-accent/10 leading-none block">500</span>
      <h1 class="font-display text-3xl md:text-5xl text-foreground mb-4 -mt-8">
        Error del servidor
      </h1>
      <p class="text-muted-foreground text-lg mb-8 max-w-md mx-auto">
        Algo salió mal. Ya estamos trabajando en ello. Por favor, intenta de nuevo más tarde o contáctanos directamente.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/" class="px-8 py-4 bg-accent hover:bg-accent-dark text-white font-semibold rounded-full transition-colors">
          Volver al Inicio
        </a>
        <a href="/contacto" class="px-8 py-4 border-2 border-primary text-primary font-semibold rounded-full transition-colors">
          Contactar
        </a>
      </div>
    </div>
  </section>
</Layout>