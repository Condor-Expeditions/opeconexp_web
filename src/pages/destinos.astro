---
import Layout from "../layouts/Layout.astro";
import { getTours } from "../data/helpers";

const featuredTours = getTours({ status: "active" }).filter(
  (t) => t.categories.includes("city-tour") || t.categories.includes("cultural")
);

const regiones = [
	{
		slug: "andes",
		name: "Andes Ecuatorianos",
		description:
			"La majestuosa cordillera de los Andes atraviesa Ecuador ofreciendo algunos de los paisajes más impresionantes del planeta.",
		destinations: [
			{ name: "Cotopaxi", elevation: "5,897 m", description: "El volcán activo más alto del mundo. Ascenso técnico con glaciares.", image: "/images/destinos/cototín.jpg" },
			{ name: "Chimborazo", elevation: "6,263 m", description: "El punto más cercano al sol debido a la protuberancia ecuatorial.", image: "/images/destinos/chimborazo.jpg" },
			{ name: "Quilotoa", elevation: "3,914 m", description: "Laguna cratérica de color esmeralda. Trekking circular de 3 días.", image: "/images/destinos/quilotoa.jpg" },
			{ name: "Cajas", elevation: "4,450 m", description: "Parque Nacional con más de 200 lagunas de origen glaciar cerca de Cuenca.", image: "/images/destinos/cajas.jpg" },
		],
	},
	{
		slug: "amazonia",
		name: "Amazonía",
		description: "La selva tropical más biodiversa del planeta, hogar de miles de especies y comunidades indígenas.",
		destinations: [
			{ name: "Yasuní", description: "Reserva de Biosfera UNESCO con la mayor concentración de especies por m²." },
			{ name: "Cuyabeno", description: "Sistema de 14 lagunas interconectadas ideal para expedición en canoa." },
			{ name: "Tena", description: "Capital del rafting ecuatoriano. Rápidos clase III-IV en los ríos Jatunyacu y Misahuallí." },
		],
	},
	{
		slug: "costa",
		name: "Costa del Pacífico",
		description:
			"Playas infinitas, bosques húmedos tropicales y una de las mejores temporadas de avistamiento de ballenas del mundo.",
		destinations: [
			{ name: "Puerto López", description: "Avistamiento de ballenas jorobadas (junio-septiembre) y Parque Nacional Machalilla." },
			{ name: "Mindo", description: "Bosque nublado con más de 500 variedades de aves. Ideal para birdwatchers locales." },
			{ name: "Montañita", description: "Surf de clase mundial, cultura playera y vida nocturna." },
		],
	},
	{
		slug: "galapagos",
		name: "Islas Galápagos",
		description:
			"El mejor laboratorio viviente del planeta. Encuentros únicos con fauna que no le tiene miedo al ser humano.",
		destinations: [
			{ name: "San Cristóbal", description: "Leones marinos en la plaza central, snorkel en León dormido." },
			{ name: "Isabela", description: "Túneles de lava, pingüinos ecuatoriales y tortugas gigantes." },
			{ name: "Santa Cruz", description: "Estación Charles Darwin, cráteres Los Gemelos y tortugas en estado natural." },
		],
	},
];
---

<Layout
  title="Destinos"
  description="Explora los destinos más impresionantes de Ecuador con Cóndor Expeditions: Andes, Amazonía, Costa del Pacífico e Islas Galápagos."
>
  <!-- Hero banner -->
  <section class="pt-32 pb-16 bg-gradient-to-b from-primary-50 to-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-accent font-display text-sm uppercase tracking-widest">Descubre Ecuador</span>
      <h1 class="font-display text-4xl md:text-6xl mt-3 mb-4 text-foreground">
        Nuestros Destinos
      </h1>
      <p class="text-muted-foreground text-lg max-w-3xl mx-auto">
        Cuatro mundos, una sola aventura. Desde las cumbres andinas hasta las profundidades del Pacífico.
      </p>
    </div>
  </section>

  <!-- Regiones -->
  {
    regiones.map((region) => (
      <section id={region.slug} class="py-16 even:bg-white">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 rounded-xl bg-primary flex items-center justify-center text-white font-display text-sm font-bold">
              {region.slug === "andes" ? "650m" : region.slug === "amazonia" ? "🌿" : region.slug === "costa" ? "🌊" : "🏝️"}
            </div>
            <h2 class="font-display text-2xl md:text-3xl text-foreground">{region.name}</h2>
          </div>
          <p class="text-muted-foreground text-lg mb-10 max-w-3xl">{region.description}</p>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {
              region.destinations.map((d) => (
                <div class="bg-background rounded-xl p-6 hover:shadow-lg transition-shadow border border-border/50">
                  <h3 class="font-display text-lg font-bold text-foreground mb-2">{d.name}</h3>
                  {d.elevation && (
                    <span class="text-xs font-semibold text-primary bg-primary-50 px-2 py-0.5 rounded-full">{d.elevation}</span>
                  )}
                  <p class="text-sm text-muted-foreground mt-3 leading-relaxed">{d.description}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    ))
  }
</Layout>