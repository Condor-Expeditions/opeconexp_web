---
import Layout from "@/layouts/Layout";
import PolicyContent from "@/components/shared/PolicyContent";
import { commercialPolicies } from "@/data/commercial-policies";
import "../styles/information.css";
---
<Layout title="Políticas comerciales: reservas, cancelaciones y pagos" description="Consulta las políticas comerciales de Condor Expeditions: reservas, pagos, cambios de fecha, cancelaciones, devoluciones y requisitos para viajar.">
	<main class="info-page">
		<header class="info-section"><div class="info-shell">
			<p class="info-eyebrow">Condor Expeditions</p>
			<h1 class="info-title">Políticas comerciales:<br /><em>reservas, cancelaciones y pagos.</em></h1>
			<p class="info-lead">OPERADORA DE TURISMO CONDOR EXPEDITIONS - OPECONEXP S.A.S.</p>
			<nav class="policy-index" aria-label="Apartados de las políticas comerciales">{commercialPolicies.map((section, index) => <a href={`#${section.id}`}><span>{String(index + 1).padStart(2, "0")}</span>{section.title}</a>)}</nav>
		</div></header>
		<div class="info-shell policy-document">{commercialPolicies.map((section, index) => <section id={section.id} aria-labelledby={`${section.id}-title`}>
			<p class="info-eyebrow">{String(index + 1).padStart(2, "0")}</p>
			<h2 id={`${section.id}-title`}>{section.title}</h2>
			<PolicyContent sectionId={section.id} />
		</section>)}</div>
	</main>
</Layout>

<style>
	.policy-index { display: grid; gap: .25rem; margin-top: 2rem; max-width: 48rem; }
	.policy-index a { display: flex; gap: 1rem; align-items: baseline; padding-block: .6rem; font-size: .9rem; }
	.policy-index span { color: var(--color-rojo); font-size: .75rem; }
	.policy-index a:hover { text-decoration: underline; text-underline-offset: .25em; }
	.policy-document { padding-bottom: 4rem; }
	.policy-document section { max-width: 52rem; border-top: 1px solid var(--color-border); padding-block: 2.5rem; scroll-margin-top: 8rem; }
	.policy-document h2 { margin-bottom: 1.5rem; font-size: clamp(1.4rem, 3vw, 2rem); line-height: 1.3; font-weight: 500; letter-spacing: -.03em; }
</style>
