---
import Layout from "../layouts/Layout.astro";

const equipo = [
	{
		name: "Xavier Cun",
		role: "Director de Expediciones",
		bio: "Montañista con más de 15 años guiando ascensos en los Andes. Certificado ASEGUIM y Wilderness First Responder (WFR). Conoce cada rincón del Ecuador a pie.",
	},
	{
		name: "Karla Mendoza",
		role: "Guía Líder de Selva",
		bio: "Bióloga de profesión y apasionada de la conservación. Especialista en aves y fauna amazónica. Dirige nuestras expediciones en Yasuní y Cuyabeno.",
	},
	{
		name: "Pablo Santillán",
		role: "Guía de Rafting",
		bio: "Guía Internacional de Rafting (IRF) con más de 8 años en los ríos del Napo. Instructor certificado de rescate en aguas rápidas.",
	},
	{
		name: "Nina Chasiquiza",
		role: "Enlace Comunitario",
		bio: "Enlace con comunidades indígenas de la sierra y la Amazonía. Kichwa nativa, poeta, y gestora cultural de proyectos sostenibles.",
	},
];

const proposito = [
	{
		title: "Misión",
		description:
			"Ofrecer al viajero una experiencia íntima y en conexión con la naturaleza y las culturas locales del Ecuador, con el mínimo impacto ambiental y el máximo respeto.",
	},
	{
		title: "Visión",
		description:
			"Ser reconocidos como una de las 5 operadoras de expedición más destacadas de Sudamérica para 2030, referentes en turismo sostenible y trato personalizado.",
	},
];

const valores = [
	{ name: "Seguridad Ante Todo", desc: "Estándares de seguridad certificados en cada expedición. Planificación rigurosa. Cero excepciones." },
	{ name: "Experiencia Única", desc: "Cada viaje es irrepetible. Diseñamos itinerarios a medida, nunca dos grupos iguales." },
	{ name: "Pasión por Ecuador", desc: "Amamos lo que hacemos y dónde vivimos. Compartir nuestro país es nuestro mayor orgullo." },
	{ name: "Apoyo Local", desc: "Proveedores, guías y comunidades locales. Creemos en compartir la riqueza con quienes custodian estos lugares." },
];
---

<Layout
  title="Nosotros"
  description="Conoce al equipo detrás de Cóndor Expeditions. Guías certificados, compromiso ambiental y más de 15 años creando experiencias de aventura únicas en Ecuador."
>
  <!-- Hero -->
  <section class="pt-32 pb-16 bg-gradient-to-b from-primary-50 to-white text-center">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <span class="text-accent font-display text-sm uppercase tracking-widest">Quiénes Somos</span>
      <h1 class="font-display text-4xl md:text-6xl mt-3 mb-4 text-foreground">
        El Espíritu de la Exploración
      </h1>
      <p class="text-muted-foreground text-lg max-w-3xl mx-auto">
        Somos un equipo apasionado por la aventura, la naturaleza y el Ecuador. Cada expedición es una historia nueva y cada viajero un compañero de ruta.
      </p>
    </div>
  </section>

  <!-- Propósito -->
  <section class="py-16 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-4xl mx-auto">
        {
          proposito.map((p) => (
            <div class="text-center">
              <h2 class="font-display text-2xl text-accent mb-3">{p.title}</h2>
              <p class="text-muted-foreground leading-relaxed">{p.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Valores -->
  <section class="py-16 bg-background">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl text-center text-foreground mb-12">Nuestros Valores</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {
          valores.map((v) => (
            <div class="text-center p-6 bg-white rounded-xl border border-border/50">
              <h3 class="font-display font-bold text-foreground mb-2">{v.name}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{v.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Equipo -->
  <section class="py-16 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl text-center text-foreground mb-12">Nuestro Equipo</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {
          equipo.map((e) => (
            <div class="text-center">
              <div class="w-24 h-24 mx-auto rounded-full bg-primary-100 mb-4 flex items-center justify-center text-3xl font-display text-primary">
                {e.name.charAt(0)}
              </div>
              <h3 class="font-display font-bold text-foreground text-lg">{e.name}</h3>
              <p class="text-accent text-sm font-semibold mb-2">{e.role}</p>
              <p class="text-muted-foreground text-sm leading-relaxed">{e.bio}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>