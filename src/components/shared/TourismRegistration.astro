---
import { siteConfig } from "@/data/site.config";
interface Props { lang?: "es" | "en"; compact?: boolean; }
const { lang = "es", compact = false } = Astro.props;
const isEnglish = lang === "en";
const registration = siteConfig.companyInfo.tourismRegistration;
---
<section class:list={["footer-registration", { compact }]} aria-labelledby="footer-registration-title">
	<h2 id="footer-registration-title">{isEnglish ? "Tourism registration" : "Registro de Turismo"}</h2>
	<dl>
		<div><dt>{isEnglish ? "Registered name" : "Denominación"}</dt><dd>{registration.denomination}</dd></div>
		<div><dt>{isEnglish ? "Classification" : "Clasificación"}</dt><dd>{registration.classification}</dd></div>
		<div><dt>{isEnglish ? "Tourism registration number" : "Número de Registro de Turismo"}</dt><dd>{registration.number}</dd></div>
		<div><dt>{isEnglish ? "Annual operating license" : "Licencia Única Anual de Funcionamiento"}</dt><dd>{registration.annualLicense}</dd></div>
	</dl>
</section>

<style>
	.footer-registration { width: 100%; border-top: 1px solid var(--color-border); padding-block: 2rem; text-align: left; color: var(--color-negro); }
	h2 { margin: 0 0 1.25rem; font-family: var(--font-family-sans); font-size: .875rem; font-weight: 700; line-height: 1.6; text-transform: uppercase; letter-spacing: .1em; }
	dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem 2rem; margin: 0; }
	dt { color: var(--color-muted-foreground); font-size: .75rem; line-height: 1.6; }
	dd { margin: .25rem 0 0; font-size: .875rem; line-height: 1.7; overflow-wrap: anywhere; }
	.compact dl { grid-template-columns: minmax(0, 1fr); }
	@media (max-width: 539px) { dl { grid-template-columns: minmax(0, 1fr); } }
</style>
