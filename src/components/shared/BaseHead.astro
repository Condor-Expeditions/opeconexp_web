---
import { siteConfig } from "@/data/config/site.config";
import "../../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { join } from "node:path";
import { AstroFont } from "astro-font";

export interface Props {
	title: string;
	description?: string;
	ogImage?: string | undefined;
	articleDate?: string | undefined;
	viewTransition: boolean;
}

const {
	title,
	description = siteConfig.seo.description,
	ogImage,
	articleDate,
	viewTransition = true,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(
	ogImage ? ogImage : "/open-graph.webp",
	Astro.url,
).href;

const titleSeparator = "•";

const siteTitle = `${title} ${titleSeparator} ${siteConfig.companyName}`;

const googleAnalyticsId = import.meta.env.VITE_GOOGLE_ANALYTICS_ID;
const pathname = Astro.url.pathname;
const isEnglish = pathname.startsWith("/en/");
const alternatePathname = isEnglish
	? pathname.replace(/^\/en/, "") || "/"
	: `/en${pathname}`;
const alternateURL = new URL(alternatePathname, Astro.site);

const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "TouristInformationCenter",
	"@id": "https://condorexpedition.com/#organization",
	name: siteConfig.companyName,
	url: "https://condorexpedition.com/",
	description,
	telephone: siteConfig.companyInfo.phone.name,
	email: siteConfig.companyInfo.email.name,
	address: {
		"@type": "PostalAddress",
		addressLocality: "Cuenca",
		addressRegion: "Azuay",
		addressCountry: "EC",
	},
	areaServed: "Ecuador",
	sameAs: siteConfig.socials.map((s) => s.href),
};
---

<head>
  <!-- Global Metadata -->
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate icon" href="/favicon.ico" />
  <meta name="theme-color" content="#14110f" />

  <!-- PWA Manifest -->
  <link rel="manifest" href="/manifest.json" />

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Hreflang for i18n -->
  <link rel="alternate" hreflang="es" href={isEnglish ? alternateURL : canonicalURL} />
  <link rel="alternate" hreflang="en" href={isEnglish ? canonicalURL : alternateURL} />
  <link rel="alternate" hreflang="x-default" href={canonicalURL} />

  <!-- Primary Meta Tags -->
  <title>{siteTitle}</title>

  <!-- ViewTransitions  -->
  {viewTransition && <ClientRouter  />}

  <!-- SEO -->
  <meta name="title" content={siteTitle} />
  <meta name="description" content={description} />
  <meta name="author" content={siteConfig.companyName} />
  <!-- Keywords -->
  <meta
    name="keywords"
    content="operadora turística Cuenca, tours Azuay, Parque Nacional El Cajas, Ingapirca, Girón, Déleg, Guachapala, tours Cuenca, Condor Expeditions, turismo de aventura Ecuador, expediciones Cuenca, turismo responsable Ecuador"
  />
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={articleDate ? "article" : "website"} />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={socialImageURL} />
  {
    articleDate && (
      <>
        <meta property="article:author" content={siteConfig.author} />
        <meta property="article:published_time" content={articleDate} />
      </>
    )
  }

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={Astro.url} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={socialImageURL} />

  <!-- Structured Data: Organization / LocalBusiness -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />

  <AstroFont
    config={[
      {
        name: "Red Hat Text",
        src: [
          {
            style: "normal",
            path: join(
              process.cwd(),
              "public",
              "fonts",
              "RedHatText-VariableFont.woff2"
            ),
          },
        ],
        preload: true,
        display: "swap",
        selector: "body",
        fallback: "sans-serif",
      },
      {
        name: "Give You Glory",
        src: [
          {
            style: "normal",
            path: join(
              process.cwd(),
              "public",
              "fonts",
              "GiveYouGlory-Regular.woff2"
            ),
          },
        ],
        preload: false,
        display: "swap",
        selector: "h1, h2, h3, h4, h5, h6",
        fallback: "serif",
      },
    ]}
  />

  {googleAnalyticsId && (
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`} />
  )}
  {googleAnalyticsId && (
    <script is:inline define:vars={{ googleAnalyticsId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', googleAnalyticsId);
    </script>
  )}
</head>
