---
import { siteConfig } from "@/data/site.config";

interface Props {
	lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const socialPaths: Record<string, string> = {
	facebook: "M14 21v-8h3l.5-4H14V7c0-1 .3-2 2-2h2V2h-3c-3 0-5 2-5 5v2H7v4h3v8",
	instagram: "M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Z M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0 M17.5 6.5h.01",
	tiktok: "M9 12a4 4 0 1 0 4 4V3a6 6 0 0 0 6 6",
	youtube: "M3 7c0-2 18-2 18 0v10c0 2-18 2-18 0Z M10 9l5 3-5 3Z",
	whatsapp: "M21 11.5a9 9 0 0 1-13 8L3 21l1.5-5A9 9 0 1 1 21 11.5Z M8 8c0 4 4 8 8 8l1-3-3-1-1 1-2-2 1-1-1-3Z",
};
---

<div class="social-links">
	{siteConfig.socials.map((social) => (
		<a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={`${social.name} (${lang === "en" ? "opens in a new tab" : "abre en otra pestaña"})`}>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={socialPaths[social.icon]} /></svg>
		</a>
	))}
</div>

<style>
	.social-links { display: flex; flex-wrap: wrap; gap: .5rem; }
	a { display: grid; place-items: center; width: var(--social-link-size, 2.25rem); height: var(--social-link-size, 2.25rem); border-radius: 50%; transition: background 200ms, color 200ms, transform 200ms; }
	svg { width: 1.1rem; height: 1.1rem; }
	a:hover { background: var(--color-crema); color: var(--color-rojo); transform: translateY(-2px); }
	a:focus-visible { outline: 2px solid var(--color-rojo); outline-offset: 6px; }
	@media (max-width: 767px) {
		.social-links { --social-link-size: 1.75rem; gap: .75rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		a { transition: none; }
		a:hover { transform: none; }
	}
</style>
