---
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Card from "@/components/ui/Card.astro";
import { getTourData, getValidImageUrl, resolveLabel } from "@/data/helpers";
import type { Tour } from "@/data/types";

export interface Props {
	tour: Tour;
	lang?: "es" | "en";
}

const { tour, lang = "es" } = Astro.props;

// Convertir tour API-local → legacy compat para reusar componente
const t = getTourData(tour, lang);
const isEnglish = lang === "en";

const reserveLabel = isEnglish ? "Book" : "Reservar";
const fromLabel = isEnglish ? "From" : "Desde";
const detailHref = isEnglish ? `/en/tours/${tour.slug}` : `/tours/${tour.slug}`;
---

<Card variant="elevated" padding="none" class="hover-lift img-zoom h-full flex flex-col">
  <div class="relative aspect-[4/3] overflow-hidden rounded-t-lg">
    <img
      src={getValidImageUrl(t.image || tour.image)}
      alt={resolveLabel(tour.title, lang)}
      width={400}
      height={300}
      class="w-full h-full object-cover"
      loading="lazy"
      onerror="this.onerror=null;this.src='https://placehold.co/400x300?text='+encodeURIComponent(this.alt);"
    />
    {t.badge && (
      <div class="absolute top-3 left-3">
        <Badge variant="primary" size="sm">{t.badge}</Badge>
      </div>
    )}
  </div>
  <div class="p-5 flex flex-col flex-1">
    <div class="flex items-center gap-2 mb-2">
      <Badge variant="secondary" size="sm">{t.category.split(",")[0]}</Badge>
      <span class="text-xs text-muted">{t.operational.duration}</span>
    </div>
    <h3 class="text-lg font-semibold text-foreground mb-2 leading-tight">
      {t.name}
    </h3>
    <p class="text-sm text-muted-foreground leading-relaxed mb-4 flex-1">
      {t.shortDescription}
    </p>
    <div class="flex items-center justify-between mt-auto pt-3 border-t border-border">
      <div>
        <span class="text-xs text-muted">{fromLabel}</span>
        <p class="text-lg font-bold text-primary">{t.pricing.general}</p>
      </div>
      <Button variant="primary" size="sm" href={detailHref}>
        {reserveLabel}
      </Button>
    </div>
  </div>
</Card>