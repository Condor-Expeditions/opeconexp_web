---
// StatsBar.astro — Muestra estadísticas clave de la empresa
import { getStats } from "@/data/core/helpers";

export interface Props {
	lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const isEnglish = lang === "en";
const stats = getStats();

const title = isEnglish ? "Our Numbers" : "Nuestros Números";
---

<section class="section-padding bg-gradient-to-b from-primary-red to-primary-red-dark text-white">
  <div class="text-center mb-12">
    <h2 class="font-display text-3xl md:text-5xl text-white mb-4">{title}</h2>
    <p class="text-lg text-white/80 max-w-2xl mx-auto">
      {isEnglish 
        ? "Numbers that tell our story of adventure and impact." 
        : "Números que cuentan nuestra historia de aventura e impacto."}
    </p>
  </div>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
    {stats.map((stat) => (
      <div key={stat.value} class="text-center">
        <div class="text-4xl md:text-5xl font-bold text-white mb-2">
          {stat.value}{stat.suffix}
        </div>
        <p class="text-sm md:text-base text-white/85">
          {stat.label[lang]}
        </p>
      </div>
    ))}
  </div>
</section>