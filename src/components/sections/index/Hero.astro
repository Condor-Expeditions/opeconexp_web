---
import ContainerHeader from "@/components/shared/ContainerHeader";

const data = [
  {
    backgroundUrl: "https://picsum.photos/1920/1080?random=1",
    altImage: "Paisaje andino ecuatoriano",
    title: "Ecuador:",
    subtitle: " Vive lo que otros solo visitan",
    accentClass: "text-primary",
    paragraph:
      "Conoce Condor Expeditions, operadora turística enfocada a la experiencia de vivir algo único en nuestro hermoso páis.",
  },
  {
    backgroundUrl: "https://picsum.photos/1920/1080?random=2",
    altImage: "Parque Nacional El Cajas",
    title: "Parque Nacional",
    subtitle: "El Cajas",
    accentClass: "text-secondary",
    paragraph:
      "Descubre este increible parque nacional, reserva natural nacional del Ecuador.",
  },
  {
    backgroundUrl: "https://picsum.photos/1920/1080?random=3",
    altImage: "Costa ecuatoriana",
    title: "Playas",
    subtitle: "Paradisíacas",
    accentClass: "text-primary",
    paragraph: "Sol, arena y mar en cada rincón de la costa.",
  },
];
---

<section class="relative min-h-screen w-full overflow-hidden">
  <!-- Carousel Container -->
  <div id="hero-carousel" class="embla absolute inset-0 w-full h-full">
    <div
      class="embla__viewport w-full h-full overflow-hidden select-none touch-pan-y"
    >
      <div class="embla__container flex h-full">
        {
          data.map((slide, index) => (
            <div
              class="embla__slide flex-[0_0_100%] min-w-0 relative h-full"
              data-title={slide.title}
              data-subtitle={slide.subtitle}
              data-accent-class={slide.accentClass}
              data-paragraph={slide.paragraph}
            >
              <img
                src={slide.backgroundUrl}
                alt={slide.altImage}
                class="absolute inset-0 w-full h-full object-cover pointer-events-none"
                loading={index === 0 ? "eager" : "lazy"}
                draggable="false"
              />
              <div class="absolute inset-0 bg-black/20" />
            </div>
          ))
        }
      </div>
    </div>

    <!-- Navigation Arrows -->
    <button
      type="button"
      class="hidden embla__prev absolute left-4 top-1/2 -translate-y-1/2 z-20 p-3 rounded-full bg-black/30 text-white backdrop-blur-sm transition-all hover:bg-black/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2"
      aria-label="Slide anterior"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m15 18-6-6 6-6"></path>
      </svg>
    </button>
    <button
      type="button"
      class="hidden embla__next absolute right-4 top-1/2 -translate-y-1/2 z-20 p-3 rounded-full bg-black/30 text-white backdrop-blur-sm transition-all hover:bg-black/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2"
      aria-label="Slide siguiente"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </button>

    <!-- Dots Indicators -->
    <!-- <div
      class="embla__dots absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex gap-3"
      role="tablist"
      aria-label="Navegación de slides"
    >
      <button
        type="button"
        class="embla__dot w-3 h-3 rounded-full bg-white/50 transition-all hover:bg-white/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2"
        aria-label="Ir al slide 1"
        aria-selected="true"
        role="tab"
      ></button>
      <button
        type="button"
        class="embla__dot w-3 h-3 rounded-full bg-white/50 transition-all hover:bg-white/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2"
        aria-label="Ir al slide 2"
        aria-selected="false"
        role="tab"
      ></button>
      <button
        type="button"
        class="embla__dot w-3 h-3 rounded-full bg-white/50 transition-all hover:bg-white/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2"
        aria-label="Ir al slide 3"
        aria-selected="false"
        role="tab"
      ></button>
    </div> -->
  </div>

  <!-- Fixed hero content, synchronized with the active slide -->
  <ContainerHeader class="pb-52 absolute inset-0 z-10 pointer-events-none flex">
    <div
      class="hero-content flex flex-row items-end justify-start text-white gap-5 w-full"
    >
      <h2 class="mb-6 text-4xl font-extrabold md:text-6xl flex-2">
        <span id="hero-title" class="block">{data[0].title}</span>
        <span id="hero-subtitle" class={`block ${data[0].accentClass}`}>
          {data[0].subtitle}
        </span>
      </h2>
      <p id="hero-paragraph" class="mb-10 text-xl flex-4">
        {data[0].paragraph}
      </p>
    </div>
  </ContainerHeader>
</section>

<script>
  import CarouselManager from "./CarouselManager";

  const mainCarousel = new CarouselManager();
  mainCarousel.initHeroCarousel();
</script>
