---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import ContainerHeader from "@/components/shared/ContainerHeader";
import { getTourImage } from "@/utils";
import {
  HERO_CHIP_ANIMATION_CLASS,
  HERO_CHIP_STAGGER_MS,
  HERO_TAG_CLASSES,
  HERO_TEXT_ANIMATION_CLASS,
  HERO_TEXT_DELAY_MS,
  HERO_TOUR_BUTTON_CLASSES,
} from "./heroContentStyles";
import "./hero.css";

const heroWidths = [640, 960, 1280, 1920, 2560];
const andeanTours = [
  { slug: "/cajas-al-descubierto", name: "Cajas Al Descubierto" },
  { slug: "/joyas-de-los-andes", name: "Joyas de Los Andes" },
  { slug: "/ruta-andina-vip", name: "Ruta Andina VIP" },
];
const data = [
  {
    image: "nevado.jpg",
    altImage: "Paisaje andino ecuatoriano",
    title: "Ecuador",
    subtitle: "Vive lo que otros solo visitan.",
    description: "Somos Condor Expeditions. Descubre Ecuador con experiencias auténticas, paisajes que sorprenden y recuerdos que se quedan contigo.",
    position: "50% 45%",
    portraitPosition: "55% 40%",
    tours: andeanTours,
    tags: ["Naturaleza", "Aventura", "Senderismo", "Fotografía"],
  },
  {
    image: "cajas.jpg",
    altImage: "Parque Nacional El Cajas",
    title: "Parque Nacional",
    subtitle: "El Cajas",
    description: "Entre lagunas y montañas, descubre los senderos de El Cajas. Respira el aire del páramo y vive los Andes a tu propio ritmo.",
    position: "50% 50%",
    portraitPosition: "55% 50%",
    tours: andeanTours,
    tags: ["Naturaleza", "Aventura", "Senderismo", "Fotografía"],
  },
  {
    image: "ingapirca.jpg",
    altImage: "Ruinas de Ingapirca",
    title: "Ruinas de",
    subtitle: "Ingapirca",
    description: "Camina entre vestigios cañaris e incas y conoce las historias que guardan estas piedras. Un encuentro con las raíces ancestrales de Ecuador.",
    position: "50% 50%",
    portraitPosition: "60% 50%",
    tours: [
      { slug: "/joyas-de-los-andes", name: "Joyas de Los Andes" },
      { slug: "/ruta-arqueologica", name: "Ruta Arqueológica" },
    ],
    tags: ["Historia", "Arqueología", "Cultura"],
  },
];
const slides = data.map((slide) => {
  const background = getTourImage(slide.image);
  return { ...slide, background, renderWidth: Math.min(heroWidths[heroWidths.length - 1], background.width) };
});
---

<main>
  <section class="hero" aria-label="Descubre Ecuador">
    <div id="hero-carousel" class="embla" role="region" aria-roledescription="carrusel" aria-label="Destinos destacados">
      <div class="embla__viewport select-none touch-pan-y">
        <div class="embla__container">
          {slides.map((slide, index) => (
            <section class="embla__slide" role="group" aria-roledescription="diapositiva" aria-label={`${index + 1} de ${slides.length}: ${slide.title} ${slide.subtitle}`} aria-hidden={index !== 0 ? "true" : undefined} inert={index !== 0} style={`--hero-position: ${slide.position}; --hero-portrait-position: ${slide.portraitPosition}`}>
              <Image src={slide.background} alt={slide.altImage} layout="full-width" widths={heroWidths} width={slide.renderWidth} quality={80} priority={index === 0} class="hero-image" draggable="false" />
              <div class="hero-shade" aria-hidden="true" />
              <ContainerHeader class="hero-shell">
                <div class="hero-content">
                  <div class="hero-heading">
                    <p class="hero-eyebrow">Condor Expeditions <span aria-hidden="true">/</span> <span class="hero-signature">Ecuador</span></p>
                    <h1 class:list={["hero-title", { "hero-title-intro": index === 0 }]}>
                      <span class={HERO_TEXT_ANIMATION_CLASS} style={`animation-delay: ${HERO_TEXT_DELAY_MS.title}ms`}>{slide.title}</span>
                      <span class={`hero-subtitle ${HERO_TEXT_ANIMATION_CLASS}`} style={`animation-delay: ${HERO_TEXT_DELAY_MS.subtitle}ms`}>{slide.subtitle}</span>
                    </h1>
                  </div>
                  <div class="hero-story">
                    <p class={`hero-description ${HERO_TEXT_ANIMATION_CLASS}`} style={`animation-delay: ${HERO_TEXT_DELAY_MS.paragraph}ms`}>{slide.description}</p>
                    <div class="hero-tags" aria-label="Tipo de experiencia">
                      {slide.tags.map((tag, tagIndex) => (
                        <span class={`${HERO_TAG_CLASSES} ${HERO_CHIP_ANIMATION_CLASS}`} style={`animation-delay: ${tagIndex * HERO_CHIP_STAGGER_MS}ms`}>{tag}</span>
                      ))}
                    </div>
                  </div>
                  <div class="hero-tours">
                    <p class="hero-eyebrow">Explora nuestros tours</p>
                    <div class="hero-tour-list">
                      {slide.tours.map((tour, tourIndex) => (
                        <a href={tour.slug} class={`${HERO_TOUR_BUTTON_CLASSES} ${HERO_CHIP_ANIMATION_CLASS}`} style={`animation-delay: ${tourIndex * HERO_CHIP_STAGGER_MS}ms`}>
                          <span>{tour.name}</span><Icon name="arrow-up-right" aria-hidden="true" />
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              </ContainerHeader>
            </section>
          ))}
        </div>
      </div>
      <ContainerHeader class="hero-navigation-shell">
        <div class="hero-navigation" aria-label="Controles del carrusel">
          <span class="hero-counter" aria-live="polite" aria-atomic="true"><span class="hero-current">01</span><span aria-hidden="true"> / </span><span class="sr-only"> de </span>{String(slides.length).padStart(2, "0")}</span>
          <button type="button" class="embla__prev hero-arrow" aria-label="Destino anterior" aria-controls="hero-carousel"><Icon name="arrow-right" class="rotate-180" aria-hidden="true" /></button>
          <button type="button" class="embla__next hero-arrow" aria-label="Destino siguiente" aria-controls="hero-carousel"><Icon name="arrow-right" aria-hidden="true" /></button>
        </div>
      </ContainerHeader>
    </div>
  </section>
</main>

<script>
  import CarouselManager from "./CarouselManager";
  let mainCarousel: CarouselManager | undefined;
  const initHero = () => {
    mainCarousel?.emblaInstance?.destroy();
    mainCarousel = new CarouselManager();
    mainCarousel.initHeroCarousel();
  };
  initHero();
  document.addEventListener("astro:page-load", initHero);
  document.addEventListener("astro:before-swap", () => mainCarousel?.emblaInstance?.destroy());
</script>
