---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import ContainerHeader from "@/components/shared/ContainerHeader";
import { getTourImage } from "@/utils";
import {
  HERO_CHIP_ANIMATION_CLASS,
  HERO_CHIP_STAGGER_MS,
  HERO_TAG_CLASSES,
  HERO_TEXT_ANIMATION_CLASS,
  HERO_TEXT_DELAY_MS,
  HERO_TOUR_BUTTON_CLASSES,
} from "./heroContentStyles";

const heroWidths = [640, 960, 1280, 1920, 2560];

const data = [
  {
    image: "nevado.jpg",
    altImage: "Paisaje andino ecuatoriano",
    title: "Ecuador:",
    subtitle: " Vive lo que otros solo visitan.",
    colorClass: "text-primary",
    description:
      "Conoce Condor Expeditions, operadora turística enfocada a la experiencia de vivir algo único en nuestro hermoso páis. Crea nuevas experiencias y recuerdos con los tours de Condor Expeditions, no dudes en contactarnos. Cada uno de tus sueños los cumplimos.",
    tours: [],
    tags: [],
  },
  {
    image: "cajas.jpg",
    altImage: "Parque Nacional El Cajas",
    title: "Parque Nacional",
    subtitle: "El Cajas",
    colorClass: "text-secondary",
    description:
      "Una reserva natural protegida, con paisajes montañosos impresionantes. Vive una experiencia única, el clima frío del parque invita a tomar una bebida caliente y estar en movimiento, escalar, caminar por sus senderos te lleva a lugares maravillos que te dejan sin aliento como si de una pelicula se tratara.",
    tours: [
      {
        slug: "/cajas-al-descubierto",
        name: "Cajas Al Descubierto",
      },
      {
        slug: "/joyas-de-los-andes",
        name: "Joyas de Los Andes",
      },
      {
        slug: "/ruta-andina-vip",
        name: "Ruta Andina VIP",
      },
    ],
    tags: ["Naturaleza", "Aventura", "Senderismo", "Fotografía"],
  },
  {
    image: "ingapirca.jpg",
    altImage: "Ruinas de Ingapirca",
    title: "Ruinas de",
    subtitle: "Ingapirca",
    colorClass: "text-primary",
    description:
      "Son ruinas arqueologicas de los incas, que muestras como fue un día hace cientos de años. Nuestro antepasados, conoce este lugar donde vivieron personas en un tiempo tan lejado como un pequeño recuerdo de la vida misma de nuestras raices ancestrales y nuestro pueblos originarios del Ecuador.",
    tours: [
      {
        slug: "/joyas-de-los-andes",
        name: "Joyas de Los Andes",
      },
      {
        slug: "/ruta-arqueologica",
        name: "Ruta Arqueologíca",
      },
    ],
    tags: ["Historia", "Arqueología", "Cultura"],
  },
];

const slides = data.map((slide) => {
  const background = getTourImage(slide.image);
  return {
    ...slide,
    background,
    renderWidth: Math.min(heroWidths[heroWidths.length - 1], background.width),
  };
});
---

<section class="relative min-h-screen w-full overflow-hidden">
  <!-- Carousel Container -->
  <div id="hero-carousel" class="embla absolute inset-0 w-full h-full">
    <div
      class="embla__viewport w-full h-full overflow-hidden select-none touch-pan-y"
    >
      <div class="embla__container flex h-full">
        {
          slides.map((slide, index) => (
            <section class="embla__slide flex-[0_0_100%] min-w-0 relative h-full">
              <Image
                src={slide.background}
                alt={slide.altImage}
                layout="full-width"
                widths={heroWidths}
                width={slide.renderWidth}
                quality={80}
                priority={index === 0}
                class="absolute inset-0 w-full h-full object-cover pointer-events-none"
                draggable="false"
              />
              <div class="absolute inset-0 bg-black/10" />

              <ContainerHeader class="pb-15 absolute inset-0 z-10 pointer-events-none flex">
                <div class="hero-content flex flex-col justify-end text-white gap-8 w-full md:flex-row md:items-end md:gap-5">
                  <div class="md:mb-6 flex-2">
                    <h2 class="text-4xl font-extrabold md:text-6xl">
                      <span
                        id="hero-title"
                        class={`block ${HERO_TEXT_ANIMATION_CLASS}`}
                        style={`animation-delay: ${HERO_TEXT_DELAY_MS.title}ms`}
                      >
                        {slide.title}
                      </span>
                      <span
                        id="hero-subtitle"
                        class={`block ${slide.colorClass} ${HERO_TEXT_ANIMATION_CLASS}`}
                        style={`animation-delay: ${HERO_TEXT_DELAY_MS.subtitle}ms`}
                      >
                        {slide.subtitle}
                      </span>
                    </h2>
                    <div id="hero-tours" class="mt-6 flex flex-col gap-3">
                      <h4 class="text-3xl">Tours:</h4>

                      <div class="flex flex-wrap gap-3">
                        {slide.tours.map((tour, tourIndex) => (
                          <a
                            href={tour.slug}
                            class={`${HERO_TOUR_BUTTON_CLASSES} ${HERO_CHIP_ANIMATION_CLASS}`}
                            style={`animation-delay: ${tourIndex * HERO_CHIP_STAGGER_MS}ms`}
                          >
                            <span>{tour.name}</span>
                            <Icon
                              name="arrow-right"
                              class="size-4 rotate-[-35deg]"
                            />
                          </a>
                        ))}
                      </div>
                    </div>
                  </div>
                  <div class="md:mb-10 flex-4">
                    <p
                      id="hero-paragraph"
                      class={`text-base ${HERO_TEXT_ANIMATION_CLASS}`}
                      style={`animation-delay: ${HERO_TEXT_DELAY_MS.paragraph}ms`}
                    >
                      {slide.description}
                    </p>
                    <div id="hero-tags" class="mt-4 flex flex-wrap gap-2">
                      {(slide.tags ?? []).map((tag, tagIndex) => (
                        <span
                          class={`${HERO_TAG_CLASSES} ${HERO_CHIP_ANIMATION_CLASS}`}
                          style={`animation-delay: ${tagIndex * HERO_CHIP_STAGGER_MS}ms`}
                        >
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              </ContainerHeader>
            </section>
          ))
        }
      </div>
    </div>

    <!-- Navigation Arrows -->
    <button
      type="button"
      class="hidden embla__prev absolute left-4 top-1/2 -translate-y-1/2 z-20 p-3 rounded-full bg-black/30 text-white backdrop-blur-sm transition-all hover:bg-black/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2"
      aria-label="Slide anterior"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m15 18-6-6 6-6"></path>
      </svg>
    </button>
    <button
      type="button"
      class="hidden embla__next absolute right-4 top-1/2 -translate-y-1/2 z-20 p-3 rounded-full bg-black/30 text-white backdrop-blur-sm transition-all hover:bg-black/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2"
      aria-label="Slide siguiente"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </button>

    <!-- Dots Indicators -->
    <!-- <div
      class="embla__dots absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex gap-3"
      role="tablist"
      aria-label="Navegación de slides"
    >
      <button
        type="button"
        class="embla__dot w-3 h-3 rounded-full bg-white/50 transition-all hover:bg-white/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2"
        aria-label="Ir al slide 1"
        aria-selected="true"
        role="tab"
      ></button>
      <button
        type="button"
        class="embla__dot w-3 h-3 rounded-full bg-white/50 transition-all hover:bg-white/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2"
        aria-label="Ir al slide 2"
        aria-selected="false"
        role="tab"
      ></button>
      <button
        type="button"
        class="embla__dot w-3 h-3 rounded-full bg-white/50 transition-all hover:bg-white/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2"
        aria-label="Ir al slide 3"
        aria-selected="false"
        role="tab"
      ></button>
    </div> -->
  </div>
</section>

<script>
  import CarouselManager from "./CarouselManager";

  const mainCarousel = new CarouselManager();
  mainCarousel.initHeroCarousel();
</script>
