---
const data = [
  {
    backgroundUrl: "https://picsum.photos/1920/1080?random=1",
    altImage: "Paisaje andino ecuatoriano",
    title: "Expediciones",
    subtitle: "Inolvidables",
    accentClass: "text-primary",
    paragraph: "Ecuador: Vive lo que otros solo visitan.",
  },
  {
    backgroundUrl: "https://picsum.photos/1920/1080?random=2",
    altImage: "Selva amazónica",
    title: "Aventura en la",
    subtitle: "Amazonía",
    accentClass: "text-secondary",
    paragraph: "Descubre la biodiversidad más impresionante del planeta.",
  },
  {
    backgroundUrl: "https://picsum.photos/1920/1080?random=3",
    altImage: "Costa ecuatoriana",
    title: "Playas",
    subtitle: "Paradisíacas",
    accentClass: "text-primary",
    paragraph: "Sol, arena y mar en cada rincón de la costa.",
  },
];
---

<section class="relative min-h-screen w-full overflow-hidden">
  <!-- Carousel Container -->
  <div id="hero-carousel" class="embla absolute inset-0 w-full h-full">
    <div
      class="embla__viewport w-full h-full overflow-hidden select-none touch-pan-y"
    >
      <div class="embla__container flex h-full">
        {
          data.map((slide, index) => (
            <div class="embla__slide flex-[0_0_100%] min-w-0 relative h-full">
              <img
                src={slide.backgroundUrl}
                alt={slide.altImage}
                class="absolute inset-0 w-full h-full object-cover pointer-events-none"
                loading={index === 0 ? "eager" : "lazy"}
                draggable="false"
              />
              <div class="absolute inset-0 bg-black/40" />
              <div class="relative z-10 h-full flex flex-col items-center justify-center px-4 py-12 text-center text-white">
                <div class="max-w-4xl mx-auto">
                  <h2 class="text-4xl md:text-6xl font-extrabold mb-6">
                    <span class="block">{slide.title}</span>
                    <span class={`block ${slide.accentClass}`}>
                      {slide.subtitle}
                    </span>
                  </h2>
                  <p class="text-xl md:text-2xl mb-10 max-w-2xl mx-auto">
                    {slide.paragraph}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

