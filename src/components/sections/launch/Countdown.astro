---
import { Icon } from "astro-icon/components";
import CondorSymbol from "@/assets/condor-symbol.svg";
import Logo from "@/assets/logo.svg";
import horizontal from "@/assets/pre/horizontal.webp";
import vertical from "@/assets/pre/vertical.webp";
import BaseHead from "@/components/shared/BaseHead";
import { launchConfig } from "@/data/launch.config";
import { siteConfig } from "@/data/site.config";

const date = new Date(launchConfig.launchAt);
const launchDate = new Intl.DateTimeFormat("es-EC", {
	day: "numeric",
	month: "long",
	year: "numeric",
	timeZone: "America/Guayaquil",
}).format(date);
const socials = siteConfig.socials.filter((social) =>
	["instagram", "facebook", "tiktok"].includes(social.icon),
);
const units = [
	{ key: "days", label: "Días" },
	{ key: "hours", label: "Horas" },
	{ key: "minutes", label: "Minutos" },
	{ key: "seconds", label: "Segundos" },
];
---

<html lang="es">
	<BaseHead
		title="Muy pronto · Una nueva aventura"
		description={`Algo nuevo está por llegar a Cuenca. Condor Expeditions despega el ${launchDate} a las 00:00, hora de Ecuador. Naturaleza, cultura y aventuras auténticas.`}
		ogImage={horizontal.src}
		viewTransition={false}
	/>
	<body>
		<div class="launch-page">
			<picture class="landscape" aria-hidden="true">
				<source
					media="(max-width: 767px)"
					srcset={vertical.src}
					type="image/webp"
				/>
				<img
					src={horizontal.src}
					width={horizontal.width}
					height={horizontal.height}
					alt=""
					fetchpriority="high"
					decoding="async"
				/>
			</picture>
			<div class="landscape-shade" aria-hidden="true"></div>

			<header class="launch-header">
				<a
					class="wordmark"
					href="/"
					aria-label="Condor Expeditions, inicio"
					><Logo aria-hidden="true" /></a
				>
				<span class="origin"
					><Icon name="map-pin" size={15} aria-hidden="true" />Cuenca,
					Ecuador</span
				>
			</header>

			<main id="main-content" class="launch-content">
				<div class="symbol"><CondorSymbol aria-hidden="true" /></div>
				<p class="eyebrow"><span></span> UNA NUEVA FORMA DE EXPLORAR</p>
				<h1><span>Muy</span>PRONTO</h1>
				<p class="teaser">Algo nuevo está por llegar a Cuenca...</p>
				<p class="description">
					Hay lugares que no solo se visitan.<br />Se sienten. Se
					exploran. Se viven.
				</p>

				<section
					class="countdown-section"
					aria-labelledby="launch-date"
				>
					<p id="launch-date" class="launch-date">
						<span class="date-line"></span><time
							datetime={launchConfig.launchAt}>{launchDate}</time
						><span class="date-line"></span>
					</p>
					<launch-countdown data-target={launchConfig.launchAt}>
						<div
							class="countdown"
							role="timer"
							aria-live="off"
							aria-label="Tiempo restante para el lanzamiento"
						>
							{
								units.map((unit) => (
									<div class="time-unit">
										<>
											<span
												class="time-value"
												data-unit={unit.key}
											>
												--
											</span>
											<span class="time-label">
												{unit.label}
											</span>
										</>
									</div>
								))
							}
						</div>
						<p
							class="launch-time"
							data-countdown-status
							role="status"
						>
							Despegamos a las 00:00 · Hora de Ecuador (UTC−5)
						</p>
					</launch-countdown>
					<noscript
						><p class="no-script">
							El lanzamiento será el {launchDate} a las 00:00 de Ecuador.
							Activa JavaScript para ver la cuenta atrás en vivo.
						</p></noscript
					>
				</section>

				<div class="launch-actions">
					<a
						class="contact-button"
						href={siteConfig.companyInfo.whatsApp}
						target="_blank"
						rel="noopener noreferrer"
						><Icon
							name="brand-whatsapp"
							size={20}
							aria-hidden="true"
						/>La aventura empieza contigo<Icon
							name="arrow-up-right"
							size={18}
							aria-hidden="true"
						/></a
					>
					<a class="links-button" href="/bio"
						>Conócenos y sigue el lanzamiento<Icon
							name="chevron-right"
							size={14}
							aria-hidden="true"
						/></a
					>
				</div>
			</main>

			<footer class="launch-footer">
				<p>© {new Date().getFullYear()} Condor Expeditions</p>
				<p class="footer-motto">
					Ecuador. Vive lo que otros solo visitan.
				</p>
				<nav aria-label="Síguenos en redes sociales">
					{
						socials.map((social) => (
							<a
								href={social.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={social.name}
							>
								<Icon
									name={`brand-${social.icon}`}
									size={19}
									aria-hidden="true"
								/>
							</a>
						))
					}
				</nav>
			</footer>
		</div>
	</body>
</html>

<script>
	import { getCountdownParts } from "../../../utils/countdown";

	class LaunchCountdown extends HTMLElement {
		private interval: ReturnType<typeof setInterval> | undefined;

		connectedCallback() {
			const target = Date.parse(this.dataset.target ?? "");
			if (!Number.isFinite(target)) return;

			const fields = this.querySelectorAll<HTMLElement>("[data-unit]");
			const status = this.querySelector<HTMLElement>(
				"[data-countdown-status]",
			);
			const update = () => {
				const parts = getCountdownParts(target, Date.now());
				for (const field of fields) {
					const unit = field.dataset.unit as
						"days" | "hours" | "minutes" | "seconds";
					field.textContent = String(parts[unit]).padStart(2, "0");
				}
				if (parts.expired) {
					if (status)
						status.textContent =
							"La espera ha terminado. ¡Es hora de vivir la aventura!";
					clearInterval(this.interval);
				}
				return parts.expired;
			};
			if (!update()) this.interval = setInterval(update, 1000);
		}

		disconnectedCallback() {
			clearInterval(this.interval);
		}
	}

	if (!customElements.get("launch-countdown")) {
		customElements.define("launch-countdown", LaunchCountdown);
	}
</script>

<style>
	:global(body) {
		margin: 0;
		background: #162522;
		color: #fff;
	}
	.launch-page {
		position: relative;
		isolation: isolate;
		min-height: 100svh;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}
	.landscape,
	.landscape-shade {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
	}
	.landscape {
		overflow: hidden;
	}
	.landscape img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 56%;
		transform: scale(1.025);
		filter: blur(2px);
	}
	.landscape-shade {
		background: linear-gradient(
			180deg,
			#10232365 0%,
			#0e202170 18%,
			#0c1d20b8 55%,
			#0c191bd9 100%
		);
	}
	.launch-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		padding: 28px 4.5%;
	}
	.wordmark {
		display: block;
		width: 155px;
	}
	.wordmark :global(svg) {
		width: 100%;
		height: auto;
		filter: brightness(0) invert(1);
	}
	.origin {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 11px;
		letter-spacing: 1px;
	}
	.launch-content {
		flex: 1;
		width: min(100% - 40px, 860px);
		margin: 0 auto;
		padding: 12px 0 36px;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}
	.symbol {
		width: clamp(110px, 11vw, 152px);
		margin-bottom: 26px;
	}
	.symbol :global(svg) {
		width: 100%;
		height: auto;
	}
	.eyebrow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		margin: 0 0 18px;
		font-size: 10px;
		font-weight: 500;
		letter-spacing: 3px;
		color: var(--color-blanco);
	}
	.eyebrow > span {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--color-blanco);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-blanco) 9%, transparent);
	}
	h1 {
		font-family: "Red Hat Text", sans-serif;
		font-size: clamp(70px, 12vw, 142px);
		line-height: 0.88;
		font-weight: 800;
		letter-spacing: -0.065em;
		margin: 0;
	}
	h1 > span {
		display: block;
		font-size: clamp(27px, 3.2vw, 39px);
		line-height: 1.3;
		font-weight: 400;
		font-style: italic;
		text-transform: uppercase;
		letter-spacing: 0.09em;
		margin-bottom: 5px;
	}
	.teaser {
		margin: 25px 0 0;
		padding: 7px 23px 9px;
		border: 1px solid #84bed3b3;
		border-radius: 100px;
		font-size: clamp(14px, 2vw, 19px);
		font-weight: 400;
		font-style: italic;
		line-height: 1.5;
		background: #16343d25;
	}
	.description {
		margin: 16px 0 0;
		font-size: 13px;
		line-height: 1.7;
		color: #e1e6e2;
	}
	.countdown-section {
		width: min(100%, 482px);
		margin-top: 28px;
	}
	.launch-date {
		display: flex;
		align-items: center;
		gap: 17px;
		justify-content: center;
		margin: 0 0 19px;
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 2.4px;
		color: var(--color-blanco);
	}
	.date-line {
		height: 1px;
		width: 40px;
		background: color-mix(in srgb, var(--color-blanco) 33%, transparent);
	}
	launch-countdown {
		display: block;
	}
	.countdown {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 16px;
	}
	.time-unit {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 9px;
		padding: 0 0 16px;
		border-bottom: 1px solid #ffffff40;
	}
	.time-unit:not(:last-child)::after {
		content: ":";
		position: absolute;
		top: 7px;
		right: -11px;
		font-size: 28px;
		font-weight: 300;
		color: #e6e9dd80;
	}
	.time-value {
		font-size: clamp(38px, 5vw, 54px);
		line-height: 1.1;
		font-weight: 400;
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.03em;
	}
	.time-label {
		font-size: 9px;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: #e1e6e2;
	}
	.launch-time,
	.no-script {
		margin: 13px 0 0;
		font-size: 10px;
		letter-spacing: 0.4px;
		line-height: 1.6;
		color: #d5ded9;
	}
	.launch-actions {
		margin-top: 25px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 15px;
	}
	.contact-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
		padding: 14px 21px;
		border-radius: 6px;
		background: var(--color-blanco);
		color: #243b34;
		font-size: 12px;
		font-weight: 600;
		text-decoration: none;
		transition:
			background 0.2s,
			transform 0.2s;
	}
	.contact-button:hover {
		background: #fff;
		transform: translateY(-2px);
	}
	.links-button {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		min-height: 28px;
		font-size: 11px;
		color: #e1e6e2;
		text-decoration: underline;
		text-underline-offset: 5px;
		text-decoration-color: #ffffff50;
	}
	.links-button:hover {
		color: #fff;
		text-decoration-color: #fff;
	}
	.launch-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		margin: 0 4.5%;
		padding: 17px 0 20px;
		border-top: 1px solid #ffffff26;
	}
	.launch-footer p {
		margin: 0;
		font-size: 10px;
		color: #d5ded9;
		letter-spacing: 0.3px;
	}
	.launch-footer .footer-motto {
		font-style: italic;
	}
	.launch-footer nav {
		display: flex;
		gap: 10px;
	}
	.launch-footer nav a {
		width: 36px;
		height: 36px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #e1e6e2;
		border: 1px solid #ffffff30;
		border-radius: 50%;
		transition: background 0.2s;
	}
	.launch-footer nav a:hover {
		background: #ffffff20;
	}
	a:focus-visible {
		outline: 2px solid var(--color-blanco);
		outline-offset: 5px;
	}
	@media (prefers-reduced-motion: no-preference) {
		.launch-content {
			animation: reveal 1s ease-out both;
		}
		.landscape img {
			animation: landscape-in 1.8s ease-out both;
		}
		@keyframes reveal {
			from {
				opacity: 0;
				transform: translateY(14px);
			}
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}
		@keyframes landscape-in {
			from {
				opacity: 0;
			}
			to {
				opacity: 1;
			}
		}
	}
	@media (max-width: 767px) {
		.launch-header {
			padding: 23px 23px 20px;
		}
		.wordmark {
			width: 125px;
		}
		.origin {
			font-size: 9px;
			letter-spacing: 0.3px;
			gap: 5px;
		}
		.launch-content {
			padding: 22px 0 30px;
		}
		.symbol {
			width: 118px;
			margin-bottom: 23px;
		}
		.eyebrow {
			font-size: 8px;
			letter-spacing: 2px;
			margin-bottom: 20px;
		}
		.teaser {
			padding: 6px 15px 8px;
			margin-top: 22px;
		}
		.countdown-section {
			max-width: 370px;
			margin-top: 27px;
		}
		.launch-date {
			font-size: 9px;
			letter-spacing: 1.6px;
			gap: 12px;
		}
		.countdown {
			gap: 12px;
		}
		.time-unit:not(:last-child)::after {
			right: -8px;
			top: 3px;
			font-size: 25px;
		}
		.time-label {
			font-size: 8px;
			letter-spacing: 1.2px;
		}
		.launch-time {
			font-size: 9px;
		}
		.launch-footer {
			margin: 0 23px;
			padding: 15px 0 20px;
			gap: 10px;
		}
		.launch-footer p {
			font-size: 9px;
			max-width: 150px;
			line-height: 1.6;
		}
		.launch-footer .footer-motto {
			display: none;
		}
		.launch-footer nav {
			gap: 7px;
		}
		.landscape img {
			object-position: center;
		}
		.landscape-shade {
			background: linear-gradient(
				180deg,
				#10232370,
				#0c1d20b3 35%,
				#0c191bd9
			);
		}
	}
	@media (max-width: 360px) {
		.launch-content {
			width: calc(100% - 32px);
		}
		.teaser {
			font-size: 12px;
		}
		.origin {
			font-size: 8px;
		}
	}
</style>
