---
import { differentiators } from "@/data/content";
---

<section id="por-que-nosotros" class="section-padding bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-accent font-display text-sm uppercase tracking-widest">Nuestra Diferencia</span>
      <h2 class="font-display text-3xl md:text-5xl mt-3 mb-4 text-foreground">
        ¿Por qué Cóndor Expeditions?
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {
        differentiators.map((d) => (
          <div class="text-center group">
            <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-primary-50 flex items-center justify-center text-2xl group-hover:bg-primary/10 transition-colors">
              {d.icon}
            </div>
            <h3 class="font-display text-lg font-bold text-foreground mb-2">{d.title}</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">{d.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>