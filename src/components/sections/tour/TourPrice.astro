---
import type { Tour } from "@/data/tours/types";
interface Props { price: Tour["price"]; compact?: boolean; }
const { price, compact = false } = Astro.props;
---
<div class:list={["tour-price", { "tour-price-compact": compact }]}>
	{price.kind === "free" ? <>
		<strong>Gratis</strong>
		<small>Aporte voluntario al finalizar</small>
	</> : price.kind === "pending" ? <><strong>Por confirmar</strong><small>Propuesta en preparación</small></> : <>
		<span class="price-from">Desde</span>
		<div><strong>${price.adult.toLocaleString("es-EC")}</strong><span class="price-currency">USD <span>/ persona</span></span></div>
	</>}
</div>
