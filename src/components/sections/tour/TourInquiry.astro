---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/data/site.config";
import type { Tour } from "@/data/tours/types";
import TourPrice from "./TourPrice.astro";
interface Props { tour: Tour; }
const { tour } = Astro.props;
const isPaid = tour.price.kind === "paid";
const adultPrice = isPaid ? tour.price.adult : 0;
const seniorPrice = isPaid ? Math.max(0, tour.price.adult - 5) : 0;
const childPrice = isPaid ? Math.max(0, tour.price.adult - 5) : 0;
const babyPrice = 0;
const message = tour.provisional
	? `Hola, quisiera conocer los avances de la propuesta ${tour.title} (${tour.id}). Entiendo que todavía está en preparación.`
	: `Hola, quisiera consultar una salida para ${tour.title} (${tour.id}). ¿Me ayudan con disponibilidad y detalles?`;
const contact = new URL(siteConfig.companyInfo.whatsApp);
contact.searchParams.set("text", message);
---

<aside id="consultar" class="tour-inquiry" aria-labelledby="inquiry-title"
	data-tour-title={tour.title}
	data-tour-id={tour.id}
	data-operating-days={JSON.stringify(tour.operatingDays)}
	data-price-kind={tour.price.kind}
	data-adult-price={adultPrice}
	data-senior-price={seniorPrice}
	data-kid-price={childPrice}
	data-baby-price={babyPrice}
>
	<div class="inquiry-top"><span class="tour-eyebrow">Tu próxima experiencia</span><Icon name="asterisk" aria-hidden="true" /></div>
	<h2 id="inquiry-title" class="sr-only">{tour.provisional ? "Consulta esta propuesta" : "Consulta una salida"}</h2>
	<TourPrice price={tour.price} />
	<div class="inquiry-divider"></div>
	{!tour.provisional && <form class="inquiry-form" action={contact.origin + contact.pathname} method="get" target="_blank" hidden>
		<input type="hidden" name="text" value={message} />
		<div class="inquiry-field date-picker-box" id="date-picker-box">
			<label class="sr-only" for="tour-date">¿Cuándo te gustaría ir?</label>
			<input id="tour-date" type="date" required aria-describedby="date-help" class="sr-only" tabindex="-1" />
			<button type="button" class="date-picker-trigger" id="date-picker-trigger" aria-expanded="false" aria-controls="tour-calendar-panel">
				<span class="date-trigger-eyebrow">Selecciona una fecha</span>
				<span class="date-trigger-row">
					<Icon name="calendar" aria-hidden="true" class="date-trigger-icon" />
					<span id="date-trigger-label" class="date-trigger-value">Seleccionar fecha</span>
					<Icon name="chevron-right" aria-hidden="true" class="date-trigger-chevron" />
				</span>
			</button>
			<div class="date-picker-panel" id="tour-calendar-panel" hidden>
				<div class="calendar-header">
					<button type="button" class="calendar-nav-btn is-prev" id="calendar-prev" aria-label="Mes anterior">
						<Icon name="chevron-right" aria-hidden="true" />
					</button>
					<strong id="calendar-month-label" class="calendar-month-title"></strong>
					<button type="button" class="calendar-nav-btn is-next" id="calendar-next" aria-label="Mes siguiente">
						<Icon name="chevron-right" aria-hidden="true" />
					</button>
				</div>
				<div class="calendar-weekdays" aria-hidden="true">
					<span>LU</span><span>MA</span><span>MI</span><span>JU</span><span>VI</span><span>SÁ</span><span>DO</span>
				</div>
				<div class="calendar-days-grid" id="calendar-days-grid" role="grid" aria-label="Calendario de disponibilidad"></div>
				<div class="calendar-legend" aria-hidden="true">
					<span class="legend-item"><i class="legend-swatch is-selected"></i> Seleccionado</span>
					<span class="legend-item"><i class="legend-swatch is-today"></i> Hoy</span>
					<span class="legend-item"><i class="legend-swatch is-unavailable">—</i> No disponible</span>
				</div>
			</div>
		</div>
		<p id="date-help" class="field-help">{tour.operation}. Sujeto a confirmación.</p>
		<div class="inquiry-field passengers-picker-box" id="passengers-picker-box">
			<label class="sr-only" for="tour-adults">Selecciona pasajeros</label>
			<button type="button" class="passengers-picker-trigger" id="passengers-picker-trigger" aria-expanded="false" aria-controls="tour-passengers-panel">
				<span class="passengers-trigger-eyebrow">Selecciona viajeros</span>
				<span class="passengers-trigger-row">
					<Icon name="users" aria-hidden="true" class="passengers-trigger-icon" />
					<span id="passengers-trigger-label" class="passengers-trigger-value">1 Adulto</span>
					<Icon name="chevron-right" aria-hidden="true" class="passengers-trigger-chevron" />
				</span>
			</button>
			<div class="passengers-picker-panel" id="tour-passengers-panel" hidden>
				<div class="passenger-row">
					<div class="passenger-info">
						<strong class="passenger-type">{isPaid ? "Adultos" : "Personas"}</strong>
						<span class="passenger-sub">{isPaid ? "De 11 a 64 años" : "General"}</span>
						<span class="passenger-fare">{isPaid ? `$${adultPrice} USD` : "Gratis"}</span>
					</div>
					<div class="stepper-control">
						<button type="button" class="stepper-btn" data-step-target="tour-adults" data-step-dir="-1" aria-label="Reducir adultos">−</button>
						<input id="tour-adults" type="number" min="0" max="100" value="1" required class="stepper-input" />
						<button type="button" class="stepper-btn" data-step-target="tour-adults" data-step-dir="1" aria-label="Aumentar adultos">+</button>
					</div>
				</div>

				{isPaid && <>
					<div class="passenger-row">
						<div class="passenger-info">
							<strong class="passenger-type">Tercera edad</strong>
							<span class="passenger-sub">65 años o más</span>
							<span class="passenger-fare">${seniorPrice} USD <span class="discount-badge">-$5</span></span>
						</div>
						<div class="stepper-control">
							<button type="button" class="stepper-btn" data-step-target="tour-seniors" data-step-dir="-1" aria-label="Reducir tercera edad">−</button>
							<input id="tour-seniors" type="number" min="0" max="100" value="0" class="stepper-input" />
							<button type="button" class="stepper-btn" data-step-target="tour-seniors" data-step-dir="1" aria-label="Aumentar tercera edad">+</button>
						</div>
					</div>

					<div class="passenger-row">
						<div class="passenger-info">
							<strong class="passenger-type">Niños</strong>
							<span class="passenger-sub">De 3 a 10 años</span>
							<span class="passenger-fare">${childPrice} USD <span class="discount-badge">-$5</span></span>
						</div>
						<div class="stepper-control">
							<button type="button" class="stepper-btn" data-step-target="tour-children" data-step-dir="-1" aria-label="Reducir niños">−</button>
							<input id="tour-children" type="number" min="0" max="20" value="0" class="stepper-input" />
							<button type="button" class="stepper-btn" data-step-target="tour-children" data-step-dir="1" aria-label="Aumentar niños">+</button>
						</div>
					</div>

					<div class="passenger-row">
						<div class="passenger-info">
							<strong class="passenger-type">Bebés</strong>
							<span class="passenger-sub">De 0 a 2 años · En brazos</span>
							<span class="passenger-fare passenger-free">Gratis</span>
						</div>
						<div class="stepper-control">
							<button type="button" class="stepper-btn" data-step-target="tour-babies" data-step-dir="-1" aria-label="Reducir bebés">−</button>
							<input id="tour-babies" type="number" min="0" max="10" value="0" class="stepper-input" />
							<button type="button" class="stepper-btn" data-step-target="tour-babies" data-step-dir="1" aria-label="Aumentar bebés">+</button>
						</div>
					</div>
				</>}
				<div class="passengers-panel-footer">
					{isPaid && (
						<div class="passengers-panel-total">
							<span>Total:</span>
							<strong id="passengers-panel-total-amount">${adultPrice} USD</strong>
						</div>
					)}
					<button type="button" class="passengers-done-btn" id="passengers-done-btn">Listo</button>
				</div>
			</div>
		</div>
		<div id="large-group-warning" class="large-group-warning" hidden>
			<p><strong>Aviso para grupos grandes:</strong> Para más de 44 personas se coordina transporte múltiple o bus interprovincial privado.</p>
			<label class="confirm-checkbox-label">
				<input type="checkbox" id="confirm-large-group" /> Confirmo que solicito cotización para más de 44 pasajeros.
			</label>
		</div>
		{isPaid && (
			<p class="field-help">Bebés (0–2 años) viajan gratis en brazos. De 3 a 10 años y adultos mayores disfrutan de $5 de descuento por persona.</p>
		)}
		<div class="inquiry-field">
			<span class="field-label">Horario de salida</span>
			<select id="tour-departure" class="sr-only" tabindex="-1" aria-hidden="true">{tour.departures.map(departure => <option>{departure}</option>)}<option value="Horario personalizado">Horario personalizado</option></select>
			<div class="departure-toggles" role="radiogroup" aria-label="Horario de salida">
				{tour.departures.map((departure, i) => (
					<button type="button" class:list={["departure-toggle-btn", { active: i === 0 }]} data-departure={departure} role="radio" aria-checked={i === 0 ? "true" : "false"}>{departure}</button>
				))}
				<button type="button" class="departure-toggle-btn departure-custom-btn" data-departure="Horario personalizado" role="radio" aria-checked="false" hidden>Horario personalizado</button>
			</div>
		</div>
		<p id="departure-help" class="field-help">Horario sujeto a confirmación de disponibilidad con el equipo.</p>
		{isPaid && (
			<div class="inquiry-price-summary" id="inquiry-price-summary">
				<div class="summary-breakdown" id="summary-breakdown"></div>
				<div class="summary-total-row">
					<span class="summary-total-label">Total estimado</span>
					<strong class="summary-total-amount" id="summary-total-amount">$0 USD</strong>
				</div>
			</div>
		)}
		<button type="submit" class="tour-button inquiry-submit"><Icon name="brand-whatsapp" aria-hidden="true" />Consultar salida<Icon name="arrow-up-right" aria-hidden="true" /></button>
	</form>}
	<a class="tour-button inquiry-fallback" href={contact.href} target="_blank" rel="noopener noreferrer"><Icon name="brand-whatsapp" aria-hidden="true" />Consultar por WhatsApp<Icon name="arrow-up-right" aria-hidden="true" /></a>
	<p class="inquiry-disclaimer">Sin cobros en esta página. Coordinamos disponibilidad, tarifa y detalles contigo por WhatsApp.</p>
	<a class="tour-policy-link" href="#politicas">Reservas, cambios y cancelaciones</a>
	<div class="inquiry-bottom"><Icon name="world" aria-hidden="true" /><span>Equipo local en Cuenca<br /><strong>Te acompañamos desde el primer mensaje.</strong></span></div>
</aside>
