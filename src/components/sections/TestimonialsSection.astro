---
import { testimonials } from "@/data/content";
---

<section id="testimonios" class="section-padding bg-dark text-dark-foreground">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-primary-300 font-display text-sm uppercase tracking-widest">Testimonios</span>
      <h2 class="font-display text-3xl md:text-5xl mt-3 mb-4 text-white">
        Lo que Dicen Nuestros Viajeros
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        testimonials.map((t) => (
          <div class="bg-dark-muted rounded-xl p-6 flex flex-col">
            <div class="flex text-amber-400 text-sm mb-3" aria-label={`${t.stars} de 5 estrellas`}>
              {Array.from({ length: t.stars }).map((_, i) => (
                <span key={i}>★</span>
              ))}
            </div>
            <p class="text-dark-foreground/80 text-sm leading-relaxed mb-6 flex-1 italic">
              &ldquo;{t.text}&rdquo;
            </p>
            <div class="border-t border-white/10 pt-4">
              <p class="font-display font-bold text-white text-sm">{t.name}</p>
              <p class="text-xs text-primary-300">{t.city}, {t.country}</p>
              <p class="text-xs text-dark-foreground/50 mt-1">Expedición: {t.expedition}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>