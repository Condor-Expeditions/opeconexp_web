---
import { getTours, getCategories, resolveText, resolveLabel } from "../../data/helpers";

const lang = Astro.url.pathname.startsWith("/en/") ? "en" : "es";
const categoryLabels = new Map(getCategories().map((c) => [c.id, resolveLabel(c, lang, "es")]));

const featuredDestinations = getTours()
  .slice(0, 4)
  .map((dest) => ({
    slug: dest.slug,
    name: resolveText(dest.title, lang, "es"),
    tag: dest.categories[0] ? categoryLabels.get(dest.categories[0]) ?? dest.categories[0] : "Expedición",
    description: resolveText(dest.description, lang, "es"),
  }));
---

<section id="destinos-destacados" class="section-padding bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-accent font-display text-sm uppercase tracking-widest">Explora</span>
      <h2 class="font-display text-3xl md:text-5xl mt-3 mb-4 text-foreground">
        Destinos que Inspiran
      </h2>
      <p class="text-muted-foreground text-lg leading-relaxed">
        Desde las cumbres andinas hasta las profundidades de la Amazonía. Cuatro mundos, una sola expedición.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        featuredDestinations.map((dest) => (
          <a href={`/destinos#${dest.slug}`} class="group block">
            <div class="relative overflow-hidden rounded-xl aspect-[4/5] bg-muted">
              <div class="absolute inset-0 bg-gradient-to-t from-dark/70 via-dark/20 to-transparent z-10" />
              <div class="absolute inset-0 bg-dark/20 group-hover:bg-dark/0 transition-colors duration-500 z-10" />
              <!-- Placeholder visual -->
              <div class="w-full h-full bg-gradient-to-br from-primary-200 to-primary-600 flex items-center justify-center">
                <span class="font-display text-8xl text-white/20">{dest.name.charAt(0)}</span>
              </div>
              {/* <img src={dest.image} alt={dest.alt} class="w-full h-full function-object cover group-hover:scale-105 transition-transform duration-700" /> */}
              <!-- Content overlay -->
              <div class="absolute bottom-0 left-0 right-0 p-5 z-20">
                <span class="inline-block px-3 py-1 bg-accent text-white text-xs font-semibold rounded-full mb-2 tracking-wider uppercase">
                  {dest.tag}
                </span>
                <h3 class="font-display text-xl font-bold text-white mb-1">{dest.name}</h3>
                <p class="text-white/80 text-sm">{dest.description}</p>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>