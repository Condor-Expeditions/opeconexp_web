---
import Container from "../shared/Container.astro";
import Button from "../ui/Button.astro";
import Badge from "../ui/Badge.astro";
import { type Destination } from "../../data/destinations";
import { getTours, getCategoryTitle, getDifficultyLevel, resolveLabel } from "../../data/helpers";

export interface Props {
	destination: Destination;
	lang?: "es" | "en";
}

const { destination, lang = "es" } = Astro.props;
const isEnglish = lang === "en";

const allTours = getTours();

// Buscar tours relacionados por categoría de destino
const destCategory = destination.category.toLowerCase();
const relatedTours = allTours
	.filter((t) => {
    const categoryTitles = t.categories.map((c) => getCategoryTitle(c, lang).toLowerCase());
    const destName = destination.name.toLowerCase();
    const titleEs = resolveLabel(t.title, lang).toLowerCase();
    return categoryTitles.some((cat) => cat.includes(destCategory.split(",")[0].trim())) || titleEs.includes(destName);
  })
	.slice(0, 3);

const reserveLabel = isEnglish ? "Book a Tour" : "Reservar un tour";
const contactHref = isEnglish ? "/en/contacto" : "/contacto";

const labels = {
	highlights: isEnglish ? "Highlights" : "Destacados",
	coordinates: isEnglish ? "Coordinates" : "Coordenadas",
	bestTime: isEnglish ? "Best time to visit" : "Mejor época para visitar",
	difficulty: isEnglish ? "Difficulty" : "Dificultad",
	relatedTours: isEnglish ? "Related Tours" : "Tours Relacionados",
};
---

<article>
	<!-- Hero -->
	<section class="relative min-h-[60vh] md:min-h-[70vh] flex items-end overflow-hidden">
		<img
			src={destination.heroImage || destination.image || "/assets/menu/tours/mira-cuenca.jpg"}
			alt={destination.name}
			class="absolute inset-0 w-full h-full object-cover"
		/>
		<div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
		<Container>
			<div class="relative z-10 pb-12 md:pb-16 pt-32">
				<Badge variant="secondary" size="lg" class="mb-4">{destination.category}</Badge>
				<h1 class="font-display text-4xl md:text-6xl lg:text-7xl text-white mb-4 max-w-4xl">
					{destination.name}
				</h1>
				<p class="text-lg md:text-xl text-white/80 max-w-2xl">{destination.shortDescription}</p>
			</div>
		</Container>
	</section>

	<!-- Content -->
	<section class="section-padding bg-background">
		<Container>
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-12">
				<!-- Main Content -->
				<div class="lg:col-span-2 space-y-10">
					<div>
						<h2 class="text-2xl font-semibold text-foreground mb-4">
							{isEnglish ? "About this destination" : "Sobre este destino"}
						</h2>
						<p class="text-base text-muted-foreground leading-relaxed">{destination.longDescription}</p>
					</div>

					<div>
						<h2 class="text-xl font-semibold text-foreground mb-3">{labels.highlights}</h2>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
							{destination.highlights.map((h) => (
								<div class="flex items-start gap-3 p-3 rounded-lg bg-crema border border-border">
									<svg class="w-5 h-5 mt-0.5 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<polyline points="20 6 9 17 4 12"/>
									</svg>
									<span class="text-sm text-foreground">{h}</span>
								</div>
							))}
							</div>
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
							{destination.coordinates && (
								<div class="p-4 rounded-xl bg-white border border-border">
									<p class="text-xs text-muted uppercase tracking-wide mb-1">{labels.coordinates}</p>
									<p class="text-sm font-mono text-foreground">{destination.coordinates}</p>
								</div>
							)}
							{destination.bestTime && (
								<div class="p-4 rounded-xl bg-white border border-border">
									<p class="text-xs text-muted uppercase tracking-wide mb-1">{labels.bestTime}</p>
									<p class="text-sm font-medium text-foreground">{destination.bestTime}</p>
								</div>
							)}
							{destination.difficulty && (
								<div class="p-4 rounded-xl bg-white border border-border">
									<p class="text-xs text-muted uppercase tracking-wide mb-1">{labels.difficulty}</p>
									<p class="text-sm font-medium text-foreground">{destination.difficulty}</p>
								</div>
							)}
						</div>
					</div>

					<!-- Sidebar -->
					<div class="lg:col-span-1">
						<div class="sticky top-24">
							<div class="p-6 rounded-xl bg-crema border border-border">
								<h3 class="text-lg font-semibold text-foreground mb-4">
									{isEnglish ? "Plan your visit" : "Planifica tu visita"}
								</h3>
								<Button variant="primary" size="lg" fullWidth href={contactHref}>
									{reserveLabel}
								</Button>
							</div>
						</div>
					</div>
				</div>
			</Container>
		</section>

		<!-- Related Tours -->
			{relatedTours.length > 0 && (
				<section class="section-padding-sm bg-crema">
					<Container>
						<h2 class="text-2xl font-semibold text-foreground mb-8">{labels.relatedTours}</h2>
						<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
							{relatedTours.map((tour) => (
								<a
								href={isEnglish ? `/en/tours/${tour.slug}` : `/tours/${tour.slug}`}
								class="group block bg-white rounded-xl overflow-hidden border border-border hover-lift img-zoom"
							>
								<div class="aspect-[4/3] overflow-hidden">
									<img
									src={tour.gallery?.[0]?.src || "/assets/menu/tours/mira-cuenca.jpg"}
									alt={resolveLabel(tour.title, lang)}
									class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
									loading="lazy"
								/>
							</div>
								<div class="p-4">
									<h3 class="font-semibold text-foreground group-hover:text-primary-red transition-colors">{resolveLabel(tour.title, lang)}</h3>
									<p class="text-xs text-muted mt-1">{tour.duration} · ${tour.prices[0]?.amount || 0}</p>
								</div>
							</a>
						))}
						</div>
					</Container>
				</section>
			)}
		</article>
