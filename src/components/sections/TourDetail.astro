---
import Container from "@/components/shared/Container.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import { getTourData, getReviews, getValidImageUrl, resolveLabel } from "@/data/helpers";
import type { Tour, Review } from "@/data/types";

export interface Props {
  tour: Tour;
  lang?: "es" | "en";
}

const { tour, lang = "es" } = Astro.props;
const isEnglish = lang === "en";

// Convertir tour API-local → legacy compat
const t = getTourData(tour, lang);
const reserveLabel = isEnglish ? "Book This Tour" : "Reservar este tour";
const contactHref = isEnglish ? "/en/contacto" : "/contacto";

const infoLabels = {
  duration: isEnglish ? "Duration" : "Duración",
  days: isEnglish ? "Days" : "Días",
  capacity: isEnglish ? "Capacity" : "Capacidad",
  difficulty: isEnglish ? "Difficulty" : "Dificultad",
  includes: isEnglish ? "Includes" : "Incluye",
  excludes: isEnglish ? "Not included" : "No incluye",
  whatToBring: isEnglish ? "What to bring" : "Qué llevar",
  itinerary: isEnglish ? "Itinerary" : "Itinerario",
  activities: isEnglish ? "Activities" : "Actividades",
  meetingPoints: isEnglish ? "Meeting points" : "Puntos de encuentro",
  pricing: isEnglish ? "Pricing" : "Precios",
  general: isEnglish ? "General" : "General",
  special: isEnglish ? "Special" : "Especial",
  reviews: isEnglish ? "Reviews" : "Reseñas",
  verified: isEnglish ? "Verified" : "Verificado",
};

// Obtener reviews del API-local
const allReviews: Review[] = getReviews();
const tourReviews = allReviews.filter((r) => r.tourId === tour.id);
---

<article>
  <!-- Hero -->
  <section class="relative min-h-[60vh] md:min-h-[70vh] flex items-end overflow-hidden">
    <img
      src={t.image}
      alt={t.name}
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
    <Container>
      <div class="relative z-10 pb-12 md:pb-16 pt-32">
        {t.badge && (
          <Badge variant="primary" size="lg" class="mb-4">{t.badge}</Badge>
        )}
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-white mb-4 max-w-4xl">
          {t.name}
        </h1>
        <p class="text-lg md:text-xl text-white/80 max-w-2xl">{t.shortDescription}</p>
      </div>
    </Container>
  </section>

  <!-- Quick Info Pills -->
  <section class="bg-negro text-white py-6">
    <Container>
      <div class="flex flex-wrap gap-4 md:gap-8">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary-red" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <span class="text-sm"><strong>{infoLabels.duration}:</strong> {t.operational.duration}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary-red" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          <span class="text-sm"><strong>{infoLabels.days}:</strong> {t.operational.days}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary-red" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          <span class="text-sm"><strong>{infoLabels.capacity}:</strong> {t.operational.capacity}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary-red" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
          <span class="text-sm"><strong>{infoLabels.difficulty}:</strong> {t.operational.difficulty}</span>
        </div>
      </div>
    </Container>
  </section>

  <!-- Content -->
  <section class="section-padding bg-background">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-12">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-10">
          <!-- Meeting Points -->
          <div>
            <h2 class="text-xl font-semibold text-foreground mb-3">{infoLabels.meetingPoints}</h2>
            <ul class="space-y-2">
              {t.meetingPoints.map((point) => (
                <li class="flex items-start gap-2 text-sm text-muted-foreground">
                  <svg class="w-4 h-4 mt-0.5 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                  {point}
                </li>
              ))}
            </ul>
          </div>

          <!-- Itinerary -->
          <div>
            <h2 class="text-xl font-semibold text-foreground mb-3">{infoLabels.itinerary}</h2>
            <div class="space-y-3">
              {t.itinerario.map((item, i) => (
                <div class="flex gap-4">
                  <div class="flex flex-col items-center">
                    <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-xs font-bold text-primary shrink-0">
                      {i + 1}
                    </div>
                    {i < t.itinerario.length - 1 && (
                      <div class="w-px flex-1 bg-border mt-1"></div>
                    )}
                  </div>
                  <p class="text-sm text-muted-foreground leading-relaxed pt-1.5">{item}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- Includes / Excludes -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <h2 class="text-xl font-semibold text-foreground mb-3">{infoLabels.includes}</h2>
              <ul class="space-y-2">
                {t.includes.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-muted-foreground">
                    <svg class="w-4 h-4 mt-0.5 text-success shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h2 class="text-xl font-semibold text-foreground mb-3">{infoLabels.excludes}</h2>
              <ul class="space-y-2">
                {t.excludes.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-muted-foreground">
                    <svg class="w-4 h-4 mt-0.5 text-destructive shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="18" y1="6" x2="6" y2="18"/>
                      <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>

          {/* What to Bring */}
          <div>
            <h2 class="text-xl font-semibold text-foreground mb-3">{infoLabels.whatToBring}</h2>
            <ul class="space-y-2">
              {t.whatToBring.map((item) => (
                <li class="flex items-start gap-2 text-sm text-muted-foreground">
                  <svg class="w-4 h-4 mt-0.5 text-secondary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>

        {/* Sidebar */}
        <div class="lg:col-span-1">
          <div class="sticky top-24 space-y-6">
            {/* Pricing Card */}
            <div class="p-6 rounded-xl bg-crema border border-border">
              <h3 class="text-lg font-semibold text-foreground mb-4">{infoLabels.pricing}</h3>
              <div class="space-y-3 mb-6">
                <div class="flex items-center justify-between">
                  <span class="text-sm text-muted">{infoLabels.general}</span>
                  <span class="text-lg font-bold text-foreground">{t.pricing.general}</span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-sm text-muted">{infoLabels.special}</span>
                  <span class="text-lg font-bold text-primary">{t.pricing.special}</span>
                </div>
              </div>
              <Button variant="primary" size="lg" fullWidth href={contactHref}>
                {reserveLabel}
              </Button>
            </div>

            {/* Quick Info */}
            <div class="p-6 rounded-xl bg-white border border-border">
              <h3 class="text-sm font-semibold uppercase tracking-wider text-muted mb-3">
                {isEnglish ? "Quick Info" : "Info Rápida"}
              </h3>
              <div class="space-y-2 text-sm">
                <p><strong class="text-foreground">{infoLabels.duration}:</strong> <span class="text-muted-foreground">{t.operational.duration}</span></p>
                <p><strong class="text-foreground">{infoLabels.days}:</strong> <span class="text-muted-foreground">{t.operational.days}</span></p>
                <p><strong class="text-foreground">{infoLabels.capacity}:</strong> <span class="text-muted-foreground">{t.operational.capacity}</span></p>
                <p><strong class="text-foreground">{infoLabels.difficulty}:</strong> <span class="text-muted-foreground">{t.operational.difficulty}</span></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  {/* Reviews Section */}
  {tourReviews.length > 0 && (
    <section class="section-padding-sm border-t border-border">
      <Container>
        <h2 class="text-2xl font-semibold text-foreground mb-6">{infoLabels.reviews}</h2>
        <div class="space-y-6">
          {tourReviews.map((r) => (
            <div key={r.id} class="p-6 rounded-xl bg-crema border border-border">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-secondary text-white flex items-center justify-center text-sm font-bold shrink-0">
                  {r.author.split(" ").map(n => n[0]).join("").slice(0, 2)}
                </div>
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="font-semibold text-foreground text-sm">{r.author}</span>
                    <span class="text-xs text-muted">• {r.date}</span>
                  </div>
                  <div class="flex items-center gap-1 mb-2">
                    {Array.from({ length: r.rating }).map((_, i) => (
                      <svg key={i} class="w-4 h-4 text-yellow-400" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279L12 19.446l-7.416 3.967 1.48-8.279L0 8.706l8.332-1.151z"/>
                      </svg>
                    ))}
                  </div>
                  <p class="text-sm text-muted-foreground leading-relaxed italic">
                    "{resolveLabel(r.comment, lang)}"
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </Container>
    </section>
  )}
</article>