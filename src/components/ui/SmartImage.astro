---
// SmartImage.astro — Componente de imagen optimizada con astro:assets
// Maneja imágenes locales (importadas via @/assets) y remotas (URL) con lazy loading
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
	src: ImageMetadata | string;
	alt: string;
	width?: number;
	height?: number;
	class?: string;
	loading?: "lazy" | "eager";
	format?: "auto" | "webp" | "avif" | "png" | "jpg";
}

const {
	src,
	alt,
	width = 800,
	height = 600,
	class: className = "",
	loading = "lazy",
	format = "auto",
} = Astro.props;
---

{typeof src === "string" && src.startsWith("http") ? (
	<img
		src={src}
		alt={alt}
		width={width}
		height={height}
		class={className}
		loading={loading}
	/>
) : (
	<Image
		src={src}
		alt={alt}
		width={width}
		height={height}
		class={className}
		loading={loading}
		format={format}
	/>
)}
