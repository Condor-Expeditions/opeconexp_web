---
import Container from "../../shared/Container.astro";
import Dropdown from "../Dropdown.astro";
import DropdownItem from "../DropdownItem.astro";
import { NAV } from "../../../data/navigation";
import Button from "../Button.astro";

export interface Props {
	logoSrc?: string;
	logoAlt?: string;
}
const { logoSrc = "/logo.svg", logoAlt = "Cóndor Expeditions" } = Astro.props as Props;

// El ítem Tours tiene children divididos en 3 grupos + 1 personalizado
const toursItem = NAV.find((n) => n.id === "tours");
const especialesItem = NAV.find((n) => n.id === "especiales");
const masItem = NAV.find((n) => n.id === "mas");
const desktopItems = NAV.filter((n) => n.id !== "mas");
---

<header class="fixed w-full z-50 bg-white/95 backdrop-blur-sm border-b border-primary-200/60 shadow-sm">
  <Container class="flex items-center justify-between py-2">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 shrink-0">
      <img src={logoSrc} alt={logoAlt} class="w-auto h-20" />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-1 flex-1 justify-center px-6">
      {
        desktopItems.map((item) => {
          if (item.id === "tours" && toursItem?.children) {
            // Mega-dropdown: 4 columnas (región, tipo, temporada, personalizados)
            const region = toursItem.children.find((c) => c.id === "tours-header-region");
            const tipo = toursItem.children.find((c) => c.id === "tours-header-tipo");
            const temporada = toursItem.children.find((c) => c.id === "tours-header-temporada");
            const personalizados = toursItem.children.find((c) => c.id === "tours-header-personalizados");
            return (
              <Dropdown align="center" width="xl" class="[&_button]:border-none!" triggerClass="font-display text-sm tracking-wider uppercase text-foreground/80 hover:text-primary transition-colors px-3 py-2">
                <span slot="trigger">{item.label}</span>
                <div class="flex gap-0 min-w-[580px]">
                  {/* Col 1: Región */}
                  <div class="flex-1 p-4">
                    <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">{region?.label}</p>
                    {region?.children?.map((r) => (
                      <DropdownItem href={r.href ?? "#"}>{r.label}</DropdownItem>
                    ))}
                  </div>
                  {/* Col 2: Tipo */}
                  <div class="flex-1 p-4 border-l border-border/50">
                    <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">{tipo?.label}</p>
                    {tipo?.children?.map((t) => (
                      <DropdownItem href={t.href ?? "#"}>{t.label}</DropdownItem>
                    ))}
                  </div>
                  {/* Col 3: Temporada */}
                  <div class="flex-1 p-4 border-l border-border/50">
                    <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">{temporada?.label}</p>
                    {temporada?.children?.map((s) => (
                      <DropdownItem href={s.href ?? "#"}>{s.label}</DropdownItem>
                    ))}
                  </div>
                  {/* Col 4: Personalizados destacado */}
                  {personalizados && (
                    <div class="w-44 p-4 bg-accent/5 rounded-r-xl flex flex-col items-center justify-center text-center">
                      <span class="text-3xl mb-2">✨</span>
                      <p class="font-display font-bold text-foreground text-sm mb-1">{personalizados.label}</p>
                      <p class="text-xs text-muted-foreground mb-3">Diseña tu expedición a medida</p>
                      <a href={personalizados.href ?? "#"} class="inline-flex px-4 py-2 bg-accent text-white text-xs font-semibold rounded-full">Crear mi tour →</a>
                    </div>
                  )}
                </div>
              </Dropdown>
            );
          }

          if (item.id === "especiales" && especialesItem?.disabled) {
            // Dropdown deshabilitado — items opacos
            return (
              <Dropdown align="center" width="sm" class="[&_button]:border-none!" triggerClass="font-display text-sm tracking-wider uppercase text-foreground/30 hover:text-foreground/30 transition-colors px-3 py-2 cursor-default relative group">
                <span slot="trigger">{item.label}<span class="ml-1.5 text-[10px] text-muted-foreground bg-background px-1.5 py-0.5 rounded-full">Próx</span></span>
                <div class="pointer-events-none">
                  {especialesItem.children?.map((child) => (
                    <DropdownItem href="#" class="opacity-40 cursor-default!">{child.label}</DropdownItem>
                  ))}
                </div>
              </Dropdown>
            );
          }

          if (item.id === "especiales" && !especialesItem?.disabled) {
            // Dropdown normal (cuando se active)
            return (
              <Dropdown align="center" width="sm" class="[&_button]:border-none!">
                <span slot="trigger" class="font-display text-sm tracking-wider uppercase text-foreground/80 hover:text-primary transition-colors px-3 py-2">{item.label}</span>
                {especialesItem?.children?.map((child) => (
                  <DropdownItem href={child.href ?? "#"}>{child.label}</DropdownItem>
                ))}
              </Dropdown>
            );
          }

          // Resto (no debería llegar acá, pero por si acaso)
          return (
            <a href={item.href ?? "#"} class="font-display text-sm tracking-wider uppercase text-foreground/70 hover:text-primary transition-colors px-3 py-2">
              {item.label}
            </a>
          );
        })
      }

      <!-- Más -->
      {masItem && (
        <Dropdown align="center" width="sm" class="[&_button]:border-none!">
          <span slot="trigger" class="font-display text-sm tracking-wider uppercase text-foreground/80 hover:text-primary transition-colors px-3 py-2">{masItem.label}</span>
          {masItem.children?.map((child) => (
            <DropdownItem href={child.href ?? "#"}>{child.label}</DropdownItem>
          ))}
        </Dropdown>
      )}
    </nav>

    <!-- Right: Lang + CTA + Mobile Menu -->
    <div class="flex items-center gap-3 shrink-0">
      <Dropdown align="right" width="sm" class="[&_button]:border-none!">
        <span slot="trigger" class="text-xs text-foreground/70 hover:text-primary transition-colors">
          ES ▾
        </span>
        <DropdownItem href="/en">English</DropdownItem>
      </Dropdown>

      <a href="/contacto">
        <Button variant="primary" class="rounded-full! text-sm! font-semibold bg-accent hover:bg-accent-dark border-none!">
          Reservar
        </Button>
      </a>

      <!-- Mobile hamburger -->
      <button id="mobile-menu-btn" class="lg:hidden p-2 text-foreground/80 hover:text-primary" aria-label="Menú">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="6" y2="6"/>
          <line x1="4" x2="20" y1="12" y2="12"/>
          <line x1="4" x2="20" y1="18" y2="18"/>
        </svg>
      </button>
    </div>
  </Container>

  <!-- Mobile nav drawer -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-primary/10 bg-white">
    <div class="flex flex-col p-4 gap-2">
      {
        NAV.map((item) => (
          <div>
            <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mt-4 mb-1 first:mt-0">
              {item.label}
              {item.disabled && <span class="ml-1.5 text-[10px] text-muted-foreground">(Próximamente)</span>}
            </p>
            {item.children?.map((child) => (
              <a href={child.disabled ? "#" : (child.href ?? "#")}
                 class:list={["block text-sm py-1.5 font-display uppercase tracking-wide", child.disabled ? "text-muted-foreground/40 cursor-default" : "text-foreground/70 hover:text-primary"]}>
                {child.label}
                {child.disabled && <span class="ml-2 text-[10px] text-muted-foreground">Próx</span>}
              </a>
            ))}
            {item.type === "link" && !item.children && (
              <a href={item.href ?? "#"} class="block text-sm py-1.5 font-display uppercase tracking-wide text-foreground/70 hover:text-primary">
                {item.label}
              </a>
            )}
          </div>
        ))
      }
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });
</script>