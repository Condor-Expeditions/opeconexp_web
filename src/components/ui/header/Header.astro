---
import Container from "../../shared/Container.astro";
import Dropdown from "../Dropdown.astro";
import DropdownItem from "../DropdownItem.astro";
import { ROUTES } from "../../../data/routes";
import Button from "../Button.astro";

export interface Props {
	logoSrc?: string;
	logoAlt?: string;
}
const { logoSrc = "/logo.svg", logoAlt = "Cóndor Expeditions" } = Astro.props as Props;
---

<header class="fixed w-full z-50 bg-white/95 backdrop-blur-sm border-b border-primary-200/60 shadow-sm">
  <Container class="flex items-center justify-between py-2">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 shrink-0">
      <img src={logoSrc} alt={logoAlt} class="w-auto h-20" />
    </a>

    <!-- Navigation -->
    <nav class="hidden lg:flex items-center gap-1 flex-1 justify-center px-6">
      {
        ROUTES.map((route) => {
          if (route.component === "dropdown") {
            return (
              <Dropdown align="center" width="sm" class="[&_button]:border-none!">
                <span slot="trigger" class="font-display text-sm tracking-wider uppercase text-foreground/80 hover:text-primary transition-colors">
                  {route.label}
                </span>
                {route.label === "Destinos" && (
                  <>
                    <DropdownItem href="/destinos#andes">Andes</DropdownItem>
                    <DropdownItem href="/destinos#amazonia">Amazonía</DropdownItem>
                    <DropdownItem href="/destinos#costa">Costa</DropdownItem>
                    <DropdownItem href="/destinos#galapagos">Galápagos</DropdownItem>
                  </>
                )}
                {route.label === "Experiencias" && (
                  <>
                    <DropdownItem href="/experiencias#trekking">Trekking</DropdownItem>
                    <DropdownItem href="/experiencias#rafting">Rafting</DropdownItem>
                    <DropdownItem href="/experiencias#montanismo">Montañismo</DropdownItem>
                    <DropdownItem href="/experiencias#selva">Selva</DropdownItem>
                    <DropdownItem href="/experiencias#cultural">Cultural</DropdownItem>
                  </>
                )}
              </Dropdown>
            );
          }
          return (
            <a
              href={route.href}
              class="font-display text-sm tracking-wider uppercase text-foreground/70 hover:text-primary transition-colors px-3 py-2"
            >
              {route.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Right: Lang + CTA + Mobile Menu -->
    <div class="flex items-center gap-3 shrink-0">
      <Dropdown align="right" width="sm" class="[&_button]:border-none!">
        <span slot="trigger" class="text-xs text-foreground/70 hover:text-primary transition-colors">
          ES ▾
        </span>
        <DropdownItem href="/en">English</DropdownItem>
      </Dropdown>

      <a href="/contacto">
        <Button variant="primary" class="rounded-full! text-sm! font-semibold bg-accent hover:bg-accent-dark border-none!">
          Reservar
        </Button>
      </a>

      <!-- Mobile hamburger -->
      <button id="mobile-menu-btn" class="lg:hidden p-2 text-foreground/80 hover:text-primary" aria-label="Menú">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="6" y2="6"/>
          <line x1="4" x2="20" y1="12" y2="12"/>
          <line x1="4" x2="20" y1="18" y2="18"/>
        </svg>
      </div>
    </div>
  </Container>

  <!-- Mobile nav drawer -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-primary/10 bg-white">
    <div class="flex flex-col p-4 gap-2">
      {
        ROUTES.map((route) => (
          <a
            href={route.href}
            class="text-sm uppercase tracking-wider text-foreground/70 hover:text-primary py-2 font-display"
          >
            {route.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });
</script>