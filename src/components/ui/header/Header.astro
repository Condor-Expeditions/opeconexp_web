---
import Logo from "@/assets/logo.svg";
import Container from "@/components/shared/Container";
import Dropdown from "@/components/ui/Dropdown";
import DropdownItem from "@/components/ui/DropdownItem";
import { ROUTES } from "@/data/routes";
import { MENU_DATA } from "@/data/menuData";
import Button from "../Button.astro";

export interface Props {
  logoSrc?: string;
  logoAlt?: string;
}

const { explora } = MENU_DATA;

const aspectPattern = ["aspect-[4/3]", "aspect-square", "aspect-[3/4]"];
---

<header
  class="bg-transparent hover:bg-secondary transition-colors duration-300 fixed w-full z-50 group"
>
  <Container class="flex items-center justify-between">
    <a href="/" class="">
      <Logo class="w-auto h-24 py-2" />
    </a>

    <!-- Navigation -->
    <nav id="header-nav" class="py-3 flex gap-1 flex-1 px-10 [&_a]:text-white group-hover:[&_a]:text-black">
      {
        ROUTES.map((route) => (
          <Button id={route.id} href={route.href} variant="ghost" size="lg" class="">
            {route.label}
          </Button>
        ))
      }
    </nav>

    <div>
      <!-- <Dropdown align="right" width="md" class="[&_button]:border-none!">
        <span slot="trigger">ES</span>

        <DropdownItem href="/en">English</DropdownItem>
      </Dropdown> -->

      <!-- Desktop Section -->
      <Button variant="primary" class="rounded-full!">
        <a href="/contacto">Reservar</a>
      </Button>
    </div>
  </Container>

<Container>
    <div id="explora-submenu" class="pb-5">
      <div class="grid grid-cols-4 grid-rows-2 gap-2">
        {explora.map((item, index) => (
          <a href={item.href} class={`group flex items-center gap-4 p-3 transition-all duration-300 relative ${item.gridConfig}`}>
            <img
              src={item.image.src}
              alt={item.title}
              class="rounded-lg object-cover shrink-0 absolute inset-0 h-full w-full"
            />
            <div class="flex flex-col justify-center min-w-0 absolute bottom-0 left-0 right-0 p-4">
              <h3 class="font-semibold text-sm text-white leading-tight group-hover:text-primary-red transition-colors line-clamp-2">
                {item.title}
              </h3>
              <p class="inline-block w-fit py-0.5 text-[10px] font-semibold text-white bg-primary-red rounded-full mb-1">
                {item.type}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </Container>
</header>

<script>
  import { HeaderController } from "./HeaderController";

  const headerController = new HeaderController();
  headerController.init();
</script>
