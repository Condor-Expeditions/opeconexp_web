---
// MapEmbed.astro — Integración de Google Maps (iframe embed)
// Solo usa el iframe embebido, sin dependencias de SDK.
export interface RutaMapa {
	origen: string;
	destino: string;
	waypoints: string[];
	urlEmbed: string;
}

interface Props {
	ruta: RutaMapa;
	lang?: "es" | "en";
}

const { ruta, lang = "es" } = Astro.props;

const routeLabel = lang === "en" ? "Route map" : "Mapa de la ruta";
const originLabel = lang === "en" ? "From" : "Desde";
const destLabel = lang === "en" ? "To" : "Hasta";
const waypointsLabel = lang === "en" ? "Waypoints" : "Puntos del recorrido";
---

<section class="map-section">
	<div class="map-header">
		<h3 class="map-title">{routeLabel}</h3>
		<div class="map-meta">
			<span class="map-meta-item"><strong>{originLabel}:</strong> {ruta.origen}</span>
			<span class="map-meta-item"><strong>{destLabel}:</strong> {ruta.destino}</span>
		</div>
		{ruta.waypoints.length > 0 && (
			<p class="map-waypoints"><strong>{waypointsLabel}:</strong> {ruta.waypoints.join(" → ")}</p>
		)}
	</div>
	<div class="map-frame">
		{ruta.urlEmbed ? (
			<iframe
				src={ruta.urlEmbed}
				width="100%"
				height="100%"
				style="border:0;"
				allowfullscreen=""
				loading="lazy"
				allow="geolocation"
				title={routeLabel}
			></iframe>
		) : (
			<div class="map-fallback">
				<p>{lang === "en" ? "Map not available" : "Mapa no disponible"}</p>
			</div>
		)}
	</div>
</section>

<style>
	.map-section {
		padding: 2rem 0;
	}

	.map-header {
		margin-bottom: 1rem;
	}

	.map-title {
		font-size: 1.25rem;
		font-weight: 600;
		color: #000000;
		margin-bottom: 0.75rem;
	}

	.map-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		font-size: 0.875rem;
		color: #64748b;
		margin-bottom: 0.5rem;
	}

	.map-waypoints {
		font-size: 0.875rem;
		color: #64748b;
	}

	.map-frame {
		width: 100%;
		height: 25rem;
		border-radius: 0.75rem;
		overflow: hidden;
		border: 1px solid #e5e5e5;
		background: #f4efdc;
	}

	.map-frame iframe {
		width: 100%;
		height: 100%;
	}

	.map-fallback {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #64748b;
	}

	@media (max-width: 640px) {
		.map-frame {
			height: 17.5rem;
		}
	}
</style>