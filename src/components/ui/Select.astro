---
import type { HTMLAttributes } from "astro/types";

export type SelectSize = "sm" | "md" | "lg";

export interface Option {
	value: string;
	label: string;
	disabled?: boolean;
}

export interface Props extends HTMLAttributes<"select"> {
	options: Option[];
	size?: SelectSize;
	error?: boolean;
	errorMessage?: string;
	disabled?: boolean;
	placeholder?: string;
	class?: string;
}

const {
	options,
	size = "md",
	error = false,
	errorMessage,
	disabled = false,
	placeholder,
	class: className = "",
	...rest
} = Astro.props;

const baseClasses =
	"flex w-full border bg-background text-foreground transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 appearance-none bg-no-repeat cursor-pointer";

const sizeClasses: Record<SelectSize, string> = {
	sm: "h-8 px-2.5 pr-8 text-sm rounded-md",
	md: "h-10 px-3 pr-9 text-sm rounded-md",
	lg: "h-12 px-4 pr-10 text-base rounded-lg",
};

const stateClasses = error
	? "border-destructive focus-visible:ring-destructive"
	: "border-input";

const classes = [baseClasses, sizeClasses[size], stateClasses, className]
	.filter(Boolean)
	.join(" ");
---

<div class="relative w-full">
	<select class={classes} disabled={disabled} {...rest}>
		{placeholder && (
			<option value="" disabled selected>
				{placeholder}
			</option>
		)}
		{options.map((opt) => (
			<option value={opt.value} disabled={opt.disabled}>
				{opt.label}
			</option>
		))}
	</select>

	<!-- Chevron icon -->
	<svg
		class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground"
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<path d="m6 9 6 6 6-6" />
	</svg>

	{error && errorMessage && (
		<p class="mt-1.5 text-sm text-destructive">{errorMessage}</p>
	)}
</div>
