---
import Logo from "@/assets/logo.svg";
import Container from "@/components/shared/Container";
import { siteConfig } from "@/data/site.config";
import { ROUTES } from "@/data/routes";

export interface Props {
	lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const isEnglish = lang === "en";

const quickLinks = ROUTES.map((route) => ({
	...route,
	href: isEnglish ? `/en${route.href}` : route.href,
	label: isEnglish
		? route.label === "Explora"
			? "Explore"
			: route.label === "Destinos"
				? "Destinations"
				: route.label === "Nosotros"
					? "About"
					: "Contact"
		: route.label,
}));

const brandDesc = isEnglish
	? "Authentic expeditions in the heart of Ecuador. We connect travelers with the nature, culture, and history of the Austro."
	: "Expediciones auténticas en el corazón del Ecuador. Conectamos viajeros con la naturaleza, cultura e historia del Austro.";

const contactTitle = isEnglish ? "Contact" : "Contacto";
const newsletterTitle = isEnglish ? "Newsletter" : "Boletín";
const newsletterDesc = isEnglish
	? "Receive travel inspiration and exclusive offers."
	: "Recibe inspiración de viaje y ofertas exclusivas.";
const newsletterPlaceholder = isEnglish ? "Your email" : "Tu correo electrónico";
const newsletterBtn = isEnglish ? "Subscribe" : "Suscribirse";
const quickLinksTitle = isEnglish ? "Quick Links" : "Enlaces Rápidos";
const followUs = isEnglish ? "Follow Us" : "Síguenos";
const rights = isEnglish
	? `© ${new Date().getFullYear()} Condor Expeditions. All rights reserved.`
	: `© ${new Date().getFullYear()} Condor Expeditions. Todos los derechos reservados.`;

const socialIcons: Record<string, string> = {
	facebook:
		"M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z",
	instagram:
		"M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z M17.5 6.5h.01 M2 12C2 6.48 6.48 2 12 2s10 4.48 10 10-4.48 10-10 10S2 17.52 2 12z M7.5 2h9a5.5 5.5 0 0 1 5.5 5.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2z",
	tiktok:
		"M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5",
	youtube:
		"M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17z M10 15l5-3-5-3z",
	whatsapp:
		"M17.5 12.5a5 5 0 0 1-7.3 4.5l-3.2.9.9-3.2a5 5 0 1 1 9.6-2.2z M14.5 11.5l-1.5 2.5-2-1 1.5-2.5",
};
---

<footer class="bg-negro text-white">
	<Container>
		<div class="py-16 md:py-20 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
			<!-- Brand -->
			<div class="space-y-4">
				<a href={isEnglish ? "/en/" : "/"} aria-label="Condor Expeditions">
					<Logo class="w-auto h-16" />
				</a>
				<p class="text-sm text-white/70 leading-relaxed max-w-xs">
					{brandDesc}
				</p>
				<div class="flex items-center gap-3 pt-2">
					{
						siteConfig.socials.map((social) => (
							<a
								href={social.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={social.name}
								class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-primary-red transition-colors duration-200"
							>
								<svg
									class="w-4 h-4"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d={socialIcons[social.icon] || ""} />
								</svg>
							</a>
						))
					}
				</div>
			</div>

			<!-- Quick Links -->
			<div>
				<h3 class="text-sm font-semibold uppercase tracking-wider text-white/50 mb-4">
					{quickLinksTitle}
				</h3>
				<ul class="space-y-2.5">
					{
						quickLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class="text-sm text-white/80 hover:text-primary-red transition-colors duration-200"
								>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<!-- Contact Info -->
			<div>
				<h3 class="text-sm font-semibold uppercase tracking-wider text-white/50 mb-4">
					{contactTitle}
				</h3>
				<ul class="space-y-3">
					<li class="flex items-start gap-2.5">
						<svg class="w-4 h-4 mt-0.5 text-primary-red shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
						</svg>
						<a href={siteConfig.companyInfo.phone.href} class="text-sm text-white/80 hover:text-primary-red transition-colors">
							{siteConfig.companyInfo.phone.name}
						</a>
					</li>
					<li class="flex items-start gap-2.5">
						<svg class="w-4 h-4 mt-0.5 text-primary-red shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
							<polyline points="22,6 12,13 2,6"/>
						</svg>
						<a href={siteConfig.companyInfo.email.href} class="text-sm text-white/80 hover:text-primary-red transition-colors">
							{siteConfig.companyInfo.email.name}
						</a>
					</li>
					<li class="flex items-start gap-2.5">
						<svg class="w-4 h-4 mt-0.5 text-primary-red shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
							<circle cx="12" cy="10" r="3"/>
						</svg>
						<span class="text-sm text-white/80">{siteConfig.companyInfo.address}</span>
					</li>
					<li class="flex items-start gap-2.5">
						<svg class="w-4 h-4 mt-0.5 text-primary-red shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"/>
							<polyline points="12 6 12 12 16 14"/>
						</svg>
						<span class="text-sm text-white/80">{siteConfig.companyInfo.scheduleWeekdays}</span>
					</li>
				</ul>
			</div>

			<!-- Newsletter -->
			<div>
				<h3 class="text-sm font-semibold uppercase tracking-wider text-white/50 mb-4">
					{newsletterTitle}
				</h3>
				<p class="text-sm text-white/70 mb-3">{newsletterDesc}</p>
				<form class="flex flex-col gap-2" onsubmit="event.preventDefault();">
					<input
						type="email"
						placeholder={newsletterPlaceholder}
						class="w-full h-10 px-3 text-sm bg-white/10 border border-white/20 rounded-md text-white placeholder:text-white/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-red"
						aria-label={newsletterPlaceholder}
					/>
					<button
						type="submit"
						class="w-full h-10 px-4 text-sm font-medium bg-primary-red text-white rounded-md hover:bg-primary-red/90 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
					>
						{newsletterBtn}
					</button>
				</form>
			</div>
		</div>

		<!-- Bottom bar -->
		<div class="border-t border-white/10 py-6 flex flex-col md:flex-row items-center justify-between gap-4">
			<p class="text-xs text-white/50">{rights}</p>
			<div class="flex items-center gap-4">
				<a href={siteConfig.companyInfo.whatsApp} target="_blank" rel="noopener noreferrer" class="text-xs text-white/50 hover:text-primary-red transition-colors">
					WhatsApp
				</a>
				<a href={siteConfig.companyInfo.location} target="_blank" rel="noopener noreferrer" class="text-xs text-white/50 hover:text-primary-red transition-colors">
					{isEnglish ? "Location" : "Ubicación"}
				</a>
			</div>
		</div>
	</Container>
</footer>
