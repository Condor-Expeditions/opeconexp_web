---
import { Icon } from "astro-icon/components";
import blackLogoUrl from "@/assets/brand/complete/black.svg?url";
import ContainerHeader from "@/components/shared/ContainerHeader";
import SocialLinks from "@/components/shared/SocialLinks";
import { navigationLinks } from "@/data/navigation.config";
import { siteConfig } from "@/data/site.config";
import "./footer.css";

export interface Props {
	lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const isEnglish = lang === "en";
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const text = isEnglish ? {
	tagline: "Live what others only visit.",
	description: "From Cuenca, discover an authentic Ecuador.",
	explore: "Explore",
	contact: "Find us in",
	location: "View location",
	socials: "Follow the adventure",
	home: "Home",
	newTab: "opens in a new tab",
	rights: "All rights reserved.",
} : {
	tagline: "Vive lo que otros solo visitan.",
	description: "Desde Cuenca, hacia un Ecuador auténtico.",
	explore: "Explora",
	contact: "Nos encontramos en",
	location: "Ver ubicación",
	socials: "Sigue la aventura",
	home: "Inicio",
	newTab: "abre en otra pestaña",
	rights: "Todos los derechos reservados.",
};
const englishNavigation: Record<string, string> = {
	"/": "Home",
	"/tours": "Tours",
	"/ediciones": "Editions",
	"/sobre-nosotros": "About us",
	"/contacto": "Contact",
};
const { companyInfo } = siteConfig;
const schedule = isEnglish
	? companyInfo.scheduleWeekdays.replace("Lunes a Domingo de", "Monday to Sunday,")
	: companyInfo.scheduleWeekdays;
---

<footer class="site-footer">
	<ContainerHeader>
		<div class="footer-body">
			<div class="footer-brand">
				<a class="footer-logo" href="/" aria-label={`${siteConfig.companyName} — ${text.home}`}>
					<img src={blackLogoUrl} alt={siteConfig.companyName} width="443" height="338" loading="lazy" />
				</a>
				<p class="footer-description"><span>{text.tagline}</span>{text.description}</p>
				<div role="group" aria-label={text.socials}><SocialLinks lang={lang} /></div>
			</div>
			<nav class="footer-navigation" aria-labelledby="footer-navigation-title">
				<h2 class="footer-eyebrow" id="footer-navigation-title">{text.explore}</h2>
				<ul>
					{navigationLinks.map((link, index) => (
						<li><a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>
							<span class="footer-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
							<span>{isEnglish ? englishNavigation[link.href] || link.title : link.title}</span>
							<Icon name="arrow-up-right" aria-hidden="true" />
						</a></li>
					))}
				</ul>
			</nav>
			<div class="footer-contact">
				<h2 class="footer-eyebrow">{text.contact}</h2>
				<address>
					<p>{companyInfo.address}</p>
					<a class="footer-location" href={companyInfo.location} target="_blank" rel="noopener noreferrer" aria-label={`${text.location} (${text.newTab})`}>{text.location}<Icon name="arrow-up-right" aria-hidden="true" /></a>
					<div class="footer-direct-contact">
						<a href={companyInfo.phone.href}>{companyInfo.phone.name}</a>
						<a href={companyInfo.email.href}>{companyInfo.email.name}</a>
					</div>
				</address>
				<p class="footer-schedule">{schedule}</p>
			</div>
		</div>
		<div class="footer-bottom">
			<p>© {new Date().getFullYear()} {siteConfig.companyName}. {text.rights}</p>
			<p>{text.tagline}</p>
		</div>
	</ContainerHeader>
</footer>
