---
import Container from "../shared/Container.astro";
import { siteConfig } from "../../data/site.config";
---

<footer class="bg-dark text-dark-foreground pt-20 pb-8">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-16">
      <!-- Col 1: Logo + About -->
      <div class="lg:col-span-2">
        <a href="/" class="inline-block mb-4">
          <span class="font-display text-2xl text-white tracking-wide">Cóndor Expeditions</span>
        </a>
        <p class="text-dark-foreground/70 text-sm leading-relaxed max-w-md mb-6">
          Operadora de turismo de aventura especializada en expediciones personalizadas en Ecuador.
          Descubre los Andes, la Amazonía, la Costa y Galápagos con guías expertos locales.
        </p>
        <!-- Social icons -->
        <div class="flex gap-4">
          {siteConfig.socials.filter(s => s.icon !== "whatsapp").map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-full bg-dark-muted hover:bg-primary transition-colors flex items-center justify-center text-sm"
              aria-label={social.name}
            >
              <span class="text-xs font-semibold">{social.name.charAt(0)}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Col 2: Enlaces rápidos -->
      <div>
        <h4 class="font-display text-sm uppercase tracking-widest mb-5 text-primary-300">Explora</h4>
        <ul class="space-y-3 text-sm text-dark-foreground/70">
          <li><a href="/destinos" class="hover:text-white transition-colors">Destinos</a></li>
          <li><a href="/experiencias" class="hover:text-white transition-colors">Experiencias</a></li>
          <li><a href="/nosotros" class="hover:text-white transition-colors">Nosotros</a></li>
          <li><a href="/contacto" class="hover:text-white transition-colors">Contacto</a></li>
        </ul>
      </div>

      <!-- Col 3: Experiencias -->
      <div>
        <h4 class="font-display text-sm uppercase tracking-widest mb-5 text-primary-300">Aventuras</h4>
        <ul class="space-y-3 text-sm text-dark-foreground/70">
          <li><a href="/experiencias#trekking" class="hover:text-white transition-colors">Trekking</a></li>
          <li><a href="/experiencias#rafting" class="hover:text-white transition-colors">Rafting</a></li>
          <li><a href="/experiencias#montanismo" class="hover:text-white transition-colors">Montañismo</a></li>
          <li><a href="/experiencias#selva" class="hover:text-white transition-colors">Selva</a></li>
        </ul>
      </div>

      <!-- Col 4: Contacto -->
      <div>
        <h4 class="font-display text-sm uppercase tracking-widest mb-5 text-primary-300">Contacto</h4>
        <ul class="space-y-4 text-sm text-dark-foreground/70">
          <li class="flex items-start gap-2">
            <span class="mt-0.5 shrink-0">📍</span>
            <span>{siteConfig.companyInfo.address}</span>
          </li>
          <li>
            <a href={siteConfig.companyInfo.phone.href} class="hover:text-white transition-colors flex items-center gap-2">
              <span>📞</span> {siteConfig.companyInfo.phone.name}
            </a>
          </li>
          <li>
            <a href={siteConfig.companyInfo.email.href} class="hover:text-white transition-colors flex items-center gap-2">
              <span>✉️</span> {siteConfig.companyInfo.email.name}
            </a>
          </li>
          <li>
            <a
              href={siteConfig.companyInfo.whatsApp}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-accent hover:bg-accent-dark text-white px-4 py-2 rounded-full text-sm font-semibold transition-colors mt-2"
            >
              💬 WhatsApp
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-dark-muted pt-6 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-dark-foreground/50">
      <p>&copy; {new Date().getFullYear()} {siteConfig.companyName}. Todos los derechos reservados.</p>
      <p>{siteConfig.companyInfo.address} — {siteConfig.companyInfo.scheduleWeekdays}</p>
    </div>
  </Container>
</footer>