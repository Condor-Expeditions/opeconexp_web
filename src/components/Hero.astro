---
---

<section class="relative min-h-screen w-full overflow-hidden">
  <video
    id="hero-video"
    autoplay
    loop
    muted
    playsinline
    class="absolute inset-0 w-full h-full object-cover"
  ></video>

  <div class="absolute inset-0 bg-black/45"></div>

  <div class="relative z-10 min-h-screen flex flex-col items-center justify-center px-4 py-12 text-center text-white">
    <div class="max-w-4xl mx-auto">
      <span class="inline-block text-accent font-display text-sm uppercase tracking-[0.3em] mb-6 border border-accent/40 rounded-full px-4 py-1.5">
        Donde los Andes besan la selva
      </span>

      <h1 class="font-display text-4xl md:text-7xl font-bold mb-6 leading-tight">
        <span class="block">Expediciones</span>
        <span class="block text-accent">Inolvidables</span>
      </h1>

      <p class="text-lg md:text-2xl mb-10 max-w-2xl mx-auto text-white/90">
        Descubre la aventura extrema en los rincones más remotos del planeta.
        Turismo de expedición auténtico y sostenible.
      </p>

      <div class="flex flex-wrap gap-4 justify-center">
        <a href="#destinos-destacados" class="px-8 py-4 bg-accent hover:bg-accent-dark text-white font-semibold rounded-full transition-colors">
          Explorar Destinos
        </a>
        <a href="/experiencias" class="px-8 py-4 border-2 border-white/70 hover:border-white text-white font-semibold rounded-full transition-colors">
          Ver Experiencias
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const video = document.getElementById("hero-video") as HTMLVideoElement;

  function setVideoSrc() {
    const isMobile = window.innerWidth < 768;
    video.src = isMobile ? "/videos/portrait_hero.mp4" : "/videos/landscape_hero.mp4";
  }

  setVideoSrc();
  window.addEventListener("resize", setVideoSrc);
</script>