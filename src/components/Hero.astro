---
---

<section class="relative min-h-screen w-full overflow-hidden">
  <video
    id="hero-video"
    autoplay
    loop
    muted
    playsinline
    class="absolute inset-0 w-full h-full object-cover"
  ></video>

  <div class="absolute inset-0 bg-black/40"></div>

  <div class="relative z-10 min-h-screen flex flex-col items-center justify-center px-4 py-12 text-center text-white">
    <div class="max-w-4xl mx-auto">

      <h1 class="text-4xl md:text-6xl font-extrabold mb-6">
        <span class="block">Expediciones</span>
        <span class="block text-primary-red">Inolvidables</span>
      </h1>

      <p class="text-xl md:text-2xl mb-10 max-w-2xl mx-auto">
        Descubre la aventura extrema en los rincones más remotos del planeta.
        Turismo de expedición auténtico y sostenible.
      </p>
    </div>
  </div>
</section>

<script>
  const video = document.getElementById("hero-video") as HTMLVideoElement;

  function setVideoSrc() {
    const isMobile = window.innerWidth < 768;
    video.src = isMobile ? "/videos/portrait_hero.mp4" : "/videos/landscape_hero.mp4";
  }

  setVideoSrc();
  window.addEventListener("resize", setVideoSrc);
</script>
