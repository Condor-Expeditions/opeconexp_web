/frontend/tmp/

# ============================================================
# 🐍 BACKEND (DJANGO + DJANGO-NINJA + RESTFRAMEWORK + CELERY)
# ============================================================

# Entornos virtuales
/backend/venv/
/backend/.venv/
/backend/env/
/backend/.env
/backend/.env.*

