# Configuración de ejemplo para Condor Expeditions
# Copiar este archivo como .env y ajustar los valores según el entorno

# =============================================================================
# CONFIGURACIÓN GENERAL
# =============================================================================

# Entorno de ejecución (dev, staging, prod)
ENVIRONMENT=dev

# Clave secreta de Django (generar una única y segura para producción)
SECRET_KEY=django-insecure-dev-key-change-in-production

# Debug mode (False para producción)
DEBUG=True

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# BASE DE DATOS POSTGRESQL
# =============================================================================

# Motor de base de datos
DB_ENGINE=django.db.backends.postgresql

# Nombre de la base de datos
DB_NAME=condor_expeditions

# Usuario de la base de datos
DB_USER=condor_user

# Contraseña del usuario
DB_PASSWORD=condor_password

# Host de la base de datos
DB_HOST=db

# Puerto de la base de datos
DB_PORT=5432

# =============================================================================
# MONGODB
# =============================================================================

# Host de MongoDB
MONGODB_HOST=mongodb

# Puerto de MongoDB
MONGODB_PORT=27017

# Nombre de la base de datos
MONGODB_NAME=condor_expeditions

# Usuario administrador
MONGODB_USER=admin

# Contraseña del administrador
MONGODB_PASSWORD=admin_password

# Fuente de autenticación
MONGODB_AUTH_SOURCE=admin

# =============================================================================
# REDIS (PARA CELERY)
# =============================================================================

# URL de conexión a Redis
REDIS_URL=redis://redis:6379/0

# =============================================================================
# CONFIGURACIÓN REGIONAL
# =============================================================================

# Idioma por defecto
LANGUAGE_CODE=es

# Zona horaria
TIME_ZONE=America/Guayaquil

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# Backend de email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Servidor SMTP
EMAIL_HOST=smtp.gmail.com

# Puerto SMTP
EMAIL_PORT=587

# Usar TLS
EMAIL_USE_TLS=True

# Usuario del email
EMAIL_HOST_USER=your-email@gmail.com

# Contraseña del email (o app password para Gmail)
EMAIL_HOST_PASSWORD=your-app-password

# Email por defecto para envío
DEFAULT_FROM_EMAIL=Condor Expeditions <noreply@condorexpeditions.com>

# =============================================================================
# PAGOS - STRIPE
# =============================================================================

# Clave pública de Stripe (para frontend)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here

# Clave secreta de Stripe (para backend)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Secret para webhooks de Stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =============================================================================
# PAGOS - PAYPAL
# =============================================================================

# Client ID de PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Client Secret de PayPal
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# Modo de PayPal (sandbox o live)
PAYPAL_MODE=sandbox

# =============================================================================
# ALMACENAMIENTO AWS S3 (OPCIONAL)
# =============================================================================

# Usar S3 para almacenamiento de archivos
USE_S3=False

# Clave de acceso AWS
AWS_ACCESS_KEY_ID=your_aws_access_key_id

# Clave secreta AWS
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Nombre del bucket S3
AWS_STORAGE_BUCKET_NAME=your-bucket-name

# Región de AWS
AWS_S3_REGION_NAME=us-east-1

# =============================================================================
# URLs Y DOMINIOS
# =============================================================================

# URL del frontend (para emails y callbacks)
FRONTEND_URL=http://localhost

# URLs permitidas para CORS (separadas por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# CONFIGURACIÓN DE DESPLIEGUE
# =============================================================================

# Puerto del backend
BACKEND_PORT=8000

# Puerto del frontend
FRONTEND_PORT=80

# Puerto de Nginx
NGINX_PORT=80

# Puerto SSL (opcional)
SSL_PORT=443

# Puerto de PgAdmin (desarrollo)
PGADMIN_PORT=5050

# Puerto de Mongo Express (desarrollo)
MONGO_EXPRESS_PORT=8081

# =============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN
# =============================================================================

# Para producción, cambiar estos valores:

# SECRET_KEY: Generar una clave segura y única
# DEBUG: False
# DB_HOST: Usar host real de base de datos
# EMAIL_BACKEND: Configurar SMTP real
# STRIPE_*_KEY: Usar claves de producción
# PAYPAL_MODE: live
# USE_S3: True (recomendado para producción)
# FRONTEND_URL: Usar dominio real
# ALLOWED_HOSTS: Dominios reales separados por coma
# CORS_ALLOWED_ORIGINS: Dominios reales separados por coma

